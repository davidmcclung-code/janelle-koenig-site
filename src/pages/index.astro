---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import ShowsSection from '../components/ShowsSection.astro';
import VideoShowcaseSection from '../components/VideoShowcaseSection.astro';
import FeatureDuoSection from '../components/FeatureDuoSection.astro';
import VideoModal from '../components/VideoModal.astro';
---

<BaseLayout>
  <!-- Act 1: Hero Spotlight -->
  <Hero />

  <!-- Act 2: Media Logos Credibility Strip -->
  <CredibilityStrip />

  <!-- Act 3: Dedicated Full-Width Shows Band -->
  <ShowsSection />

  <!-- Act 4: Dark-Stage Video Showcase -->
  <VideoShowcaseSection />

  <!-- Act 5: Paired MC Work & Substack Feature Duo -->
  <FeatureDuoSection />

  <!-- Top-Layer Cinema Video Modal -->
  <VideoModal />
</BaseLayout>
