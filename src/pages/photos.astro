---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import GalleryLightbox from '../components/GalleryLightbox.astro';
import EnquiryBanner from '../components/EnquiryBanner.astro';
import galleryHeroImg from '../assets/photography/photos/janelle-gallery-hero.png';

const pageTitle = 'Photos | Janelle Koenig';
const pageDescription = 'Photos of Janelle Koenig performing comedy, hosting events and appearing on stage around Australia.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Gallery Page Introduction -->
  <PageHero
    id="gallery-page-title"
    eyebrow="Proof she left the house."
    titleLines={['GALLERY']}
    image={galleryHeroImg}
    imageAlt="Janelle Koenig smiling"
    imagePosition="center top"
  >
    <Fragment slot="lead">
      Gigs, green rooms, good rooms and <br class="desktop-break" />the occasional flattering angle.
    </Fragment>
  </PageHero>

  <!-- Photo Grid -->
  <GalleryGrid />

  <!-- Full-Bleed Warm Enquiry CTA Banner -->
  <EnquiryBanner buttonId="gallery-cta-btn" />

  <!-- Full-Screen Lightbox Modal -->
  <GalleryLightbox />
</BaseLayout>
