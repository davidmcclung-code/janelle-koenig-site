---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AboutScrollytelling from '../components/AboutScrollytelling.astro';
import EnquiryBanner from '../components/EnquiryBanner.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { asset } from '../utils/paths';
import { createResponsiveSourceSet } from '../utils/responsiveImage';

import aboutHeroCutoutImg from '../assets/photography/about/janelle-about-hero-cutout.png';
import kidsCancerGalaImg from '../assets/photography/about/janelle-kids-cancer-gala.jpg';

const pageTitle = 'About | Janelle Koenig';
const pageDescription =
  'Western Australia’s First Lady of Comedy: Janelle Koenig is a comedian, writer, director, MC, actor and producer with over 25 years on stage, screen and radio.';

const galaSources = await createResponsiveSourceSet(kidsCancerGalaImg, [360, 560, 760, 960], 'jpeg');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- 1. Bio Intro Split -->
  <PageHero
    id="about-page-title"
    eyebrow="WA’s First Lady of Comedy"
    titleLines={['ABOUT', 'JANELLE']}
    lead="Over 25 years on stage, screen and radio. Plus keeping corporate rooms awake."
    image={aboutHeroCutoutImg}
    imageAlt="Janelle Koenig looking surprised in a burgundy floral dress"
    imagePosition="center bottom"
  />

  <!-- 2. Compact Chapter Jump Links Bar -->
  <nav class="chapter-jump-nav" id="chapter-jump-nav" aria-label="About page sections">
    <div class="container jump-nav-inner">
      <span class="jump-nav-label" aria-hidden="true">JUMP TO</span>
      <ul class="jump-nav-list">
        <li>
          <a href="#story" class="jump-link is-active" data-chapter-link="story" aria-current="location">
            <span class="jump-num">01</span>
            <span>The Story</span>
          </a>
        </li>
        <li>
          <a href="#community" class="jump-link" data-chapter-link="community">
            <span class="jump-num">02</span>
            <span>Stage &amp; Community</span>
          </a>
        </li>
        <li>
          <a href="#credits" class="jump-link" data-chapter-link="credits">
            <span class="jump-num">03</span>
            <span>Credits</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- 3. Chapter 1: Pinned Scrollytelling Bio -->
  <AboutScrollytelling />

  <!-- 5. Chapter 2: Dark-Stage Community & Events Spotlight -->
  <section class="community-stage-section" id="community" aria-labelledby="community-heading">
    <div class="container">
      <div class="ambassador-panel scroll-reveal">
        <div class="ambassador-photo">
          <picture>
            <source type="image/avif" srcset={galaSources.avifSrcset} sizes="(min-width: 900px) 380px, 90vw" width={galaSources.width} height={galaSources.height} />
            <source type="image/webp" srcset={galaSources.webpSrcset} sizes="(min-width: 900px) 380px, 90vw" width={galaSources.width} height={galaSources.height} />
            <img
              src={galaSources.fallbackSrc}
              srcset={galaSources.fallbackSrcset}
              sizes="(min-width: 900px) 380px, 90vw"
              alt="Janelle Koenig performing onstage at Kai's Big Gold Ball for the Kids Cancer Support Group"
              width={galaSources.width}
              height={galaSources.height}
              loading="lazy"
              decoding="async"
              class="img-gala"
            />
          </picture>
        </div>

        <div class="ambassador-content">
          <span class="font-script ambassador-eyebrow">Stage, Events &amp; Community</span>
          <h2 id="community-heading" class="ambassador-h3">Showing off, hosting &amp; giving back</h2>

          <p class="ambassador-copy">
            When she feels like showing off, Janelle also acts, with leading stage roles in <em>Priscilla Queen of the Desert</em> (playing to more than 55,000 people at Perth’s Crown Theatre) and <em>We Will Rock You</em> at the Regal Theatre.
          </p>

          <p class="ambassador-copy">
            On the live events side, she has hosted the three-hour televised 2025 and 2026 Perth Pride Parade mainstage, Universal Pictures’ WA premieres of <em>Wicked</em> and <em>Wicked: For Good</em>, and the exclusive Perth Film Studios Open Day.
          </p>

          <p class="ambassador-copy">
            Janelle is also the producer and host of the sell-out female comedy gala <em>Let’s Hear It For The Girls</em> and a proud ambassador for the Kids Cancer Support Group.
          </p>

          <p class="bio-closing-line">
            In short: comedian, writer, MC, actor, singer, producer and professional show-off.<br />
            Janelle is proud to call herself a real woman – but she’s keeping the skinny jeans, just in case.
          </p>

          <div class="ambassador-links">
            <a href={asset('/mc-events')} class="ambassador-link">
              <span>MC &amp; EVENT HOSTING + REVIEWS</span>
              <ArrowIcon size={14} />
            </a>
            <a href={asset('/photos')} class="ambassador-link">
              <span>VIEW MORE IN THE PHOTO GALLERY</span>
              <ArrowIcon size={14} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Chapter 3: Credits & Highlights -->
  <section class="credits-section" id="credits" aria-labelledby="credits-heading">
    <div class="container">
      <div class="credits-header scroll-reveal">
        <span class="font-script text-script-section section-script">
          On stage, on screen &amp; behind the scenes
        </span>
        <h2 id="credits-heading" class="section-heading credits-title">
          Credits &amp; highlights.
        </h2>
      </div>

      <div class="pillars-grid">
        <div class="pillar-col scroll-reveal">
          <span class="pillar-num" aria-hidden="true">01.</span>
          <h3 class="pillar-title">Stand-Up &amp; Musical Comedy</h3>
          <p class="pillar-copy">
            Over 25 years performing stand-up, headlining clubs, theatres and festivals worldwide.
          </p>
          <ul class="pillar-list">
            <li>NBC’s Last Comic Standing (International Edition)</li>
            <li>Shared stages with Jimeoin, Alan Davies &amp; Wayne Brady</li>
            <li>Producer &amp; host, Let’s Hear It For The Girls</li>
            <li>30,000+ followers &amp; 20M+ online views</li>
          </ul>
        </div>

        <div class="pillar-col scroll-reveal">
          <span class="pillar-num" aria-hidden="true">02.</span>
          <h3 class="pillar-title">Stage, MC &amp; Major Events</h3>
          <p class="pillar-copy">
            Leading musical theatre roles and major live hosting across Western Australia.
          </p>
          <ul class="pillar-list">
            <li>Priscilla Queen of the Desert (55,000+ at Crown Theatre)</li>
            <li>We Will Rock You (Regal Theatre, Perth)</li>
            <li>2025 &amp; 2026 Perth Pride Parade Mainstage Host</li>
            <li>Wicked &amp; Wicked: For Good WA Premieres (Universal)</li>
          </ul>
        </div>

        <div class="pillar-col scroll-reveal">
          <span class="pillar-num" aria-hidden="true">03.</span>
          <h3 class="pillar-title">Writing, Directing &amp; Radio</h3>
          <p class="pillar-copy">
            Head-writer credits for flagship Australian broadcasts plus national weekly radio.
          </p>
          <ul class="pillar-list">
            <li>Eurovision – Australia Decides (Logie-nominated, 2019)</li>
            <li>SBS Mardi Gras Parade (AACTA Winner, 2021)</li>
            <li>Channel 7’s Take Me Out &amp; RHOS Reunion (Binge)</li>
            <li>'Janelle’s Juice Box' on Nova FM’s Joel Creasey Show</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Full-Bleed Warm Enquiry CTA Banner -->
  <EnquiryBanner buttonId="about-cta-btn" />
</BaseLayout>

<script>
  // Sync sticky chapter jump bar position cleanly beneath shrinking site header
  const siteHeader = document.getElementById('site-header');
  if (siteHeader) {
    let lastHeaderHeight = -1;
    let rafId = 0;

    const syncHeaderHeight = () => {
      rafId = 0;
      const nextHeight = Math.round(siteHeader.getBoundingClientRect().height * 2) / 2;
      if (nextHeight !== lastHeaderHeight) {
        lastHeaderHeight = nextHeight;
        document.documentElement.style.setProperty('--live-header-h', `${nextHeight}px`);
      }
    };

    const scheduleHeaderSync = () => {
      if (!rafId) {
        rafId = window.requestAnimationFrame(syncHeaderHeight);
      }
    };

    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(syncHeaderHeight);
      try {
        ro.observe(siteHeader, { box: 'border-box' });
      } catch {
        ro.observe(siteHeader);
      }
    }

    window.addEventListener('scroll', scheduleHeaderSync, { passive: true });
    window.addEventListener('resize', scheduleHeaderSync, { passive: true });
    syncHeaderHeight();
  }

  // Highlight active chapter in jump bar during scroll
  const chapterLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-chapter-link]'));
  const chapterIds = ['story', 'community', 'credits'];
  const chapterSections = chapterIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  function setActiveChapter(activeId: string) {
    chapterLinks.forEach((link) => {
      const isMatch = link.dataset.chapterLink === activeId;
      link.classList.toggle('is-active', isMatch);
      if (isMatch) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  if ('IntersectionObserver' in window && chapterSections.length > 0) {
    const chapterObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setActiveChapter(entry.target.id);
          }
        });
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0.01 }
    );
    chapterSections.forEach((section) => chapterObserver.observe(section));
  }
</script>

<style>
  /* ==========================================================================
     Compact Chapter Jump Links Bar
     ========================================================================== */
  .chapter-jump-nav {
    position: sticky;
    top: calc(var(--live-header-h, var(--header-height-compact)) - 1px);
    z-index: 90;
    background-color: rgba(251, 248, 244, 0.94);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--colour-border);
    border-bottom: 1px solid var(--colour-border);
  }

  .jump-nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 48px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .jump-nav-inner::-webkit-scrollbar {
    display: none;
  }

  .jump-nav-label {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--colour-muted);
    white-space: nowrap;
  }

  .jump-nav-list {
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.5vw, 14px);
    margin: 0;
    padding: 4px 0;
  }

  .jump-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-xs);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--colour-ink);
    white-space: nowrap;
    border: 1px solid transparent;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .jump-num {
    font-family: var(--font-script);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--colour-primary);
    line-height: 1;
  }

  .jump-link:hover {
    background-color: var(--colour-primary-light);
    color: var(--colour-primary);
  }

  .jump-link.is-active {
    background-color: var(--colour-primary);
    color: #ffffff;
  }

  .jump-link.is-active .jump-num {
    color: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 560px) {
    .jump-nav-label {
      display: none;
    }

    .jump-nav-inner {
      justify-content: center;
    }

    .jump-link {
      padding: 0 10px;
      font-size: 0.6875rem;
    }
  }

  /* ==========================================================================
     Credits & Highlights Section (Dark Stage)
     ========================================================================== */
  .credits-section {
    --colour-focus: var(--colour-focus-on-dark);
    background-color: var(--colour-footer);
    padding: clamp(2.75rem, 5.5vw, 4.5rem) 0;
    color: var(--colour-dark-ink);
  }

  .credits-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .credits-section .section-script {
    font-size: clamp(1.45rem, 1.1rem + 0.6vw, 1.9rem);
    line-height: 1.15;
    color: var(--colour-primary-on-dark);
    display: inline-block;
    margin-bottom: var(--space-2);
    transform: rotate(-1deg);
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 1.15rem + 0.9vw, 2.25rem);
    font-weight: 900;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 2.8vw, 2.25rem);
  }

  .pillar-col {
    border-top: 2px solid var(--colour-dark-border-strong);
    padding-top: var(--space-4);
    min-width: 0;
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .pillar-col:hover {
    border-top-color: var(--colour-primary-on-dark);
  }

  .pillar-num {
    font-family: var(--font-script);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--colour-primary-on-dark);
    display: block;
    margin-bottom: 4px;
    line-height: 1.1;
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 0.95rem + 0.35vw, 1.3125rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 10px 0;
  }

  .pillar-copy {
    font-family: var(--font-body);
    font-size: 0.90625rem;
    line-height: 1.55;
    color: rgba(243, 243, 243, 0.8);
    margin: 0 0 14px 0;
  }

  .pillar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.84375rem;
    color: rgba(255, 255, 255, 0.92);
    font-weight: 500;
  }

  .pillar-list li {
    padding: 6px 0;
    border-top: 1px solid var(--colour-dark-border);
    line-height: 1.4;
  }

  /* ==========================================================================
     Warm-Ground Community Spotlight
     ========================================================================== */
  .community-stage-section {
    background-color: var(--colour-page-warm);
    padding: clamp(2.75rem, 5.5vw, 4.5rem) 0;
    color: var(--colour-ink);
    border-top: 1px solid var(--colour-border);
  }

  .ambassador-panel {
    display: grid;
    grid-template-columns: minmax(260px, 380px) 1fr;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
    align-items: center;
    background-color: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-sm);
    padding: clamp(1.25rem, 2.8vw, 2rem);
    box-shadow: var(--shadow-md);
  }

  .ambassador-photo {
    border-radius: var(--radius-xs);
    overflow: hidden;
    aspect-ratio: 3 / 3.6;
    background-color: var(--colour-surface-alt);
    border: 1px solid var(--colour-border);
  }

  .ambassador-photo picture,
  .img-gala {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: 50% 4%;
  }

  .ambassador-content {
    min-width: 0;
  }

  .ambassador-eyebrow {
    font-size: clamp(1.35rem, 1.05rem + 0.5vw, 1.625rem);
    color: var(--colour-primary);
    display: inline-block;
    margin-bottom: 4px;
    line-height: 1.1;
  }

  .ambassador-h3 {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.05rem + 0.55vw, 1.75rem);
    font-weight: 900;
    letter-spacing: -0.025em;
    color: var(--colour-ink);
    margin: 0 0 14px 0;
  }

  .ambassador-copy {
    font-family: var(--font-body);
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--colour-ink-subtle);
    max-width: 60ch;
    margin: 0 0 14px 0;
  }

  .bio-closing-line {
    font-family: var(--font-body);
    font-size: 0.96875rem;
    line-height: 1.55;
    font-weight: 600;
    color: var(--colour-ink);
    padding-top: 12px;
    border-top: 1px solid var(--colour-border);
    margin: 0 0 18px 0;
    max-width: 60ch;
  }

  .ambassador-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 24px;
  }

  .ambassador-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--colour-primary);
    transition:
      transform var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .ambassador-link:hover {
    color: var(--colour-ink);
  }

  @media (max-width: 1023px) {
    .pillars-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .ambassador-panel {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .ambassador-photo {
      aspect-ratio: 4 / 4;
      max-width: 440px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambassador-link:hover {
      transform: none;
    }
  }
</style>
