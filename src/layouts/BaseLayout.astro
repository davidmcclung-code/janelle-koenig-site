---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookingModal from '../components/BookingModal.astro';
import { siteConfig } from '../data/siteConfig';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <BaseHead title={title} description={description} />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <!-- Global Scroll Progress Rail (Progressive Enhancement) -->
    <div class="scroll-progress-bar" aria-hidden="true"></div>

    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="sr-only skip-link">Skip to main content</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />

    <!-- Accessible Booking Dialog -->
    <BookingModal />

    <!-- Directional Cross-Document View Transitions & Scroll-Reveal Fallback -->
    <script>
      const routeOrder: Record<string, number> = {
        '/': 0,
        '/photos': 1,
        '/about': 2,
      };
      const basePath = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
      const normalizeRoute = (pathname: string) => {
        let route = pathname.replace(/\/+$/, '');
        if (basePath && (route === basePath || route.startsWith(`${basePath}/`))) {
          route = route.slice(basePath.length);
        }
        return route || '/';
      };

      window.addEventListener('pagereveal', (e: any) => {
        const navActivation = (window as any).navigation?.activation;
        if (!e.viewTransition || !navActivation) return;
        const fromUrl = navActivation.from?.url ? new URL(navActivation.from.url) : null;
        const entryUrl = navActivation.entry?.url ? new URL(navActivation.entry.url) : null;
        if (!fromUrl || !entryUrl) return;

        const fromRank = routeOrder[normalizeRoute(fromUrl.pathname)];
        const toRank = routeOrder[normalizeRoute(entryUrl.pathname)];
        if (fromRank !== undefined && toRank !== undefined && fromRank !== toRank) {
          e.viewTransition.types.add(toRank > fromRank ? 'forward' : 'backward');
        }
      });

      // Fallback for .scroll-reveal when CSS scroll-driven view() timelines are unsupported
      if (
        !CSS.supports('(animation-timeline: view()) and (animation-range: entry)') &&
        window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
        'IntersectionObserver' in window
      ) {
        document.documentElement.classList.add('js-reveal-fallback');
        const revealEls = document.querySelectorAll('.scroll-reveal');
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -24px 0px' }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>

    <!-- Developer Console Easter Egg -->
    <script define:vars={{ email: siteConfig.email }}>
      console.log(
        '%c👋 Hello Australia!\n%cInspecting the source code? Janelle approves of your indoor hobbies.\n\n%cNeed a comic, MC, or panel host? %c' + email,
        'color: #9e1b32; font-family: "Plus Jakarta Sans", system-ui, sans-serif; font-size: 16px; font-weight: 800; padding: 4px 0;',
        'color: #121212; font-family: system-ui, sans-serif; font-size: 12px; font-weight: 500; line-height: 1.5;',
        'color: #666666; font-family: system-ui, sans-serif; font-size: 11px;',
        'color: #9e1b32; font-family: system-ui, sans-serif; font-size: 11px; font-weight: 700; text-decoration: underline;'
      );
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--space-4);
    background-color: var(--colour-primary);
    color: #ffffff;
    padding: var(--space-3) var(--space-5);
    z-index: 999;
    font-weight: 700;
    border-radius: var(--radius-xs);
    transition: top var(--motion-fast) var(--ease-out);
  }

  .skip-link:focus {
    top: var(--space-4);
    clip: auto;
    width: auto;
    height: auto;
    overflow: visible;
  }
</style>
