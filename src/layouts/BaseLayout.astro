---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import VideoModal from '../components/VideoModal.astro';
import BookingModal from '../components/BookingModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <BaseHead title={title} description={description} />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <!-- Skip to main content link for accessibility -->
    <a href="#main-content" class="sr-only skip-link">Skip to main content</a>

    <SiteHeader />

    <main id="main-content">
      <slot />
    </main>

    <SiteFooter />

    <!-- Accessible Dialogs -->
    <VideoModal />
    <BookingModal />

    <!-- Lightweight Scroll Reveal Observer -->
    <script>
      const reveals = document.querySelectorAll('.reveal');

      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.18,
            rootMargin: '0px 0px -20px 0px',
          }
        );

        reveals.forEach((el) => observer.observe(el));
      } else {
        // Fallback or reduced-motion
        reveals.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100px;
    left: var(--space-4);
    background-color: var(--colour-primary);
    color: #ffffff;
    padding: var(--space-3) var(--space-5);
    z-index: 999;
    font-weight: 700;
    border-radius: var(--radius-xs);
    transition: top var(--motion-fast) var(--ease-out);
  }

  .skip-link:focus {
    top: var(--space-4);
    clip: auto;
    width: auto;
    height: auto;
    overflow: visible;
  }
</style>
