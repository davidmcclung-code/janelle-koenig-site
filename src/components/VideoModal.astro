---
import { getImage } from 'astro:assets';
import { asset } from '../utils/paths';
import CloseIcon from './CloseIcon.astro';
import defaultThumbImg from '../assets/photography/performance/debbie-gibson-thumbnail.jpg';

interface Props {
  videoSrc?: string;
  posterSrc?: string;
  captionsSrc?: string;
}

const optimizedPoster = await getImage({
  src: defaultThumbImg,
  width: 960,
  format: 'webp',
  quality: 82,
});

const {
  videoSrc = asset('/video/debbie-gibson-interview.mp4'),
  posterSrc = optimizedPoster.src,
  captionsSrc = asset('/video/debbie-gibson-interview.vtt'),
} = Astro.props;
---

<dialog
  id="video-modal"
  class="animated-dialog modal-dialog"
  aria-labelledby="video-modal-title"
  closedby="any"
>
  <div class="modal-card">
    <div class="modal-header">
      <h2 id="video-modal-title" class="font-script modal-title">Watch Janelle</h2>
      <button type="button" class="modal-close-btn" id="video-modal-close" aria-label="Close video modal" autofocus>
        <CloseIcon size={22} />
      </button>
    </div>

    <div class="modal-body">
      <div class="video-container">
        <video
          id="video-player-element"
          class="video-player"
          width="1280"
          height="720"
          controls
          playsinline
          preload="none"
          data-poster={posterSrc}
        >
          <source src={videoSrc} type="video/mp4" />
          <track src={captionsSrc} kind="captions" srclang="en" label="English" />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
</dialog>

<style>
  .modal-dialog {
    --colour-focus: var(--colour-focus-on-dark);
    --dialog-backdrop-bg: rgba(10, 10, 10, 0.8);
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    background: transparent;
    max-width: 900px;
    width: calc(100% - 2rem);
    margin: auto;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.45);
  }

  .modal-card {
    contain: layout style paint;
    background-color: var(--colour-dark-surface);
    color: #ffffff;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modal-title {
    color: var(--colour-primary-on-dark);
    font-size: 1.75rem;
    margin: 0;
  }

  .modal-close-btn {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border: none;
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  .modal-close-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 44px;
    min-height: 44px;
  }

  .modal-close-btn:hover {
    background-color: var(--colour-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .modal-close-btn:active {
      transform: scale(0.94);
    }
  }

  .modal-body {
    padding: var(--space-4);
  }

  .video-container {
    width: 100%;
    max-height: calc(100vh - 7.5rem);
    max-height: calc(100dvh - 7.5rem);
    aspect-ratio: 16 / 9;
    margin-inline: auto;
    background-color: var(--colour-dark-stage);
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
  }

  @media (max-height: 540px) {
    .modal-header {
      padding: var(--space-2) var(--space-4);
    }

    .modal-body {
      padding: var(--space-2);
    }

    .video-container {
      max-height: calc(100vh - 4.75rem);
      max-height: calc(100dvh - 4.75rem);
    }
  }

  .video-player {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--colour-dark-stage);
  }
</style>

<script>
  import { bindDialogLightDismiss, closeAnimatedDialog } from '../utils/topLayerDialog';

  const videoModal = document.getElementById('video-modal') as HTMLDialogElement | null;
  const videoCloseBtn = document.getElementById('video-modal-close');
  const videoTriggers = document.querySelectorAll('[data-video-trigger]');
  const videoElement = document.getElementById('video-player-element') as HTMLVideoElement | null;

  function openVideoModal() {
    if (videoModal && typeof videoModal.showModal === 'function') {
      videoModal.showModal();
      if (videoElement) {
        if (!videoElement.poster && videoElement.dataset.poster) {
          videoElement.poster = videoElement.dataset.poster;
        }
        videoElement.currentTime = 0;
        videoElement.play().catch(() => {
          // Autoplay browser policy fallback
        });
      }
    }
  }

  async function closeVideoModal() {
    if (videoElement) {
      videoElement.pause();
    }
    await closeAnimatedDialog(videoModal);
  }

  videoTriggers.forEach((trigger) => {
    trigger.addEventListener('click', openVideoModal);
  });

  videoCloseBtn?.addEventListener('click', () => void closeVideoModal());
  bindDialogLightDismiss(videoModal, closeVideoModal);

  videoModal?.addEventListener('close', () => {
    if (videoElement) {
      videoElement.pause();
      videoElement.currentTime = 0;
    }
  });
</script>
