---
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import defaultThumbImg from '../assets/photography/performance/debbie-gibson-thumbnail.jpg';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  thumbnailSrc?: string;
  title?: string;
  description?: string;
}

const {
  thumbnailSrc,
  title = 'Watch Janelle',
  description = 'Janelle catches up with pop icon, Debbie Gibson.',
} = Astro.props;

const thumbSources = await createResponsiveSourceSet(
  defaultThumbImg,
  [320, 480, 640],
  'jpeg'
);
---

<div class="video-card">
  <!-- Video Thumbnail with Centered Play Button Overlay -->
  <button
    type="button"
    class="video-thumbnail-container"
    id="video-card-trigger"
    data-video-trigger
    aria-haspopup="dialog"
    aria-label="Play video: Janelle catches up with pop icon Debbie Gibson"
  >
    {thumbnailSrc ? (
      <img
        src={thumbnailSrc}
        alt="Janelle Koenig catches up with pop icon Debbie Gibson"
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
        class="video-thumbnail"
      />
    ) : (
      <picture style="display: contents;">
        <source
          type="image/avif"
          srcset={thumbSources.avifSrcset}
          sizes="(min-width: 850px) 420px, 50vw"
        />
        <source
          type="image/webp"
          srcset={thumbSources.webpSrcset}
          sizes="(min-width: 850px) 420px, 50vw"
        />
        <img
          src={thumbSources.fallbackSrc}
          srcset={thumbSources.fallbackSrcset}
          sizes="(min-width: 850px) 420px, 50vw"
          alt="Janelle Koenig catches up with pop icon Debbie Gibson"
          width={thumbSources.width}
          height={thumbSources.height}
          loading="lazy"
          decoding="async"
          class="video-thumbnail"
        />
      </picture>
    )}
    <div class="play-overlay">
      <div class="play-button">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <polygon points="9 6 18 12 9 18 9 6" fill="#ffffff"></polygon>
        </svg>
      </div>
    </div>
  </button>

  <!-- Content Below Thumbnail with calibrated breathing room -->
  <div class="video-card-content">
    <h2 class="font-script video-card-title">{title}</h2>
    <p class="video-card-desc wrap-break">{description}</p>
    <button type="button" class="video-card-cta" data-video-trigger aria-haspopup="dialog">
      <span>WATCH NOW</span>
      <ArrowIcon size={12} />
    </button>
  </div>
</div>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  @media (max-width: 849px) {
    .video-card {
      display: grid;
      grid-template-columns: 50% 50%;
      align-items: center;
      gap: 16px;
    }
  }

  @media (max-width: 479px) {
    .video-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  .video-thumbnail-container {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(18, 18, 18, 0.08);
    text-align: left;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    cursor: pointer;
    background-color: var(--colour-dark-stage);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out);
  }

  .video-thumbnail-container:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform var(--motion-fast) var(--ease-out),
                opacity var(--motion-fast) var(--ease-out);
  }

  .video-thumbnail-container:hover .video-thumbnail {
    transform: scale(1.02);
    opacity: 0.92;
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%);
  }

  .play-button {
    width: 54px;
    height: 54px;
    border-radius: var(--radius-pill);
    background-color: rgba(255, 255, 255, 0.92);
    border: 2px solid #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform var(--motion-fast) var(--ease-out),
                background-color var(--motion-fast) var(--ease-out),
                border-color var(--motion-fast) var(--ease-out);
  }

  .play-button svg polygon {
    fill: var(--colour-ink);
    transition: fill var(--motion-fast) var(--ease-out);
  }

  .play-button svg {
    margin-left: 2px;
  }

  .video-thumbnail-container:hover .play-button {
    transform: scale(1.08);
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
  }

  .video-thumbnail-container:hover .play-button svg polygon {
    fill: #ffffff;
  }

  /* Content Below Thumbnail: 14px gap from image, 7px to desc, 1.4 line-height, 11px to CTA */
  .video-card-content {
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  @media (max-width: 849px) {
    .video-card-content {
      padding-top: 0;
      justify-content: center;
    }

    .video-card-title {
      font-size: 1.35rem;
      margin-bottom: 4px;
    }

    .video-card-desc {
      font-size: 0.8125rem;
      margin-bottom: 8px;
      line-height: 1.35;
    }

    .video-card-cta {
      font-size: 0.75rem;
    }
  }

  .video-card-title {
    font-size: 1.625rem;
    color: var(--colour-primary);
    line-height: 1.1;
    transform: rotate(-1.5deg);
    display: inline-block;
    margin-bottom: 7px;
  }

  .video-card-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--colour-muted);
    line-height: 1.35;
    margin-bottom: 11px;
    width: 100%;
  }

  .video-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--colour-primary);
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    width: fit-content;
    transition: transform var(--motion-fast) var(--ease-out),
                color var(--motion-fast) var(--ease-out);
  }

  .video-card-cta:hover {
    color: var(--colour-primary-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .video-thumbnail-container:hover,
    .video-thumbnail-container:hover .video-thumbnail,
    .video-thumbnail-container:hover .play-button {
      transform: none;
    }
  }
</style>
