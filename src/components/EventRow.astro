---
import type { EventItem } from '../types';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  event: EventItem;
  index?: number;
}

const { event, index = 0 } = Astro.props;
---

<li class="event-row" data-event-id={event.id} style={`--row-index: ${index};`}>
  <div class="event-date">
    <span class="event-day">{event.day}</span>
    <span class="event-month">{event.month}</span>
  </div>

  <div class="event-details">
    <h3 class="event-title wrap-break">{event.title}</h3>
    <p class="event-venue wrap-break">{event.venue}, {event.location}</p>
  </div>

  <div class="event-action">
    {
      event.isSoldOut ? (
        <span class="event-badge sold-out">SOLD OUT</span>
      ) : (
        <a
          href={event.ticketUrl}
          target={event.ticketUrl.startsWith('http') ? '_blank' : undefined}
          rel={event.ticketUrl.startsWith('http') ? 'noopener noreferrer' : undefined}
          class="event-ticket-link"
          aria-label={`Get tickets for ${event.title}`}
        >
          <span>TICKETS</span>
          <ArrowIcon size={12} />
        </a>
      )
    }
  </div>
</li>

<style is:global>
  .event-row {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: 0.72rem 0.65rem;
    margin-inline: -0.65rem;
    border-radius: var(--radius-xs);
    box-shadow: inset 0 0 0 0 var(--colour-primary);
    transition:
      background-color var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .event-row:not(:last-child) {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      @keyframes event-row-in {
        from {
          opacity: 0;
          translate: 0 22px;
        }
        to {
          opacity: 1;
          translate: 0 0;
        }
      }

      .event-row {
        animation: event-row-in auto var(--ease-out) both;
        animation-timeline: view();
        animation-range: entry 0% entry calc(28% + var(--row-index, 0) * 5%);
      }
    }
  }

  .event-row:hover,
  .event-row:focus-within {
    background-color: rgba(158, 27, 50, 0.04);
    box-shadow: inset 3px 0 0 0 var(--colour-primary);
  }

  .event-row:hover .event-date {
    transform: scale(1.06) translateY(-1px);
  }

  .event-row:hover .event-day {
    color: var(--colour-primary-hover);
  }

  .event-row:active .event-date {
    transform: scale(0.96) translateY(0);
  }

  .event-row:hover .event-ticket-link {
    color: var(--colour-primary-hover);
  }

  .event-row:hover .event-ticket-link svg {
    transform: translateX(4px);
  }

  .event-ticket-link svg {
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .event-row:first-child {
    padding-top: 0.35rem;
  }

  .event-row:last-child {
    padding-bottom: 0.35rem;
  }

  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 48px;
    min-width: 48px;
    flex-shrink: 0;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
    transform-origin: center center;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .event-day {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--colour-primary);
    letter-spacing: -0.02em;
    line-height: 1;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .event-month {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--colour-ink);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1;
    margin-top: 2px;
  }

  .event-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    justify-content: center;
  }

  .event-title {
    font-family: var(--font-display);
    font-size: 0.96875rem;
    font-weight: 800;
    color: var(--colour-ink);
    letter-spacing: -0.01em;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .event-venue {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--colour-muted);
    line-height: 1.35;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .event-action {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    flex-shrink: 0;
  }

  .event-ticket-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 6px 4px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--colour-primary);
    white-space: nowrap;
    transition:
      transform var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out);
  }

  .event-ticket-link:hover {
    color: var(--colour-primary-hover);
    transform: translateX(2px);
  }

  .event-badge.sold-out {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.5rem;
    background-color: var(--colour-muted);
    color: #ffffff;
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  @media (max-width: 580px) {
    .event-row {
      grid-template-columns: 44px 1fr auto;
      gap: clamp(8px, 2.5vw, 12px);
      padding: 0.6rem 0;
      margin-inline: 0;
    }

    .event-date {
      width: 44px;
      min-width: 44px;
    }

    .event-day {
      font-size: 1.3rem;
    }

    .event-month {
      font-size: 0.625rem;
    }

    .event-title {
      font-size: 0.875rem;
      line-height: 1.25;
      white-space: normal;
    }

    .event-venue {
      font-size: 0.75rem;
      line-height: 1.3;
      white-space: normal;
    }

    .event-ticket-link {
      font-size: 0.6875rem;
      padding: 6px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-row,
    .event-date,
    .event-ticket-link,
    .event-ticket-link svg {
      animation: none !important;
      opacity: 1 !important;
      translate: none !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
