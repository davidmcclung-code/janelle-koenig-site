---
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import mcCompactImg from '../assets/photography/mc/janelle-mc-compact.jpg';
import mcWideImg from '../assets/photography/mc/janelle-mc-wide.jpg';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  imageSrc?: string;
}

const { imageSrc } = Astro.props;

const mcCompactSources = await createResponsiveSourceSet(
  mcCompactImg,
  [320, 480, 640, 800],
  'jpeg'
);

const mcWideSources = await createResponsiveSourceSet(
  mcWideImg,
  [480, 640, 800, 960, 1280],
  'jpeg'
);
---

<section class="corporate-banner-section" id="mc-events" aria-label="MC and Corporate Event Hosting">
  <div class="banner-grid reveal">
    <!-- Left Content Column (52% width) -->
    <div class="banner-content">
      <h2 class="font-script text-script-section banner-title">
        Need someone to work the room?
      </h2>
      <p class="banner-desc wrap-break">
        Janelle keeps the room laughing, the event moving and awkward silences off the agenda.
      </p>
      <div class="banner-actions">
        <button type="button" class="btn banner-btn" id="mc-enquire-btn" data-booking-trigger aria-haspopup="dialog">
          <span>MC & EVENT ENQUIRIES</span>
          <ArrowIcon size={13} />
        </button>
      </div>
    </div>

    <!-- Right Photo Column (48% width) -->
    <div class="banner-media">
      {imageSrc ? (
        <img
          src={imageSrc}
          alt="Janelle Koenig hosting an event with a microphone"
          width="900"
          height="550"
          loading="lazy"
          decoding="async"
          class="banner-img"
        />
      ) : (
        <picture class="banner-picture">
          <!-- Wide variant (850px and above) -->
          <source
            media="(min-width: 850px)"
            type="image/avif"
            srcset={mcWideSources.avifSrcset}
            sizes="(min-width: 1280px) 52vw, 48vw"
            width={mcWideSources.width}
            height={mcWideSources.height}
          />
          <source
            media="(min-width: 850px)"
            type="image/webp"
            srcset={mcWideSources.webpSrcset}
            sizes="(min-width: 1280px) 52vw, 48vw"
            width={mcWideSources.width}
            height={mcWideSources.height}
          />
          <source
            media="(min-width: 850px)"
            srcset={mcWideSources.fallbackSrcset}
            sizes="(min-width: 1280px) 52vw, 48vw"
            width={mcWideSources.width}
            height={mcWideSources.height}
          />

          <!-- Compact variant (below 850px) -->
          <source
            type="image/avif"
            srcset={mcCompactSources.avifSrcset}
            sizes="(min-width: 600px) 46vw, 45vw"
            width={mcCompactSources.width}
            height={mcCompactSources.height}
          />
          <source
            type="image/webp"
            srcset={mcCompactSources.webpSrcset}
            sizes="(min-width: 600px) 46vw, 45vw"
            width={mcCompactSources.width}
            height={mcCompactSources.height}
          />
          <img
            src={mcCompactSources.fallbackSrc}
            srcset={mcCompactSources.fallbackSrcset}
            sizes="(min-width: 600px) 46vw, 45vw"
            alt="Janelle Koenig hosting an event with a microphone"
            width={mcCompactSources.width}
            height={mcCompactSources.height}
            loading="lazy"
            decoding="async"
            class="banner-img"
          />
        </picture>
      )}
    </div>
  </div>
</section>

<style>
  .corporate-banner-section {
    width: 100%;
    margin-top: 0;
    margin-bottom: 0;
    border: none;
    display: block;
    line-height: 0;
    position: relative;
    background-color: var(--colour-banner-warm);
    overflow: hidden;
  }

  .banner-grid {
    display: grid;
    grid-template-columns: 54% 46%;
    align-items: stretch;
    min-height: 184px;
    width: 100%;
    max-width: var(--container-max-width);
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  .banner-media::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: clamp(32px, 7vw, 100px);
    background: linear-gradient(to right, var(--colour-banner-warm) 0%, rgba(235, 216, 205, 0) 100%);
    z-index: 2;
    pointer-events: none;
  }

  @media (min-width: 850px) {
    .banner-grid {
      max-width: none;
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, calc(var(--container-max-width) * 0.52))
        minmax(0, calc(var(--container-max-width) * 0.48))
        minmax(0, 1fr);
      min-height: 204px;
    }

    .banner-content {
      grid-column: 2 / 3;
    }

    .banner-media {
      grid-column: 3 / 5;
    }

    .banner-media::before {
      width: 110px;
    }
  }

  @media (min-width: 1520px) {
    .banner-media::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: 120px;
      background: linear-gradient(to left, rgba(10, 10, 18, 0.7) 0%, rgba(10, 10, 18, 0) 100%);
      z-index: 2;
      pointer-events: none;
    }
  }

  .banner-content {
    line-height: normal;
    padding-left: var(--container-gutter);
    padding-right: clamp(1rem, 2vw, 2.5rem);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    z-index: 2;
  }

  .banner-title {
    color: var(--colour-primary);
    transform: rotate(-1.5deg);
    display: inline-block;
    font-size: clamp(1.4rem, 1.1rem + 0.5vw, 1.7rem);
    line-height: 1.1;
    margin: 0 0 10px 0;
  }

  .banner-desc {
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 0.75rem + 0.15vw, 0.875rem);
    line-height: 1.4;
    color: var(--colour-ink);
    max-width: 380px;
    font-weight: 500;
    margin: 0;
  }

  .banner-actions {
    margin-top: 14px;
  }

  .banner-btn {
    position: relative;
    border: 1.5px solid var(--colour-ink);
    color: #ffffff;
    background-color: var(--colour-ink);
    height: auto;
    min-height: 34px;
    padding: 0.35rem 0.95rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  .banner-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 44px;
    width: calc(100% + 12px);
    height: 44px;
  }

  .banner-btn:hover {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
    box-shadow: var(--shadow-button-hover);
    transform: translateY(-1px);
  }

  .banner-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .banner-picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Independent focal-position for MC image */
  .banner-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 48% 2%;
  }

  .banner-media > .banner-img {
    position: absolute;
    inset: 0;
  }

  @media (min-width: 850px) {
    .banner-img {
      object-position: 38% 3%;
    }
  }

  @media (max-width: 600px) {
    .banner-grid {
      grid-template-columns: 57% 43%;
      min-height: 188px;
    }

    .banner-content {
      padding-left: var(--container-gutter);
      padding-right: 0.75rem;
    }

    .banner-title {
      font-size: 1.25rem;
      margin-bottom: 6px;
    }

    .banner-desc {
      font-size: 0.8125rem;
      line-height: 1.35;
      max-width: 100%;
    }

    .banner-actions {
      margin-top: 10px;
      max-width: 100%;
    }

    .banner-btn {
      height: auto;
      min-height: 44px;
      max-width: 100%;
      padding: 0.45rem 0.75rem;
      font-size: 0.7rem;
      line-height: 1.25;
      white-space: normal;
      text-align: left;
    }

    .banner-btn::after {
      display: none;
    }

    .banner-img {
      object-position: 45% 0%;
    }
  }
</style>
