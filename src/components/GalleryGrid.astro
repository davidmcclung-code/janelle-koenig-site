---
/**
 * GalleryGrid.astro
 * Dark-stage contact sheet with morphing category filter View Transitions,
 * 5-column desktop :has() spotlight grid, and mobile horizontal scroll-snap reel
 * for Janelle's Show Posters.
 */
import { Image } from 'astro:assets';
import { indexedMainRows, indexedPosters } from '../data/gallery';

const allMainItems = indexedMainRows.flatMap((row) => row.items);
const stageCount = allMainItems.filter((i) => i.filterGroup === 'stage').length;
const hostingCount = allMainItems.filter((i) => i.filterGroup === 'hosting').length;
const eventsCount = allMainItems.filter((i) => i.filterGroup === 'events').length;
const postersCount = indexedPosters.length;
const totalCount = allMainItems.length + postersCount;

const filters = [
  { id: 'all', label: 'All', count: totalCount },
  { id: 'stage', label: 'On Stage', count: stageCount },
  { id: 'hosting', label: 'MC & Hosting', count: hostingCount },
  { id: 'events', label: 'TV & Events', count: eventsCount },
  { id: 'posters', label: 'Show Posters', count: postersCount },
] as const;
---

<section class="gallery-grid-section" aria-label="Photo Gallery">
  <div class="container gallery-grid-container">
    <!-- Interactive Category Filter Toolbar -->
    <div class="gallery-toolbar">
      <div class="gallery-filters" role="group" aria-label="Filter gallery by category">
        {filters.map((filter) => (
          <button
            type="button"
            class:list={['filter-pill', { 'is-active': filter.id === 'all' }]}
            data-gallery-filter={filter.id}
            aria-pressed={filter.id === 'all' ? 'true' : 'false'}
          >
            <span>{filter.label}</span>
            <span class="filter-count">{filter.count}</span>
          </button>
        ))}
      </div>
      <p class="gallery-hint">Tap or click any frame to read the story behind it.</p>
    </div>

    <!-- Primary Contact Sheet: 16 Live, Event & Hosting Photographs -->
    <div class="gallery-rows" id="gallery-rows">
      {
        indexedMainRows.map((row, rowIndex) => (
          <div
            class="gallery-row"
            style={`--row-cols: ${row.cols}; --row-h: ${row.height};`}
          >
            {row.items.map((item) => {
              const tileRatio = Number((item.image.width / item.image.height).toFixed(4));
              const tileOrientation = tileRatio < 0.95 ? 'portrait' : 'landscape';
              return (
                <button
                  type="button"
                  class:list={[
                    'gallery-tile',
                    'is-contact-tile',
                    { 'is-feature': item.isFeature, 'is-wide-mobile': item.isWideMobile },
                  ]}
                  style={`--stagger-delay: ${item.staggerDelay}ms; --tile-ratio: ${tileRatio}; view-transition-name: vt-${item.id};`}
                  data-gallery-tile
                  data-filter-group={item.filterGroup}
                  data-orientation={tileOrientation}
                  data-index={item.globalIndex}
                  data-src={item.image.src}
                  data-alt={item.alt}
                  data-badge={item.badge}
                  data-category={item.category}
                  data-title={item.title}
                  data-caption={item.caption}
                  aria-haspopup="dialog"
                  aria-label={`${item.badge} · ${item.title} — Open photo`}
                >
                  <div class="tile-inner">
                    <span class="tile-badge" aria-hidden="true">{item.badge}</span>
                    <Image
                      src={item.image}
                      alt={item.alt}
                      width={item.isFeature ? 1100 : 760}
                      height={item.isFeature ? 730 : 760}
                      widths={item.isFeature ? [360, 560, 800, 1100] : [240, 360, 520, 760]}
                      sizes={item.isFeature ? '(min-width: 1024px) 620px, 100vw' : '(min-width: 1024px) 320px, 50vw'}
                      loading={rowIndex === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="tile-img"
                      style={`object-position: ${item.objectPosition || 'center center'};`}
                    />

                    <div class="tile-overlay">
                      <div class="overlay-content">
                        <span class="overlay-meta">{item.badge} · {item.title}</span>
                        <p class="overlay-caption line-clamp-2">“{item.caption}”</p>
                        <span class="overlay-cta" aria-hidden="true">Open story →</span>
                      </div>
                    </div>
                  </div>
                </button>
              );
            })}
          </div>
        ))
      }
    </div>

    <!-- Show Posters & Archive (5-col desktop spotlight grid / mobile horizontal snap reel) -->
    <div class="gallery-archive-block" id="gallery-archive-block">
      <div class="archive-header">
        <div class="archive-titles">
          <span class="font-script archive-eyebrow">Proof of range (and 90s eyebrows)</span>
          <h2 class="archive-heading">SHOW POSTERS &amp; ARCHIVE</h2>
        </div>

        <div class="reel-controls">
          <p class="archive-note">Click any poster to read Janelle’s story behind the show.</p>
          <div class="reel-steppers" aria-label="Spotlight reel navigation">
            <button type="button" class="reel-step-btn" id="reel-prev-btn" aria-label="Scroll posters left">
              ←
            </button>
            <button type="button" class="reel-step-btn" id="reel-next-btn" aria-label="Scroll posters right">
              →
            </button>
          </div>
        </div>
      </div>

      <div
        class="poster-reel"
        id="poster-reel"
        tabindex="0"
        role="region"
        aria-label="Show posters spotlight reel"
      >
        {
          indexedPosters.map((item) => (
            <button
              type="button"
              class="gallery-tile is-poster poster-slide"
              style={`--stagger-delay: ${item.staggerDelay}ms; view-transition-name: vt-${item.id};`}
              data-gallery-tile
              data-filter-group={item.filterGroup}
              data-index={item.globalIndex}
              data-src={item.image.src}
              data-alt={item.alt}
              data-badge={item.badge}
              data-category={item.category}
              data-title={item.title}
              data-caption={item.caption}
              aria-haspopup="dialog"
              aria-label={`${item.badge} · ${item.title} — Open poster story`}
            >
              <div class="tile-inner is-poster-inner">
                <div class="poster-stage">
                  <Image
                    src={item.image}
                    alt=""
                    width={600}
                    height={600}
                    widths={[220, 320, 480, 600]}
                    sizes="(min-width: 1024px) 240px, 64vw"
                    loading="lazy"
                    decoding="async"
                    class="poster-img"
                  />
                </div>
                <div class="poster-meta-bar">
                  <span class="poster-title-line">
                    <span class="poster-num">{item.badge}</span>
                    <span aria-hidden="true"> · </span>
                    {item.title}
                  </span>
                  <span class="poster-cta">Read story<span aria-hidden="true"> →</span></span>
                </div>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-tile]'));
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-filter]'));
  const rowsContainer = document.getElementById('gallery-rows');
  const archiveBlock = document.getElementById('gallery-archive-block');
  const posterReel = document.getElementById('poster-reel');
  const reelPrevBtn = document.getElementById('reel-prev-btn');
  const reelNextBtn = document.getElementById('reel-next-btn');

  // Fallback reveal for primary contact tiles when CSS scroll-driven view() is unsupported
  if (
    !CSS.supports('(animation-timeline: view()) and (animation-range: entry)') &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
    'IntersectionObserver' in window
  ) {
    document.documentElement.classList.add('gallery-io-fallback');
    const contactTiles = tiles.filter((t) => t.classList.contains('is-contact-tile'));
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -20px 0px' }
    );
    contactTiles.forEach((tile) => observer.observe(tile));
  } else {
    tiles.forEach((tile) => tile.classList.add('is-revealed'));
  }

  function applyFilterDom(filterId: string) {
    filterBtns.forEach((btn) => {
      const isActive = btn.dataset.galleryFilter === filterId;
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });

    if (!rowsContainer || !archiveBlock) return;

    if (filterId === 'all') {
      rowsContainer.hidden = false;
      rowsContainer.classList.remove('is-filtered');
      archiveBlock.hidden = false;
      archiveBlock.classList.remove('is-standalone');
      tiles.forEach((tile) => {
        tile.hidden = false;
        tile.classList.add('is-revealed');
      });
    } else if (filterId === 'posters') {
      rowsContainer.hidden = true;
      rowsContainer.classList.remove('is-filtered');
      archiveBlock.hidden = false;
      archiveBlock.classList.add('is-standalone');
      tiles.forEach((tile) => {
        const match = tile.dataset.filterGroup === 'posters';
        tile.hidden = !match;
        if (match) tile.classList.add('is-revealed');
      });
    } else {
      rowsContainer.hidden = false;
      rowsContainer.classList.add('is-filtered');
      archiveBlock.hidden = true;
      archiveBlock.classList.remove('is-standalone');
      tiles.forEach((tile) => {
        const match = tile.dataset.filterGroup === filterId;
        tile.hidden = !match;
        if (match) tile.classList.add('is-revealed');
      });
    }

    window.dispatchEvent(new CustomEvent('gallery:filter-change'));
  }

  let activeFilterId = 'all';

  async function applyFilterWithTransition(filterId: string) {
    if (filterId === activeFilterId) return;
    activeFilterId = filterId;

    if (
      typeof document.startViewTransition !== 'function' ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches
    ) {
      applyFilterDom(filterId);
      return;
    }

    document.documentElement.classList.add('is-filtering-vt');
    try {
      const vt = document.startViewTransition(() => {
        applyFilterDom(filterId);
      });
      await vt.finished;
    } finally {
      document.documentElement.classList.remove('is-filtering-vt');
    }
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filterId = btn.dataset.galleryFilter || 'all';
      void applyFilterWithTransition(filterId);
    });
  });

  // Mobile/Tablet Spotlight Reel Stepper & WAAPI Fallback (< 1024px)
  if (posterReel) {
    const mobileMq = window.matchMedia('(max-width: 1023px)');

    const stepReel = (direction: -1 | 1) => {
      const slide = posterReel.querySelector<HTMLElement>('.poster-slide');
      const stepPx = (slide?.offsetWidth || 240) + 14;
      posterReel.scrollBy({
        left: direction * stepPx,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    reelPrevBtn?.addEventListener('click', () => stepReel(-1));
    reelNextBtn?.addEventListener('click', () => stepReel(1));

    posterReel.addEventListener('keydown', (e) => {
      if (e.target !== posterReel || !mobileMq.matches) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        stepReel(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        stepReel(-1);
      }
    });

    if (
      !CSS.supports('(animation-timeline: view()) and (animation-range: entry)') &&
      window.matchMedia('(prefers-reduced-motion: no-preference)').matches
    ) {
      const slides = Array.from(posterReel.querySelectorAll<HTMLElement>('.poster-slide'));
      const animations = new Map<HTMLElement, Animation>();

      const setupOrClearFallback = () => {
        if (!mobileMq.matches) {
          animations.forEach((anim) => anim.cancel());
          animations.clear();
          return;
        }
        if (animations.size === 0) {
          slides.forEach((slide) => {
            const anim = slide.animate(
              [
                { scale: '0.94', opacity: 0.78 },
                { scale: '1', opacity: 1, offset: 0.2 },
                { scale: '1', opacity: 1, offset: 0.8 },
                { scale: '0.94', opacity: 0.78 },
              ],
              { duration: 1, fill: 'both' }
            );
            anim.pause();
            animations.set(slide, anim);
          });
        }
        const reelRect = posterReel.getBoundingClientRect();
        if (!reelRect.width) return;
        slides.forEach((slide) => {
          const anim = animations.get(slide);
          if (!anim) return;
          const slideRect = slide.getBoundingClientRect();
          const centerProgress =
            (slideRect.left + slideRect.width / 2 - reelRect.left) / reelRect.width;
          anim.currentTime = Math.max(0, Math.min(1, centerProgress));
        });
      };

      posterReel.addEventListener('scroll', setupOrClearFallback, { passive: true });
      window.addEventListener('resize', setupOrClearFallback, { passive: true });
      requestAnimationFrame(setupOrClearFallback);
    }
  }
</script>

<style>
  .gallery-grid-section {
    --colour-focus: var(--colour-focus-on-dark);
    background-color: var(--colour-footer);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .gallery-grid-container {
    width: 100%;
  }

  /* ==========================================================================
     Interactive Category Filter Toolbar
     ========================================================================== */
  .gallery-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin-bottom: clamp(1.25rem, 2.4vw, 1.85rem);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--colour-dark-border);
  }

  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-xs);
    background-color: var(--colour-dark-surface);
    border: 1px solid var(--colour-dark-border-strong);
    color: var(--colour-dark-ink);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
    touch-action: manipulation;
  }

  .filter-pill:hover {
    background-color: var(--colour-dark-elevated-hover);
    border-color: var(--colour-dark-border-hover);
    transform: translateY(-1px);
  }

  .filter-pill.is-active {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
  }

  .filter-count {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    opacity: 0.78;
    font-variant-numeric: tabular-nums;
  }

  .gallery-hint {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--colour-dark-muted);
    margin: 0;
  }

  /* ==========================================================================
     Primary Contact Sheet Rows & View-Transition Filter Morphing
     ========================================================================== */
  .gallery-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.2vw, 12px);
    width: 100%;
  }

  .gallery-rows[hidden],
  .gallery-archive-block[hidden],
  .gallery-tile[hidden] {
    display: none !important;
  }

  .gallery-row {
    display: grid;
    grid-template-columns: var(--row-cols);
    height: var(--row-h);
    gap: clamp(8px, 1.2vw, 12px);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .gallery-rows.is-filtered {
      display: flex;
      flex-wrap: wrap;
      gap: clamp(10px, 1.4vw, 14px);
    }

    .gallery-rows.is-filtered .gallery-row {
      display: contents;
    }

    .gallery-rows.is-filtered .gallery-tile {
      flex: var(--tile-ratio, 1) 1 calc(var(--tile-ratio, 1) * clamp(180px, 18vw, 235px));
      width: auto;
      max-inline-size: calc(var(--tile-ratio, 1) * 480px);
      height: clamp(240px, 24vw, 315px);
      aspect-ratio: auto;
    }
  }

  @media (max-width: 1023px) {
    .gallery-rows,
    .gallery-rows.is-filtered {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .gallery-row {
      display: contents;
    }

    .gallery-tile.is-contact-tile,
    .gallery-rows.is-filtered .gallery-tile.is-contact-tile {
      aspect-ratio: 4 / 5;
      height: auto;
    }

    .gallery-tile.is-wide-mobile,
    .gallery-rows.is-filtered .gallery-tile.is-wide-mobile {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 480px) {
    .gallery-rows,
    .gallery-rows.is-filtered {
      gap: 8px;
    }

    .filter-pill {
      padding: 0.45rem 0.72rem;
      font-size: 0.6875rem;
    }
  }

  /* Group Element View Transitions for Morphing Filters */
  .gallery-tile {
    view-transition-class: gallery-card-vt;
  }

  @media (prefers-reduced-motion: no-preference) {
    ::view-transition {
      pointer-events: none;
    }

    ::view-transition-group(.gallery-card-vt) {
      animation-duration: 0.44s;
      animation-timing-function: var(--ease-out);
    }

    ::view-transition-new(.gallery-card-vt):only-child {
      animation: gallery-tile-enter 0.36s var(--ease-out) both;
    }

    ::view-transition-old(.gallery-card-vt):only-child {
      animation: gallery-tile-exit 0.22s cubic-bezier(0.4, 0, 1, 1) both;
    }

    @keyframes gallery-tile-enter {
      from {
        opacity: 0;
        transform: scale(0.9);
      }
    }

    @keyframes gallery-tile-exit {
      to {
        opacity: 0;
        transform: scale(0.9);
      }
    }
  }

  /* Scroll-linked contact tile entrances on initial unfiltered browse */
  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      @keyframes tile-scroll-in {
        from {
          opacity: 0;
          translate: 0 24px;
          scale: 0.96;
        }
        to {
          opacity: 1;
          translate: 0 0;
          scale: 1;
        }
      }

      .gallery-rows:not(.is-filtered) .is-contact-tile {
        animation: tile-scroll-in auto var(--ease-out) both;
        animation-timeline: view();
        animation-range: entry 0% entry 28%;
      }
    }
  }

  :global(.gallery-io-fallback) .gallery-rows:not(.is-filtered) .is-contact-tile:not(.is-revealed) {
    opacity: 0;
    transform: translateY(16px) scale(0.97);
  }

  :global(.gallery-io-fallback) .gallery-rows:not(.is-filtered) .is-contact-tile.is-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 550ms var(--ease-out) var(--stagger-delay, 0ms),
      transform 550ms var(--ease-out) var(--stagger-delay, 0ms),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  /* ==========================================================================
     Show Posters & Archive: 5-Col Desktop Spotlight Grid / Mobile Snap Reel
     ========================================================================== */
  .gallery-archive-block {
    margin-top: clamp(2.5rem, 4.5vw, 3.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--colour-dark-border);
  }

  .gallery-archive-block.is-standalone {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .archive-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    flex-wrap: wrap;
  }

  .archive-titles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .archive-eyebrow {
    font-size: clamp(1.35rem, 1.05rem + 0.5vw, 1.65rem);
    line-height: 1.1;
    color: var(--colour-primary-on-dark);
    margin-bottom: 2px;
  }

  .archive-heading {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.05rem + 0.55vw, 1.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .reel-controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .archive-note {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--colour-dark-muted);
    margin: 0;
  }

  .reel-steppers {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .reel-step-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-dark-surface);
    border: 1px solid var(--colour-dark-border-strong);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .reel-step-btn:hover {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    transform: translateY(-1px);
  }

  /* Desktop (1024px+): Full-Width 5-Column Spotlight Grid (zero void, zero scrollbar) */
  @media (min-width: 1024px) {
    .reel-steppers {
      display: none;
    }

    .poster-reel {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: clamp(12px, 1.5vw, 18px);
      align-items: stretch;
      overflow: visible;
      padding: 0;
    }

    .poster-slide {
      display: flex;
      flex-direction: column;
      height: 100%;
      width: auto;
    }

    @media (prefers-reduced-motion: no-preference) {
      .poster-reel .is-poster-inner {
        transition:
          opacity 240ms var(--ease-out),
          transform 260ms var(--ease-out),
          border-color 240ms var(--ease-out),
          box-shadow 260ms var(--ease-out);
      }

      .poster-reel:has(.poster-slide:hover, .poster-slide:focus-visible)
        .poster-slide:not(:hover):not(:focus-visible)
        .is-poster-inner {
        opacity: 0.68;
      }

      .poster-slide:hover .is-poster-inner,
      .poster-slide:focus-visible .is-poster-inner {
        transform: translateY(-6px) scale(1.03);
        border-color: var(--colour-primary-on-dark);
        box-shadow: 0 18px 36px rgba(0, 0, 0, 0.65);
      }

      @supports ((animation-timeline: view()) and (animation-range: entry)) {
        .poster-slide {
          animation: tile-scroll-in auto var(--ease-out) both;
          animation-timeline: view();
          animation-range: entry 0% entry 30%;
        }
      }
    }
  }

  /* Tablet & Mobile (< 1024px): Clean Horizontal Scroll-Snap Spotlight Reel */
  @media (max-width: 1023px) {
