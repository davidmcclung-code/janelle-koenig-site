---
/**
 * GalleryGrid.astro
 * Editorial contact sheet: natural-proportion asymmetric rows for live/event
 * photography, followed by a framed 5-poster archive row.
 */
import { Image } from 'astro:assets';
import { indexedMainRows, indexedPosters } from '../data/gallery';
---

<section class="gallery-grid-section" aria-label="Photo Gallery">
  <div class="container gallery-grid-container">
    <!-- Primary Contact Sheet: 16 Live, Event & Hosting Photographs -->
    <div class="gallery-rows">
      {
        indexedMainRows.map((row, rowIndex) => (
          <div
            class="gallery-row"
            style={`--row-cols: ${row.cols}; --row-h: ${row.height};`}
          >
            {row.items.map((item) => (
              <button
                type="button"
                class:list={[
                  'gallery-tile',
                  { 'is-feature': item.isFeature, 'is-wide-mobile': item.isWideMobile },
                ]}
                style={`--stagger-delay: ${item.staggerDelay}ms;`}
                data-gallery-tile
                data-index={item.globalIndex}
                data-src={item.image.src}
                data-alt={item.alt}
                data-badge={item.badge}
                data-category={item.category}
                data-title={item.title}
                data-caption={item.caption}
                aria-haspopup="dialog"
                aria-label={`Open photo ${item.badge}: ${item.title}`}
              >
                <div class="tile-inner">
                  <span class="tile-badge" aria-hidden="true">{item.badge}</span>
                  <Image
                    src={item.image}
                    alt={item.alt}
                    width={item.isFeature ? 1100 : 760}
                    height={item.isFeature ? 730 : 760}
                    widths={item.isFeature ? [360, 560, 800, 1100] : [240, 360, 520, 760]}
                    sizes={item.isFeature ? '(min-width: 1024px) 620px, 100vw' : '(min-width: 1024px) 320px, 50vw'}
                    loading={rowIndex === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="tile-img"
                    style={`object-position: ${item.objectPosition || 'center center'};`}
                  />

                  <div class="tile-overlay">
                    <div class="overlay-content">
                      <span class="overlay-meta">{item.badge} · {item.title}</span>
                      <p class="overlay-caption line-clamp-2">“{item.caption}”</p>
                      <span class="overlay-cta" aria-hidden="true">Click to open Story Lightbox →</span>
                    </div>
                  </div>
                </div>
              </button>
            ))}
          </div>
        ))
      }
    </div>

    <!-- Secondary Row: Show Posters & Archive -->
    <div class="gallery-archive-block">
      <div class="archive-header">
        <div class="archive-titles">
          <span class="font-script archive-eyebrow">Proof of range (and 90s eyebrows)</span>
          <h2 class="archive-heading">SHOW POSTERS &amp; ARCHIVE</h2>
        </div>
        <p class="archive-note">Click any poster to read Janelle’s story behind the show.</p>
      </div>

      <div class="poster-grid">
        {
          indexedPosters.map((item) => (
            <button
              type="button"
              class="gallery-tile is-poster"
              style={`--stagger-delay: ${item.staggerDelay}ms;`}
              data-gallery-tile
              data-index={item.globalIndex}
              data-src={item.image.src}
              data-alt={item.alt}
              data-badge={item.badge}
              data-category={item.category}
              data-title={item.title}
              data-caption={item.caption}
              aria-haspopup="dialog"
              aria-label={`Open poster ${item.badge}: ${item.title}`}
            >
              <div class="tile-inner is-poster-inner">
                <span class="tile-badge" aria-hidden="true">{item.badge}</span>
                <Image
                  src={item.image}
                  alt={item.alt}
                  width={600}
                  height={720}
                  widths={[220, 320, 480, 600]}
                  sizes="(min-width: 1024px) 240px, 50vw"
                  loading="lazy"
                  decoding="async"
                  class="tile-img is-poster-img"
                />
                <div class="tile-overlay">
                  <div class="overlay-content">
                    <span class="overlay-meta">{item.badge} · {item.title}</span>
                    <p class="overlay-caption line-clamp-2">“{item.caption}”</p>
                    <span class="overlay-cta" aria-hidden="true">Click to open Story Lightbox →</span>
                  </div>
                </div>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-gallery-tile]'));

  function revealTile(tile: HTMLElement) {
    if (tile.classList.contains('is-revealed')) return;
    tile.classList.add('is-revealed');
    const delayStr = getComputedStyle(tile).getPropertyValue('--stagger-delay').trim();
    const delayMs = parseFloat(delayStr) || 0;
    window.setTimeout(() => {
      tile.classList.add('is-settled');
    }, 580 + delayMs);
  }

  if (
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            revealTile(entry.target as HTMLElement);
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
    );

    tiles.forEach((tile) => observer.observe(tile));
  } else {
    tiles.forEach((tile) => tile.classList.add('is-revealed', 'is-settled'));
  }
</script>

<style>
  .gallery-grid-section {
    --colour-focus: var(--colour-focus-on-dark);
    background-color: var(--colour-footer);
    padding-top: clamp(2rem, 4vw, 3.25rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .gallery-grid-container {
    width: 100%;
  }

  /* ==========================================================================
     Primary Rows (Desktop: 5 natural-proportion asymmetric rows)
     ========================================================================== */
  .gallery-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.2vw, 12px);
    width: 100%;
  }

  .gallery-row {
    display: grid;
    grid-template-columns: var(--row-cols);
    height: var(--row-h);
    gap: clamp(8px, 1.2vw, 12px);
    width: 100%;
  }

  /* Tablet & Mobile (< 1024px): dissolve row wrappers into a clean 2-col grid */
  @media (max-width: 1023px) {
    .gallery-rows {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .gallery-row {
      display: contents;
    }

    .gallery-tile {
      aspect-ratio: 4 / 5;
      height: auto;
    }

    .gallery-tile.is-wide-mobile {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 480px) {
    .gallery-rows {
      gap: 8px;
    }
  }

  /* ==========================================================================
     Show Posters & Archive Sub-Row
     ========================================================================== */
  .gallery-archive-block {
    content-visibility: auto;
    contain-intrinsic-size: auto 24rem;
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    padding-top: clamp(1.5rem, 2.5vw, 2rem);
    border-top: 1px solid var(--colour-dark-border);
  }

  .archive-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    flex-wrap: wrap;
  }

  .archive-titles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .archive-eyebrow {
    font-size: clamp(1.35rem, 1.05rem + 0.5vw, 1.65rem);
    line-height: 1.1;
    color: var(--colour-primary-on-dark);
    margin-bottom: 2px;
  }

  .archive-heading {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.05rem + 0.55vw, 1.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0;
  }

  .archive-note {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--colour-dark-muted);
    margin: 0;
  }

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: clamp(8px, 1.2vw, 12px);
    width: 100%;
  }

  .gallery-tile.is-poster {
    aspect-ratio: 4 / 5;
    height: auto;
  }

  @media (max-width: 1023px) {
    .poster-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .poster-grid .gallery-tile.is-poster:last-child {
      grid-column: 1 / -1;
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 480px) {
    .poster-grid {
      gap: 8px;
    }
  }

  @media (max-width: 359px) {
    .gallery-rows,
    .poster-grid {
      grid-template-columns: 1fr;
    }

    .gallery-tile,
    .gallery-tile.is-wide-mobile,
    .poster-grid .gallery-tile.is-poster:last-child {
      aspect-ratio: 4 / 3;
    }
  }

  /* ==========================================================================
     Gallery Tile Button & Entrance / Hover Transitions
     ========================================================================== */
  .gallery-tile {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 0;
    margin: 0;
    border: none;
    background-color: var(--colour-dark-tile);
    border-radius: var(--radius-sm);
    cursor: pointer;
    overflow: visible;
    text-align: left;
    outline: none;
    z-index: 1;
    touch-action: manipulation;
    transition:
      opacity 550ms var(--ease-out) var(--stagger-delay, 0ms),
      transform 550ms var(--ease-out) var(--stagger-delay, 0ms),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  :global(.js) .gallery-tile:not(.is-revealed) {
    opacity: 0;
    transform: translateY(16px) scale(0.97);
  }

  :global(.js) .gallery-tile.is-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .gallery-tile.is-settled {
    transition:
      transform var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .gallery-tile.is-settled:active {
      transform: scale(0.985);
    }
  }

  .tile-inner {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--colour-dark-tile);
    border: 1px solid var(--colour-dark-border);
    transition: border-color var(--motion-fast) var(--ease-out);
  }

  .is-poster-inner {
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--motion-standard) var(--ease-out);
  }

  .is-poster-img {
    object-fit: contain;
    border-radius: var(--radius-xs);
  }

  /* Corner Index Pill */
  .tile-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    min-height: 22px;
    height: auto;
    padding: 0 7px;
    border-radius: var(--radius-xs);
    background: rgba(10, 10, 10, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out);
    pointer-events: none;
  }

  .gallery-tile:hover .tile-badge,
  .gallery-tile:focus-visible .tile-badge {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
  }

  .gallery-tile:focus-visible {
    outline: 3px solid var(--colour-primary-on-dark);
    outline-offset: 3px;
    z-index: 10;
  }

  .gallery-tile:focus-visible .tile-inner {
    border-color: var(--colour-primary-on-dark);
  }

  /* Desktop Hover & Focus State */
  @media (min-width: 1024px) {
    .gallery-tile:hover,
    .gallery-tile:focus-visible {
      transform: scale(1.02);
      z-index: 10;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.7);
    }

    .gallery-tile:hover .tile-inner,
    .gallery-tile:focus-visible .tile-inner {
      border-color: var(--colour-primary-on-dark);
    }

    .gallery-tile:hover .tile-img,
    .gallery-tile:focus-visible .tile-img {
      transform: scale(1.03);
    }
  }

  /* Overlay & Teaser Caption (Hover/Focus on Desktop) */
  .tile-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-4);
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.95) 0%,
      rgba(10, 10, 10, 0.72) 45%,
      rgba(10, 10, 10, 0) 100%
    );
    opacity: 0;
    transition: opacity var(--motion-fast) var(--ease-out);
    pointer-events: none;
  }

  @media (min-width: 1024px) {
    .gallery-tile:hover .tile-overlay,
    .gallery-tile:focus-visible .tile-overlay {
      opacity: 1;
    }
  }

  @media (max-width: 1023px), (hover: none) {
    .tile-overlay {
      opacity: 1;
      padding: var(--space-2) var(--space-3);
      background: linear-gradient(
        to top,
        rgba(10, 10, 10, 0.88) 0%,
        rgba(10, 10, 10, 0.45) 55%,
        rgba(10, 10, 10, 0) 100%
      );
    }

    .overlay-caption,
    .overlay-cta {
      display: none;
    }

    .overlay-meta {
      font-size: 0.6875rem;
      color: #ffffff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  .overlay-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 100%;
  }

  .overlay-meta {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--colour-primary-light);
  }

  .overlay-caption {
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 0.75rem + 0.15vw, 0.875rem);
    line-height: 1.38;
    color: #ffffff;
    margin: 0;
  }

  .overlay-cta {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--colour-primary-on-dark);
    margin-top: 2px;
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .gallery-tile:not(.is-revealed),
    .gallery-tile,
    .tile-img,
    .tile-inner,
    .tile-badge,
    .tile-overlay {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .gallery-tile:hover,
    .gallery-tile:focus-visible {
      transform: none !important;
    }
  }
</style>
