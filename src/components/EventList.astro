---
import type { EventItem } from '../types';
import EventRow from './EventRow.astro';

interface Props {
  events: EventItem[];
  sheetUrl?: string;
}

const { events, sheetUrl } = Astro.props;
const hasEvents = Array.isArray(events) && events.length > 0;
---

<div class="event-list-wrapper" data-sheet-url={sheetUrl}>
  <!-- Loading state shown initially while syncing live calendar -->
  <div class="events-loading-state" id="events-loading-state" aria-live="polite">
    <div class="loading-spinner" aria-hidden="true"></div>
    <p class="loading-text">Checking Janelle's Diary...</p>
  </div>

  <ul class="event-list" aria-label="Upcoming Shows" style="display: none;">
    {hasEvents && events.map((event, index) => (
      <EventRow event={event} index={index} />
    ))}
  </ul>

  <div class="events-empty-state" style="display: none;">
    <p class="empty-text">No upcoming public shows currently announced.</p>
    <p class="empty-subtext">Check back soon or enquire for private & corporate bookings.</p>
    <button type="button" class="btn btn-primary empty-enquire-btn" data-booking-trigger>
      BOOK JANELLE
    </button>
  </div>
</div>

<style>
  .event-list-wrapper {
    width: 100%;
  }

  .events-loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-4);
    background-color: var(--colour-surface-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--colour-border);
    text-align: center;
  }

  .loading-spinner {
    width: 26px;
    height: 26px;
    border: 3px solid rgba(138, 21, 56, 0.15);
    border-top-color: var(--colour-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .loading-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--colour-ink);
    letter-spacing: -0.01em;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-spinner {
      animation: none;
    }
  }

  .event-list {
    display: flex;
    flex-direction: column;
  }

  .events-empty-state {
    padding: var(--space-7);
    background-color: var(--colour-surface-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--colour-border);
    text-align: center;
  }

  .empty-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--colour-ink);
    margin-bottom: var(--space-2);
  }

  .empty-subtext {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--colour-muted);
    margin-bottom: var(--space-4);
  }

  .empty-enquire-btn {
    margin-inline: auto;
  }
</style>

<script>
  import { processEventsFromCSV, processEventsFromGviz, extractSheetId } from '../utils/events';
  import type { EventItem } from '../types';

  async function syncEventsFromSheet() {
    const wrapper = document.querySelector<HTMLElement>('.event-list-wrapper[data-sheet-url]');
    if (!wrapper) return;

    const rawUrl = wrapper.dataset.sheetUrl || '';
    if (!rawUrl) return;

    const loadingEl = wrapper.querySelector<HTMLElement>('.events-loading-state');
    const listEl = wrapper.querySelector<HTMLElement>('.event-list');
    const emptyStateEl = wrapper.querySelector<HTMLElement>('.events-empty-state');

    function applyEvents(upcomingEvents: EventItem[]) {
      if (loadingEl) loadingEl.style.display = 'none';

      if (!upcomingEvents || upcomingEvents.length === 0) {
        if (listEl) {
          listEl.style.display = 'none';
          listEl.innerHTML = '';
        }
        if (emptyStateEl) emptyStateEl.style.display = '';
        return;
      }

      // Render updated upcoming events with identical styling & attributes
      const rowsHtml = upcomingEvents
        .map((event, index) => {
          const isExternal = event.ticketUrl.startsWith('http');
          const linkAttrs = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
          const actionHtml = event.isSoldOut
            ? '<span class="event-badge sold-out">SOLD OUT</span>'
            : `<a href="${escapeHtml(event.ticketUrl)}"${linkAttrs} class="event-ticket-link" aria-label="Get tickets for ${escapeHtml(event.title)}">
                <span>TICKETS</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>`;

          return `
            <li class="event-row" data-event-id="${escapeHtml(event.id)}" style="--row-index: ${index};">
              <div class="event-date">
                <span class="event-day">${escapeHtml(event.day)}</span>
                <span class="event-month">${escapeHtml(event.month)}</span>
              </div>
              <div class="event-details">
                <h3 class="event-title wrap-break" title="${escapeHtml(event.title)}">${escapeHtml(event.title)}</h3>
                <p class="event-venue wrap-break" title="${escapeHtml(event.venue)}, ${escapeHtml(event.location)}">${escapeHtml(event.venue)}, ${escapeHtml(event.location)}</p>
              </div>
              <div class="event-action">
                ${actionHtml}
              </div>
            </li>
          `;
        })
        .join('');

      if (listEl) {
        listEl.innerHTML = rowsHtml;
        listEl.style.display = '';
      }
      if (emptyStateEl) {
        emptyStateEl.style.display = 'none';
      }
    }

    // Safety timeout: if network takes longer than 5 seconds, fallback
    const timeoutId = setTimeout(() => {
      if (loadingEl && loadingEl.style.display !== 'none') {
        loadingEl.style.display = 'none';
        if (listEl && listEl.children.length > 0) {
          listEl.style.display = '';
        } else if (emptyStateEl) {
          emptyStateEl.style.display = '';
        }
      }
    }, 5000);

    const sheetId = extractSheetId(rawUrl);

    if (sheetId) {
      // Direct Real-Time Google Visualization API via JSONP (bypasses browser CORS completely)
      const callbackName = '__gviz_cb_' + Math.floor(Math.random() * 1000000);
      (window as any)[callbackName] = (data: any) => {
        clearTimeout(timeoutId);
        try {
          delete (window as any)[callbackName];
        } catch {
          (window as any)[callbackName] = undefined;
        }
        scriptEl.remove();
        const upcomingEvents = processEventsFromGviz(data);
        applyEvents(upcomingEvents);
      };

      const scriptEl = document.createElement('script');
      scriptEl.src = `https://docs.google.com/spreadsheets/d/${sheetId}/gviz/tq?tqx=responseHandler:${callbackName}&gid=0&_t=${Date.now()}`;
      scriptEl.onerror = () => {
        clearTimeout(timeoutId);
        try {
          delete (window as any)[callbackName];
        } catch {
          (window as any)[callbackName] = undefined;
        }
        scriptEl.remove();
        if (loadingEl) loadingEl.style.display = 'none';
        if (listEl && listEl.children.length > 0) {
          listEl.style.display = '';
        } else if (emptyStateEl) {
          emptyStateEl.style.display = '';
        }
      };
      document.head.appendChild(scriptEl);
    } else {
      // Fallback for standard CSV URL
      fetch(rawUrl + (rawUrl.includes('?') ? '&' : '?') + '_t=' + Date.now(), { cache: 'no-cache' })
        .then((r) => r.text())
        .then((csvText) => {
          clearTimeout(timeoutId);
          const upcomingEvents = processEventsFromCSV(csvText);
          applyEvents(upcomingEvents);
        })
        .catch((err) => {
          clearTimeout(timeoutId);
          console.warn('Could not sync events from Google Sheet:', err);
          if (loadingEl) loadingEl.style.display = 'none';
          if (listEl && listEl.children.length > 0) {
            listEl.style.display = '';
          } else if (emptyStateEl) {
            emptyStateEl.style.display = '';
          }
        });
    }
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncEventsFromSheet);
  } else {
    syncEventsFromSheet();
  }
</script>

