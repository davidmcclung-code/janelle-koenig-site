---
import type { EventItem } from '../types';
import EventRow from './EventRow.astro';

interface Props {
  events: EventItem[];
  sheetUrl?: string;
}

const { events, sheetUrl } = Astro.props;
const hasEvents = Array.isArray(events) && events.length > 0;
---

<div class="event-list-wrapper" data-sheet-url={sheetUrl}>
  <!-- Skeleton rows matching EventRow geometry to guarantee zero layout shift during sync -->
  <ul class="event-skeleton-list" id="events-skeleton-list" aria-label="Loading upcoming shows" aria-busy="true">
    <li class="event-skeleton-row" aria-hidden="true">
      <div class="skeleton-date shimmer"></div>
      <div class="skeleton-details">
        <div class="skeleton-title shimmer"></div>
        <div class="skeleton-venue shimmer"></div>
      </div>
      <div class="skeleton-action shimmer"></div>
    </li>
    <li class="event-skeleton-row" aria-hidden="true">
      <div class="skeleton-date shimmer"></div>
      <div class="skeleton-details">
        <div class="skeleton-title shimmer"></div>
        <div class="skeleton-venue shimmer"></div>
      </div>
      <div class="skeleton-action shimmer"></div>
    </li>
    <li class="event-skeleton-row" aria-hidden="true">
      <div class="skeleton-date shimmer"></div>
      <div class="skeleton-details">
        <div class="skeleton-title shimmer"></div>
        <div class="skeleton-venue shimmer"></div>
      </div>
      <div class="skeleton-action shimmer"></div>
    </li>
  </ul>

  <!-- Upcoming Shows List populated once live calendar syncs -->
  <ul class="event-list" id="event-list" aria-label="Upcoming Shows" style="display: none;">
    {hasEvents && events.map((event, index) => (
      <EventRow event={event} index={index} />
    ))}
  </ul>

  <!-- Empty state displayed if no upcoming public dates are announced -->
  <div class="events-empty-state" id="events-empty-state" style="display: none;">
    <p class="empty-text">No upcoming public shows currently announced.</p>
    <p class="empty-subtext">Check back soon or enquire for private & corporate bookings.</p>
    <button type="button" class="btn btn-primary empty-enquire-btn" data-booking-trigger>
      BOOK JANELLE
    </button>
  </div>
</div>

<style>
  .event-list-wrapper {
    width: 100%;
  }

  /* Skeleton Placeholders matching EventRow geometry */
  .event-skeleton-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .event-skeleton-row {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: 0.6rem 0.5rem;
    margin-inline: -0.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .event-skeleton-row:first-child {
    padding-top: 0.25rem;
  }

  .event-skeleton-row:last-child {
    border-bottom: none;
    padding-bottom: 0.25rem;
  }

  .skeleton-date {
    width: 48px;
    height: 40px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
    flex-shrink: 0;
  }

  .skeleton-details {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .skeleton-title {
    width: clamp(140px, 45%, 260px);
    height: 16px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
  }

  .skeleton-venue {
    width: clamp(110px, 35%, 190px);
    height: 12px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
  }

  .skeleton-action {
    width: 72px;
    height: 32px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
    flex-shrink: 0;
  }

  /* Shimmer pulse effect */
  .shimmer {
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.04) 25%,
      rgba(0, 0, 0, 0.08) 50%,
      rgba(0, 0, 0, 0.04) 75%
    );
    background-size: 200% 100%;
    animation: shimmerWave 1.6s ease-in-out infinite;
  }

  @keyframes shimmerWave {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (max-width: 580px) {
    .event-skeleton-row {
      grid-template-columns: 44px 1fr auto;
      gap: clamp(8px, 2.5vw, 12px);
      padding: 0.6rem 0;
      margin-inline: 0;
    }

    .skeleton-date {
      width: 44px;
      height: 36px;
    }

    .skeleton-title {
      width: clamp(120px, 50%, 200px);
      height: 15px;
    }

    .skeleton-venue {
      width: clamp(90px, 40%, 150px);
      height: 11px;
    }

    .skeleton-action {
      width: 58px;
      height: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shimmer {
      animation: none !important;
      background: var(--colour-surface-alt);
    }
  }

  .event-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events-empty-state {
    padding: var(--space-7);
    background-color: var(--colour-surface-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--colour-border);
    text-align: center;
  }

  .empty-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--colour-ink);
    margin-bottom: var(--space-2);
  }

  .empty-subtext {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--colour-muted);
    margin-bottom: var(--space-4);
  }

  .empty-enquire-btn {
    margin-inline: auto;
    min-height: 44px;
  }
</style>

<script>
  import { processEventsFromCSV, processEventsFromGviz, extractSheetId } from '../utils/events';
  import type { EventItem } from '../types';

  async function syncEventsFromSheet() {
    const wrapper = document.querySelector<HTMLElement>('.event-list-wrapper[data-sheet-url]');
    if (!wrapper) return;

    const rawUrl = wrapper.dataset.sheetUrl || '';
    if (!rawUrl) return;

    const skeletonEl = wrapper.querySelector<HTMLElement>('#events-skeleton-list');
    const listEl = wrapper.querySelector<HTMLElement>('#event-list');
    const emptyStateEl = wrapper.querySelector<HTMLElement>('#events-empty-state');

    function applyEvents(upcomingEvents: EventItem[]) {
      if (skeletonEl) {
        skeletonEl.style.opacity = '0';
        setTimeout(() => {
          skeletonEl.style.display = 'none';
        }, 150);
      }

      if (!upcomingEvents || upcomingEvents.length === 0) {
        if (listEl) {
          listEl.style.display = 'none';
          listEl.innerHTML = '';
        }
        if (emptyStateEl) emptyStateEl.style.display = '';
        return;
      }

      // Render updated upcoming events with identical styling & attributes
      const rowsHtml = upcomingEvents
        .map((event, index) => {
          const isExternal = event.ticketUrl.startsWith('http');
          const linkAttrs = isExternal ? ' target="_blank" rel="noopener noreferrer"' : '';
          const actionHtml = event.isSoldOut
            ? '<span class="event-badge sold-out">SOLD OUT</span>'
            : `<a href="${escapeHtml(event.ticketUrl)}"${linkAttrs} class="event-ticket-link" aria-label="Get tickets for ${escapeHtml(event.title)}">
                <span>TICKETS</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>`;

          return `
            <li class="event-row" data-event-id="${escapeHtml(event.id)}" style="--row-index: ${index};">
              <div class="event-date">
                <span class="event-day">${escapeHtml(event.day)}</span>
                <span class="event-month">${escapeHtml(event.month)}</span>
              </div>
              <div class="event-details">
                <h3 class="event-title wrap-break" title="${escapeHtml(event.title)}">${escapeHtml(event.title)}</h3>
                <p class="event-venue wrap-break" title="${escapeHtml(event.venue)}, ${escapeHtml(event.location)}">${escapeHtml(event.venue)}, ${escapeHtml(event.location)}</p>
              </div>
              <div class="event-action">
                ${actionHtml}
              </div>
            </li>
          `;
        })
        .join('');

      if (listEl) {
        listEl.innerHTML = rowsHtml;
        listEl.style.display = '';
      }
      if (emptyStateEl) {
        emptyStateEl.style.display = 'none';
      }
    }

    // Safety timeout: if network takes longer than 5 seconds, fallback
    const timeoutId = setTimeout(() => {
      if (skeletonEl && skeletonEl.style.display !== 'none') {
        skeletonEl.style.display = 'none';
        if (listEl && listEl.children.length > 0) {
          listEl.style.display = '';
        } else if (emptyStateEl) {
          emptyStateEl.style.display = '';
        }
      }
    }, 5000);

    const sheetId = extractSheetId(rawUrl);

    if (sheetId) {
      // Direct Real-Time Google Visualization API via JSONP (bypasses browser CORS completely)
      const callbackName = '__gviz_cb_' + Math.floor(Math.random() * 1000000);
      (window as any)[callbackName] = (data: any) => {
        clearTimeout(timeoutId);
        try {
          delete (window as any)[callbackName];
        } catch {
          (window as any)[callbackName] = undefined;
        }
        scriptEl.remove();
        const upcomingEvents = processEventsFromGviz(data);
        applyEvents(upcomingEvents);
      };

      const scriptEl = document.createElement('script');
      scriptEl.src = `https://docs.google.com/spreadsheets/d/${sheetId}/gviz/tq?tqx=responseHandler:${callbackName}&gid=0&_t=${Date.now()}`;
      scriptEl.onerror = () => {
        clearTimeout(timeoutId);
        try {
          delete (window as any)[callbackName];
        } catch {
          (window as any)[callbackName] = undefined;
        }
        scriptEl.remove();
        if (skeletonEl) skeletonEl.style.display = 'none';
        if (listEl && listEl.children.length > 0) {
          listEl.style.display = '';
        } else if (emptyStateEl) {
          emptyStateEl.style.display = '';
        }
      };
      document.head.appendChild(scriptEl);
    } else {
      // Fallback for standard CSV URL
      fetch(rawUrl + (rawUrl.includes('?') ? '&' : '?') + '_t=' + Date.now(), { cache: 'no-cache' })
        .then((r) => r.text())
        .then((csvText) => {
          clearTimeout(timeoutId);
          const upcomingEvents = processEventsFromCSV(csvText);
          applyEvents(upcomingEvents);
        })
        .catch((err) => {
          clearTimeout(timeoutId);
          console.warn('Could not sync events from Google Sheet:', err);
          if (skeletonEl) skeletonEl.style.display = 'none';
          if (listEl && listEl.children.length > 0) {
            listEl.style.display = '';
          } else if (emptyStateEl) {
            emptyStateEl.style.display = '';
          }
        });
    }
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncEventsFromSheet);
  } else {
    syncEventsFromSheet();
  }
</script>

