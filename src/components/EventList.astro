---
import type { EventItem } from '../types';
import EventRow from './EventRow.astro';

interface Props {
  events: EventItem[];
  sheetUrl?: string;
}

const { events, sheetUrl } = Astro.props;
const hasEvents = Array.isArray(events) && events.length > 0;
---

<div class="event-list-wrapper" data-sheet-url={sheetUrl}>
  <ul class="event-skeleton-list" id="events-skeleton-list" aria-label="Loading upcoming shows" aria-busy="true" style="display: none;">
    <li class="event-skeleton-row" aria-hidden="true">
      <div class="skeleton-date shimmer"></div>
      <div class="skeleton-details">
        <div class="skeleton-title shimmer"></div>
        <div class="skeleton-venue shimmer"></div>
      </div>
      <div class="skeleton-action shimmer"></div>
    </li>
    <li class="event-skeleton-row" aria-hidden="true">
      <div class="skeleton-date shimmer"></div>
      <div class="skeleton-details">
        <div class="skeleton-title shimmer"></div>
        <div class="skeleton-venue shimmer"></div>
      </div>
      <div class="skeleton-action shimmer"></div>
    </li>
    <li class="event-skeleton-row" aria-hidden="true">
      <div class="skeleton-date shimmer"></div>
      <div class="skeleton-details">
        <div class="skeleton-title shimmer"></div>
        <div class="skeleton-venue shimmer"></div>
      </div>
      <div class="skeleton-action shimmer"></div>
    </li>
  </ul>

  <ul class="event-list" id="event-list" role="list" aria-label="Upcoming Shows" style={hasEvents ? undefined : 'display: none;'}>
    {hasEvents && events.map((event, index) => (
      <EventRow event={event} index={index} />
    ))}
  </ul>

  <div class="events-empty-state" id="events-empty-state" aria-live="polite" style={hasEvents ? 'display: none;' : undefined}>
    <p class="empty-text">No upcoming public shows currently announced.</p>
    <p class="empty-subtext">Check back soon or enquire for private &amp; corporate bookings.</p>
    <button type="button" class="btn btn-primary empty-enquire-btn" data-booking-trigger>
      BOOK JANELLE
    </button>
  </div>
</div>

<style>
  .event-list-wrapper {
    width: 100%;
  }

  .event-skeleton-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: opacity var(--motion-fast) var(--ease-out);
  }

  .event-skeleton-row {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: 0.6rem 0.5rem;
    margin-inline: -0.5rem;
  }

  .event-skeleton-row:not(:last-child) {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .skeleton-date {
    width: 48px;
    height: 40px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
    flex-shrink: 0;
  }

  .skeleton-details {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .skeleton-title {
    width: clamp(140px, 45%, 260px);
    height: 16px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
  }

  .skeleton-venue {
    width: clamp(110px, 35%, 190px);
    height: 12px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
  }

  .skeleton-action {
    width: 72px;
    height: 32px;
    border-radius: var(--radius-xs);
    background-color: var(--colour-surface-alt);
    flex-shrink: 0;
  }

  .shimmer {
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.04) 25%,
      rgba(0, 0, 0, 0.08) 50%,
      rgba(0, 0, 0, 0.04) 75%
    );
    background-size: 200% 100%;
    animation: shimmerWave 1.6s ease-in-out infinite;
  }

  @keyframes shimmerWave {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shimmer {
      animation: none !important;
      background: var(--colour-surface-alt);
    }
  }

  .event-list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events-empty-state {
    padding: var(--space-7);
    background-color: var(--colour-surface-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--colour-border);
    text-align: center;
  }

  .empty-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--colour-ink);
    margin-bottom: var(--space-2);
  }

  .empty-subtext {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--colour-muted);
    margin-bottom: var(--space-4);
  }

  .empty-enquire-btn {
    margin-inline: auto;
    min-height: 44px;
  }
</style>

<script>
  import { processEventsFromCSV, getSheetCSVUrl } from '../utils/events';
  import type { EventItem } from '../types';

  const SVG_NS = 'http://www.w3.org/2000/svg';

  function sanitizeUrl(url: string): string {
    const trimmed = (url || '').trim();
    if (/^(https?:\/\/|\/|#)/i.test(trimmed)) {
      return trimmed;
    }
    return '#';
  }

  function createArrowSvgElement(): SVGSVGElement {
    const svg = document.createElementNS(SVG_NS, 'svg');
    svg.setAttribute('width', '12');
    svg.setAttribute('height', '12');
    svg.setAttribute('viewBox', '0 0 24 24');
    svg.setAttribute('fill', 'none');
    svg.setAttribute('stroke', 'currentColor');
    svg.setAttribute('stroke-width', '2.5');
    svg.setAttribute('stroke-linecap', 'round');
    svg.setAttribute('stroke-linejoin', 'round');
    svg.setAttribute('aria-hidden', 'true');

    const line = document.createElementNS(SVG_NS, 'line');
    line.setAttribute('x1', '5');
    line.setAttribute('y1', '12');
    line.setAttribute('x2', '19');
    line.setAttribute('y2', '12');

    const polyline = document.createElementNS(SVG_NS, 'polyline');
    polyline.setAttribute('points', '12 5 19 12 12 19');

    svg.append(line, polyline);
    return svg;
  }

  function createEventRowElement(event: EventItem, index: number): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'event-row';
    li.dataset.eventId = event.id;
    li.style.setProperty('--row-index', String(index));

    const dateDiv = document.createElement('div');
    dateDiv.className = 'event-date';

    const daySpan = document.createElement('span');
    daySpan.className = 'event-day';
    daySpan.textContent = event.day;

    const monthSpan = document.createElement('span');
    monthSpan.className = 'event-month';
    monthSpan.textContent = event.month;

    dateDiv.append(daySpan, monthSpan);

    const detailsDiv = document.createElement('div');
    detailsDiv.className = 'event-details';

    const titleHeading = document.createElement('h3');
    titleHeading.className = 'event-title wrap-break';
    titleHeading.textContent = event.title;

    const venueP = document.createElement('p');
    venueP.className = 'event-venue wrap-break';
    venueP.textContent = event.location ? `${event.venue}, ${event.location}` : event.venue;

    detailsDiv.append(titleHeading, venueP);

    const actionDiv = document.createElement('div');
    actionDiv.className = 'event-action';

    if (event.isSoldOut) {
      const badge = document.createElement('span');
      badge.className = 'event-badge sold-out';
      badge.textContent = 'SOLD OUT';
      actionDiv.appendChild(badge);
    } else {
      const safeUrl = sanitizeUrl(event.ticketUrl);
      const link = document.createElement('a');
      link.href = safeUrl;
      if (safeUrl.startsWith('http')) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      }
      link.className = 'event-ticket-link';
      link.setAttribute('aria-label', `Get tickets for ${event.title}`);

      const linkLabel = document.createElement('span');
      linkLabel.textContent = 'TICKETS';

      link.append(linkLabel, createArrowSvgElement());
      actionDiv.appendChild(link);
    }

    li.append(dateDiv, detailsDiv, actionDiv);
    return li;
  }

  async function syncEventsFromSheet() {
    const wrapper = document.querySelector<HTMLElement>('.event-list-wrapper[data-sheet-url]');
    if (!wrapper) return;

    const rawUrl = wrapper.dataset.sheetUrl || '';
    const csvUrl = getSheetCSVUrl(rawUrl);
    if (!csvUrl) return;

    const skeletonEl = wrapper.querySelector<HTMLElement>('#events-skeleton-list');
    const listEl = wrapper.querySelector<HTMLElement>('#event-list');
    const emptyStateEl = wrapper.querySelector<HTMLElement>('#events-empty-state');

    function revealFallback() {
      if (skeletonEl) skeletonEl.style.display = 'none';
      if (listEl && listEl.children.length > 0) {
        listEl.style.display = '';
        if (emptyStateEl) emptyStateEl.style.display = 'none';
      } else {
        if (listEl) listEl.style.display = 'none';
        if (emptyStateEl) emptyStateEl.style.display = '';
      }
    }

    function applyEvents(upcomingEvents: EventItem[]) {
      if (skeletonEl) {
        skeletonEl.style.opacity = '0';
        setTimeout(() => {
          skeletonEl.style.display = 'none';
        }, 150);
      }

      if (!upcomingEvents || upcomingEvents.length === 0) {
        if (listEl) {
          listEl.style.display = 'none';
          listEl.replaceChildren();
        }
        if (emptyStateEl) emptyStateEl.style.display = '';
        return;
      }

      if (listEl) {
        listEl.replaceChildren(...upcomingEvents.map((event, index) => createEventRowElement(event, index)));
        listEl.style.display = '';
      }
      if (emptyStateEl) {
        emptyStateEl.style.display = 'none';
      }
    }

    const controller = new AbortController();
    const timeoutId = setTimeout(() => {
      controller.abort();
    }, 5000);

    try {
      const fetchUrl = `${csvUrl}${csvUrl.includes('?') ? '&' : '?'}_t=${Date.now()}`;
      const res = await fetch(fetchUrl, {
        cache: 'no-cache',
        signal: controller.signal,
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const csvText = await res.text();
      const upcomingEvents = processEventsFromCSV(csvText);
      applyEvents(upcomingEvents);
    } catch (err) {
      console.warn('Could not sync events from Google Sheet:', err);
      revealFallback();
    } finally {
      clearTimeout(timeoutId);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncEventsFromSheet);
  } else {
    syncEventsFromSheet();
  }
</script>
