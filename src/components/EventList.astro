---
import type { EventItem } from '../types';
import EventRow from './EventRow.astro';

interface Props {
  events: EventItem[];
}

const { events } = Astro.props;
---

<div class="event-list-wrapper">
  {
    events && events.length > 0 ? (
      <ul class="event-list" aria-label="Upcoming Shows">
        {events.map((event, index) => (
          <EventRow event={event} index={index} />
        ))}
      </ul>
    ) : (
      <div class="events-empty-state">
        <p class="empty-text">No upcoming public shows currently announced.</p>
        <p class="empty-subtext">Check back soon or enquire for private & corporate bookings.</p>
      </div>
    )
  }
</div>

<style>
  .event-list-wrapper {
    width: 100%;
  }

  .event-list {
    display: flex;
    flex-direction: column;
  }

  .events-empty-state {
    padding: var(--space-7);
    background-color: var(--colour-surface-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--colour-border);
    text-align: center;
  }

  .empty-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--colour-ink);
    margin-bottom: var(--space-2);
  }

  .empty-subtext {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--colour-muted);
  }
</style>
