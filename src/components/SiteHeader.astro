---
import { siteConfig } from '../data/siteConfig';
import BrandLogo from './BrandLogo.astro';
import CloseIcon from './CloseIcon.astro';
import { asset } from '../utils/paths';

const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isItemActive = (itemHref: string) => {
  if (!itemHref.startsWith('/') || itemHref.startsWith('/#')) return false;
  const resolved = asset(itemHref).replace(/\/+$/, '') || '/';
  return normalizedPath === resolved;
};
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Brand Logo aligned to left margin -->
    <a href={asset('/')} class="logo-link" aria-label="Janelle Koenig Home">
      <BrandLogo variant="dark" />
    </a>

    <!-- Desktop Navigation centred across available space -->
    <nav class="nav-desktop" aria-label="Main Navigation">
      <ul class="nav-list">
        {
          siteConfig.navItems.map((item) => {
            const isActive = isItemActive(item.href);
            const href = item.href.startsWith('/') ? asset(item.href) : item.href;
            return (
              <li>
                <a
                  href={href}
                  class:list={['nav-link', { 'is-active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Header CTA button aligned to right margin -->
    <div class="header-action">
      <a href={asset('/#shows')} class="btn btn-secondary header-cta">
        SEE JANELLE LIVE
      </a>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="hamburger-icon" width="24" height="18" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="2" y1="2" x2="22" y2="2" />
        <line x1="2" y1="9" x2="22" y2="9" />
        <line x1="2" y1="16" x2="22" y2="16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    class="mobile-menu"
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile navigation menu"
    aria-hidden="true"
  >
    <div class="mobile-menu-inner">
      <div class="mobile-menu-header">
        <a href={asset('/')} class="logo-link" aria-label="Janelle Koenig Home" id="mobile-logo">
          <BrandLogo variant="dark" loading="eager" />
        </a>
        <button
          type="button"
          class="menu-close"
          id="menu-close"
          aria-label="Close navigation menu"
        >
          <CloseIcon size={24} />
        </button>
      </div>

      <nav class="mobile-nav" aria-label="Mobile Navigation">
        <ul class="mobile-nav-list">
          {
            siteConfig.navItems.map((item) => {
              const isActive = isItemActive(item.href);
              const href = item.href.startsWith('/') ? asset(item.href) : item.href;
              return (
                <li>
                  <a
                    href={href}
                    class:list={['mobile-nav-link', { 'is-active': isActive }]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="mobile-menu-cta">
          <a href={asset('/#shows')} class="btn btn-primary mobile-btn" id="mobile-cta-btn">
            SEE JANELLE LIVE
          </a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-header {
    width: 100%;
    z-index: 100;
    background: transparent;
    padding-top: 1.25rem;
    padding-bottom: 0.5rem;
    position: relative;
  }

  @media (max-width: 600px) {
    .site-header {
      padding-top: 0.85rem;
      padding-bottom: 0.25rem;
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    line-height: 1;
    z-index: 2;
  }

  /* Desktop Nav Centered */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 850px) {
    .nav-desktop {
      display: flex;
      align-items: center;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--colour-ink);
    text-transform: uppercase;
    position: relative;
    padding: var(--space-1) 0;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--colour-primary);
    transition: width var(--motion-fast) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--colour-primary);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  /* Header CTA Aligned to Right */
  .header-action {
    display: none;
    z-index: 2;
  }

  @media (min-width: 850px) {
    .header-action {
      display: block;
    }
  }

  .header-cta {
    padding: 0.55rem 1.15rem;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
  }

  /* Mobile Toggle Button */
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--colour-ink);
    position: relative;
    z-index: 2;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .menu-toggle:hover {
    color: var(--colour-primary);
  }

  .hamburger-icon {
    display: block;
    pointer-events: none;
  }

  @media (min-width: 850px) {
    .menu-toggle {
      display: none;
    }
  }

  /* Mobile Menu Drawer */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background-color: var(--colour-page);
    z-index: 200;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-100%);
    transition: opacity var(--motion-standard) var(--ease-out),
                transform var(--motion-standard) var(--ease-out),
                visibility var(--motion-standard);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-4) var(--container-gutter) var(--space-8);
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--colour-border);
  }

  .menu-close {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--colour-ink);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    padding-top: var(--space-6);
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .mobile-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 800;
    color: var(--colour-ink);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: var(--colour-primary);
  }

  .mobile-nav-link.is-active {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .mobile-menu-cta {
    padding-top: var(--space-6);
  }

  .mobile-btn {
    width: 100%;
    padding: 0.9rem;
    font-size: 0.9375rem;
  }

  @media (max-height: 540px) {
    .mobile-menu-inner {
      padding-bottom: var(--space-4);
    }

    .mobile-nav {
      padding-top: var(--space-3);
    }

    .mobile-nav-list {
      gap: var(--space-2);
    }

    .mobile-nav-link {
      font-size: 1.25rem;
      min-height: 44px;
    }

    .mobile-menu-cta {
      padding-top: var(--space-3);
    }
  }
</style>

<script is:inline>
  (function () {
    function getElements() {
      return {
        menuToggle: document.getElementById('menu-toggle'),
        menuClose: document.getElementById('menu-close'),
        mobileMenu: document.getElementById('mobile-menu'),
        headerInner: document.querySelector('.header-inner'),
        mainContent: document.getElementById('main-content'),
        siteFooter: document.querySelector('.site-footer'),
      };
    }

    function openMenu() {
      var els = getElements();
      if (!els.mobileMenu || !els.menuToggle) return;
      els.mobileMenu.classList.add('is-open');
      els.mobileMenu.setAttribute('aria-hidden', 'false');
      els.menuToggle.setAttribute('aria-expanded', 'true');
      if (els.headerInner) els.headerInner.setAttribute('inert', '');
      if (els.mainContent) els.mainContent.setAttribute('inert', '');
      if (els.siteFooter) els.siteFooter.setAttribute('inert', '');
      document.body.style.overflow = 'hidden';
      if (els.menuClose) els.menuClose.focus();
    }

    function closeMenu() {
      var els = getElements();
      if (!els.mobileMenu || !els.menuToggle) return;
      els.mobileMenu.classList.remove('is-open');
      els.mobileMenu.setAttribute('aria-hidden', 'true');
      els.menuToggle.setAttribute('aria-expanded', 'false');
      if (els.headerInner) els.headerInner.removeAttribute('inert');
      if (els.mainContent) els.mainContent.removeAttribute('inert');
      if (els.siteFooter) els.siteFooter.removeAttribute('inert');
      document.body.style.overflow = '';
      els.menuToggle.focus();
    }

    if (!window.__jkHeaderBound) {
      window.__jkHeaderBound = true;

      document.addEventListener('click', function (e) {
        var target = e.target;
        if (!(target instanceof Element)) return;

        if (target.closest('#menu-toggle')) {
          openMenu();
          return;
        }

        if (target.closest('#menu-close, .mobile-nav-link, #mobile-cta-btn, #mobile-logo')) {
          closeMenu();
        }
      });

      document.addEventListener('keydown', function (e) {
        var els = getElements();
        if (!els.mobileMenu || !els.mobileMenu.classList.contains('is-open')) return;

        if (e.key === 'Escape') {
          closeMenu();
          return;
        }

        if (e.key === 'Tab') {
          var focusable = els.mobileMenu.querySelectorAll(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          if (focusable.length === 0) return;

          var firstElement = focusable[0];
          var lastElement = focusable[focusable.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === firstElement) {
              lastElement.focus();
              e.preventDefault();
            }
          } else {
            if (document.activeElement === lastElement) {
              firstElement.focus();
              e.preventDefault();
            }
          }
        }
      });

      var desktopMq = window.matchMedia('(min-width: 850px)');
      desktopMq.addEventListener('change', function (e) {
        var els = getElements();
        if (e.matches && els.mobileMenu && els.mobileMenu.classList.contains('is-open')) {
          closeMenu();
        }
      });
    }
  })();
</script>
