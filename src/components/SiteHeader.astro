---
import { siteConfig } from '../data/siteConfig';
import BrandLogo from './BrandLogo.astro';
import CloseIcon from './CloseIcon.astro';
import { asset } from '../utils/paths';

const normalizedPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isItemActive = (itemHref?: string) => {
  if (!itemHref || !itemHref.startsWith('/') || itemHref.startsWith('/#')) return false;
  const resolved = asset(itemHref).replace(/\/+$/, '') || '/';
  return normalizedPath === resolved;
};
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <!-- Brand Logo aligned to left margin -->
    <a href={asset('/')} class="logo-link" aria-label="Janelle Koenig Home">
      <BrandLogo variant="dark" />
    </a>

    <!-- Desktop Navigation centred across available space -->
    <nav class="nav-desktop" aria-label="Main Navigation">
      <ul class="nav-list">
        {
          siteConfig.navItems.map((item) => {
            if (item.action === 'booking') {
              return (
                <li>
                  <button
                    type="button"
                    class="nav-link nav-link-btn"
                    data-booking-trigger
                    aria-haspopup="dialog"
                  >
                    {item.label}
                  </button>
                </li>
              );
            }
            const itemHref = item.href || '/';
            const isActive = isItemActive(itemHref);
            const href = itemHref.startsWith('/') ? asset(itemHref) : itemHref;
            return (
              <li>
                <a
                  href={href}
                  class:list={['nav-link', { 'is-active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <!-- Header CTA button aligned to right margin -->
    <div class="header-action">
      <button
        type="button"
        class="btn btn-secondary header-cta"
        data-booking-trigger
        aria-haspopup="dialog"
      >
        BOOK JANELLE
      </button>
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-drawer"
    >
      <svg class="hamburger-icon" width="24" height="18" viewBox="0 0 24 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <line x1="2" y1="2" x2="22" y2="2" />
        <line x1="2" y1="9" x2="22" y2="9" />
        <line x1="2" y1="16" x2="22" y2="16" />
      </svg>
    </button>
  </div>
</header>

<!-- Swipeable Top-Layer Mobile Navigation Drawer -->
<dialog
  class="nav-drawer"
  id="mobile-drawer"
  aria-label="Mobile navigation drawer"
>
  <div class="drawer-scroller">
    <nav class="drawer-sheet" aria-label="Mobile Navigation">
      <div class="drawer-header">
        <a href={asset('/')} class="logo-link drawer-logo-link" aria-label="Janelle Koenig Home">
          <BrandLogo variant="dark" loading="eager" />
        </a>
        <button
          type="button"
          class="menu-close"
          id="menu-close"
          aria-label="Close navigation menu"
          autofocus
        >
          <CloseIcon size={24} />
        </button>
      </div>

      <ul class="mobile-nav-list">
        {
          siteConfig.navItems.map((item) => {
            if (item.action === 'booking') {
              return (
                <li>
                  <button
                    type="button"
                    class="mobile-nav-link nav-link-btn"
                    data-booking-trigger
                    aria-haspopup="dialog"
                  >
                    {item.label}
                  </button>
                </li>
              );
            }
            const itemHref = item.href || '/';
            const isActive = isItemActive(itemHref);
            const href = itemHref.startsWith('/') ? asset(itemHref) : itemHref;
            return (
              <li>
                <a
                  href={href}
                  class:list={['mobile-nav-link', { 'is-active': isActive }]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="drawer-footer">
        <a href={asset('/#shows')} class="btn btn-primary mobile-btn" id="mobile-cta-btn">
          SEE JANELLE LIVE
        </a>
        <button
          type="button"
          class="btn btn-secondary mobile-btn"
          data-booking-trigger
          id="drawer-booking-btn"
        >
          BOOK JANELLE
        </button>
      </div>
    </nav>
  </div>
</dialog>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background-color: rgba(251, 248, 244, 0);
    border-bottom: 1px solid transparent;
    padding-block: 0.95rem 0.65rem;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      padding var(--motion-fast) var(--ease-out),
      box-shadow var(--motion-fast) var(--ease-out);
  }

  .site-header.is-scrolled {
    background-color: rgba(251, 248, 244, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom-color: var(--colour-border);
    padding-block: 0.4rem 0.4rem;
    box-shadow: 0 4px 20px rgba(18, 18, 18, 0.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports ((animation-timeline: scroll()) and (animation-range: 0% 100%)) {
      @keyframes header-compact {
        from {
          background-color: rgba(251, 248, 244, 0);
          border-bottom-color: transparent;
          padding-block: 0.95rem 0.65rem;
          box-shadow: 0 0 0 rgba(18, 18, 18, 0);
        }
        to {
          background-color: rgba(251, 248, 244, 0.95);
          border-bottom-color: var(--colour-border);
          padding-block: 0.4rem 0.4rem;
          box-shadow: 0 4px 20px rgba(18, 18, 18, 0.06);
        }
      }

      .site-header {
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        animation: header-compact linear both;
        animation-timeline: scroll(block root);
        animation-range: 0px 120px;
      }
    }
  }

  @media (max-width: 600px) {
    .site-header {
      padding-block: 0.65rem 0.45rem;
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    line-height: 1;
    z-index: 2;
  }

  /* Desktop Nav Centered */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 850px) {
    .nav-desktop {
      display: flex;
      align-items: center;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--colour-ink);
    text-transform: uppercase;
    position: relative;
    padding: var(--space-1) 0;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--colour-primary);
    transition: width var(--motion-fast) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--colour-primary);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  .nav-link-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding-inline: 0;
    text-align: left;
  }

  .mobile-nav-link.nav-link-btn {
    padding: 0;
  }

  /* Header CTA Aligned to Right */
  .header-action {
    display: none;
    z-index: 2;
  }

  @media (min-width: 850px) {
    .header-action {
      display: block;
    }
  }

  .header-cta {
    padding: 0.55rem 1.15rem;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
  }

  /* Mobile Toggle Button */
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--colour-ink);
    position: relative;
    z-index: 2;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .menu-toggle:hover {
    color: var(--colour-primary);
  }

  .hamburger-icon {
    display: block;
    pointer-events: none;
  }

  @media (min-width: 850px) {
    .menu-toggle {
      display: none;
    }
  }

  /* ==========================================================================
     Swipeable Top-Layer Mobile Navigation Drawer (navigation-drawer guide)
     ========================================================================== */
  .nav-drawer {
    --drawer-width: min(21rem, 82dvw, 100dvw - 24px);
    --drawer-backdrop: 0;

    inset: 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
    overflow: visible;
  }

  .nav-drawer::backdrop {
    background-color: #0a0a0a;
    opacity: calc(var(--drawer-backdrop) * 0.65);
    overflow: hidden;
    overscroll-behavior: contain;
  }

  .drawer-scroller {
    position: relative;
    display: grid;
    grid-template-columns: var(--drawer-width) 100%;
    overflow-x: scroll;
    overscroll-behavior: none;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
  }

  .drawer-scroller::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer-scroller {
      scroll-behavior: smooth;
    }
  }

  .drawer-scroller::after {
    content: '';
    scroll-snap-align: end;
    scroll-initial-target: nearest;
  }

  .drawer-sheet {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100svh;
    background-color: var(--colour-page);
    color: var(--colour-ink);
    border-right: 1px solid var(--colour-border);
    box-shadow: 12px 0 36px rgba(0, 0, 0, 0.18);
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-snap-align: start;
    scrollbar-width: none;
    padding: var(--space-4) var(--space-5) max(var(--space-6), env(safe-area-inset-bottom));
    gap: var(--space-6);
  }

  .drawer-sheet::-webkit-scrollbar {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    .nav-drawer {
      timeline-scope: --drawer-fade;
      animation: fade-drawer-backdrop linear both;
      animation-timeline: --drawer-fade;
    }

    .drawer-scroller {
      scroll-timeline: --drawer-fade x;
    }

    @property --drawer-backdrop {
      syntax: '<number>';
      inherits: true;
      initial-value: 0;
    }

    @keyframes fade-drawer-backdrop {
      0% {
        --drawer-backdrop: 1;
      }
      100% {
        --drawer-backdrop: 0;
      }
    }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--colour-border);
  }

  .menu-close {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: var(--radius-xs);
    cursor: pointer;
    color: var(--colour-ink);
    transition: background-color var(--motion-fast) var(--ease-out), color var(--motion-fast) var(--ease-out);
  }

  .menu-close:hover {
    background-color: rgba(158, 27, 50, 0.08);
    color: var(--colour-primary);
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mobile-nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--colour-ink);
    letter-spacing: -0.015em;
    text-transform: uppercase;
    transition: color var(--motion-fast) var(--ease-out), transform var(--motion-fast) var(--ease-out);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: var(--colour-primary);
  }

  .mobile-nav-link.is-active {
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 2.5px;
  }

  .drawer-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--colour-border);
  }

  .mobile-btn {
    width: 100%;
    padding: 0.8rem 1rem;
    font-size: 0.8125rem;
  }
</style>

<script>
  // Header compact scroll fallback for browsers without scroll-timeline support
  const headerEl = document.getElementById('site-header');
  if (
    headerEl &&
    !CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)')
  ) {
    const syncHeaderScroll = () => {
      headerEl.classList.toggle('is-scrolled', window.scrollY > 24);
    };
    window.addEventListener('scroll', syncHeaderScroll, { passive: true });
    syncHeaderScroll();
  }

  // Swipeable Top-Layer Mobile Navigation Drawer
  const drawer = document.getElementById('mobile-drawer') as HTMLDialogElement | null;
  const openBtn = document.getElementById('menu-toggle');
  const closeBtn = document.getElementById('menu-close');
  const scroller = drawer?.querySelector<HTMLElement>('.drawer-scroller') ?? null;
  const sheet = drawer?.querySelector<HTMLElement>('.drawer-sheet') ?? null;

  if (drawer && openBtn && scroller && sheet) {
    let sheetEntered = false;

    if (!CSS.supports('animation-timeline: scroll()')) {
      scroller.addEventListener(
        'scroll',
        () => {
          const width = sheet.offsetWidth || 1;
          const ratio = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / width));
          drawer.style.setProperty('--drawer-backdrop', String(ratio));
        },
        { passive: true }
      );
    }

    async function openDrawer() {
      if (!drawer || !scroller) return;
      sheetEntered = false;
      drawer.showModal();

      if (!CSS.supports('scroll-initial-target', 'nearest')) {
        scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'instant' as ScrollBehavior });
        await new Promise<void>((resolve) =>
          requestAnimationFrame(() => requestAnimationFrame(() => resolve()))
        );
      }

      scroller.scrollTo({ left: 0, behavior: 'auto' });
    }

    function closeDrawer(instant = false) {
      if (!drawer || !scroller || !drawer.open) return;
      if (instant || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        sheetEntered = false;
        drawer.close();
        openBtn?.setAttribute('aria-expanded', 'false');
        return;
      }
      scroller.scrollTo({ left: scroller.offsetWidth, behavior: 'auto' });
    }

    function onDrawerOpened() {
      sheetEntered = true;
      openBtn?.setAttribute('aria-expanded', 'true');
    }

    function onDrawerClosed() {
      if (!drawer?.open || !sheetEntered) return;
      sheetEntered = false;
      drawer.close();
      openBtn?.setAttribute('aria-expanded', 'false');
    }

    const visibleThreshold = Math.min(0.1, 1 / Math.max(window.innerWidth, 320));
    const observer = new IntersectionObserver(
      (entries) => {
        const entry = entries.at(-1);
        if (!entry || !drawer.open) return;
        if (entry.intersectionRatio >= visibleThreshold && !sheetEntered) {
          sheetEntered = true;
        }
        if (entry.intersectionRatio === 1) {
          onDrawerOpened();
        } else if (entry.intersectionRatio < visibleThreshold && sheetEntered) {
          onDrawerClosed();
        }
      },
      { root: drawer, threshold: [visibleThreshold, 1] }
    );
    observer.observe(sheet);

    openBtn.addEventListener('click', () => void openDrawer());
    closeBtn?.addEventListener('click', () => closeDrawer());

    // Light-dismiss: tapping dimmed area outside sheet slides drawer closed
    drawer.addEventListener('click', (event) => {
      if (event.target instanceof Node && !sheet.contains(event.target)) {
        closeDrawer();
      }
    });

    // Close drawer cleanly when navigating or triggering booking modal inside drawer
    sheet.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.mobile-nav-link, #mobile-cta-btn, .drawer-logo-link, #drawer-booking-btn')) {
        closeDrawer(true);
      }
    });

    // Escape key fires cancel on modal dialog; intercept to animate slide-out
    drawer.addEventListener('cancel', (event) => {
      if (event.cancelable) {
        event.preventDefault();
        closeDrawer();
      }
    });

    const desktopMq = window.matchMedia('(min-width: 850px)');
    desktopMq.addEventListener('change', (e) => {
      if (e.matches && drawer.open) {
        closeDrawer(true);
      }
    });
  }
</script>
