---
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import logoDarkImg from '../assets/logos/janelle-koenig-logo.png';
import logoLightImg from '../assets/logos/janelle-koenig-logo-white.png';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { variant = 'dark', class: className = '', loading = 'eager' } = Astro.props;
const logoSources = await createResponsiveSourceSet(
  variant === 'light' ? logoLightImg : logoDarkImg,
  [125, 250],
  'png'
);
---

<div class={`brand-logo-container ${className}`}>
  <picture style="display: contents;">
    <source
      type="image/avif"
      srcset={logoSources.avifSrcset}
      sizes="(max-width: 480px) 105px, 125px"
    />
    <source
      type="image/webp"
      srcset={logoSources.webpSrcset}
      sizes="(max-width: 480px) 105px, 125px"
    />
    <img
      src={logoSources.fallbackSrc}
      srcset={logoSources.fallbackSrcset}
      sizes="(max-width: 480px) 105px, 125px"
      alt="Janelle Koenig"
      width={logoSources.width}
      height={logoSources.height}
      class="brand-logo-img"
      loading={loading}
      decoding="async"
    />
  </picture>
</div>

<style>
  .brand-logo-container {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }

  .brand-logo-img {
    width: 125px;
    height: auto;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 480px) {
    .brand-logo-img {
      width: 105px;
    }
  }
</style>
