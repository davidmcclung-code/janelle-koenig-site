---
import events from '../data/events.json';
import EventList from './EventList.astro';
import ArrowIcon from './ArrowIcon.astro';
import type { EventItem } from '../types';
import { siteConfig } from '../data/siteConfig';
import { processEventsFromCSV, getSheetCSVUrl } from '../utils/events';

let initialEvents: EventItem[] = events as EventItem[];
const effectiveSheetUrl = getSheetCSVUrl(siteConfig.eventsSheetUrl || '');

if (effectiveSheetUrl) {
  try {
    const res = await fetch(effectiveSheetUrl, {
      signal: AbortSignal.timeout(5000),
    });
    if (res.ok) {
      const csvText = await res.text();
      const parsed = processEventsFromCSV(csvText);
      initialEvents = parsed;
    }
  } catch (err) {
    console.warn('Could not fetch Google Sheet events during build, using fallback:', err);
  }
}
---

<section class="shows-section" id="shows" aria-label="Upcoming Shows">
  <div class="container">
    <div class="shows-header scroll-reveal">
      <h2 class="font-script text-script-section shows-title">
        Book the babysitter
      </h2>

      <button
        type="button"
        class="shows-kicker-btn"
        data-booking-trigger
        aria-haspopup="dialog"
      >
        <span>Private or corporate event? Enquire</span>
        <ArrowIcon size={13} />
      </button>
    </div>

    <div class="shows-card scroll-reveal">
      <EventList events={initialEvents} sheetUrl={effectiveSheetUrl} />
    </div>
  </div>
</section>

<style>
  .shows-section {
    background-color: var(--colour-page);
    padding-block: clamp(2rem, 4.2vw, 3.25rem);
  }

  .shows-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-bottom: var(--space-4);
  }

  .shows-title {
    color: var(--colour-primary);
    transform: rotate(-1.5deg);
    display: inline-block;
    font-size: clamp(1.65rem, 1.25rem + 0.65vw, 2.05rem);
    line-height: 1.1;
  }

  .shows-kicker-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 2px;
    background: transparent;
    border: none;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--colour-ink-subtle);
    cursor: pointer;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .shows-kicker-btn:hover {
    color: var(--colour-primary);
  }

  .shows-card {
    background-color: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-md);
    padding: clamp(0.65rem, 1.5vw, 1.1rem) clamp(1rem, 1.8vw, 1.35rem);
    box-shadow: var(--shadow-sm);
  }
</style>
