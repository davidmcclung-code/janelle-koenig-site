---
import { siteConfig } from '../data/siteConfig';
---

<dialog id="booking-modal" class="booking-dialog" aria-labelledby="booking-modal-title" aria-modal="true">
  <div class="booking-card">
    <!-- Header -->
    <div class="booking-header">
      <div>
        <span class="font-script booking-pretitle">Need a grown-up?</span>
        <h3 id="booking-modal-title" class="booking-title">Book Janelle</h3>
      </div>
      <button type="button" class="booking-close-btn" id="booking-modal-close" aria-label="Close booking modal">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Body / Form -->
    <div class="booking-body">
      <p class="booking-intro wrap-break">
        Tell Janelle what you're planning, who's in the room and how much trouble she's allowed to get into.
      </p>

      <form id="booking-form" class="booking-form" action={`mailto:${siteConfig.email}`} method="POST" enctype="text/plain">
        <div class="form-grid">
          <!-- Name -->
          <div class="form-group">
            <label for="booking-name" class="form-label">Your Name <span class="required-star" aria-hidden="true">*</span></label>
            <input
              type="text"
              id="booking-name"
              name="name"
              required
              maxlength="100"
              autocomplete="name"
              class="form-input"
              placeholder="e.g. Sarah Mitchell"
            />
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="booking-email" class="form-label">Email Address <span class="required-star" aria-hidden="true">*</span></label>
            <input
              type="email"
              id="booking-email"
              name="email"
              required
              maxlength="120"
              autocomplete="email"
              class="form-input"
              placeholder="sarah@example.com"
            />
          </div>

          <!-- Organisation -->
          <div class="form-group">
            <label for="booking-org" class="form-label">Organisation / Agency <span class="optional-tag">(optional)</span></label>
            <input
              type="text"
              id="booking-org"
              name="organisation"
              maxlength="120"
              autocomplete="organization"
              class="form-input"
              placeholder="Company or Event Name"
            />
          </div>

          <!-- Service Type -->
          <div class="form-group">
            <label for="booking-type" class="form-label">Booking Type</label>
            <select id="booking-type" name="type" class="form-select">
              <option value="mc">Professional MC</option>
              <option value="panel">Panel Host / Facilitator</option>
              <option value="comedy">Stand-up Comedy</option>
              <option value="other">Other / Custom</option>
            </select>
          </div>

          <!-- Date & Location -->
          <div class="form-group">
            <label for="booking-date" class="form-label">Event Date <span class="optional-tag">(optional)</span></label>
            <input type="date" id="booking-date" name="date" class="form-input" />
          </div>

          <div class="form-group">
            <label for="booking-location" class="form-label">Location / City <span class="optional-tag">(optional)</span></label>
            <input
              type="text"
              id="booking-location"
              name="location"
              maxlength="100"
              autocomplete="address-level2"
              class="form-input"
              placeholder="e.g. Perth, Melbourne"
            />
          </div>

          <!-- Message -->
          <div class="form-group full-width">
            <label for="booking-message" class="form-label">Event Details & Brief <span class="required-star" aria-hidden="true">*</span></label>
            <textarea
              id="booking-message"
              name="message"
              rows="4"
              required
              maxlength="2500"
              class="form-textarea"
              placeholder="Tell us about the audience, timing, and what you need from Janelle..."
            ></textarea>
          </div>
        </div>

        <!-- Form Submission Footer -->
        <div class="form-footer">
          <button type="submit" id="booking-submit-btn" class="btn btn-primary form-submit-btn">
            SEND ENQUIRY
          </button>
          <div class="direct-contact-container">
            <p class="direct-contact-note wrap-break">
              Prefer direct email? Reach Janelle at <a href={`mailto:${siteConfig.email}`} class="direct-link">{siteConfig.email}</a>
              <button
                type="button"
                class="modal-copy-btn"
                data-copy-email={siteConfig.email}
                aria-label="Copy email address"
                title="Copy email to clipboard"
              >
                <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </p>
            <span class="modal-copy-toast" role="status" aria-live="polite">
              Copied! (Zero small talk required)
            </span>
          </div>
        </div>
      </form>
    </div>
  </div>
</dialog>

<style>
  .booking-dialog {
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    background: transparent;
    max-width: 680px;
    width: calc(100% - 2rem);
    margin: auto;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
  }

  .booking-dialog[open] {
    animation: modalScaleIn 260ms var(--ease-out) forwards;
  }

  .booking-dialog::backdrop {
    background-color: rgba(10, 10, 10, 0.75);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  @keyframes modalScaleIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .booking-dialog[open] {
      animation: none !important;
    }
  }

  .booking-card {
    background-color: var(--colour-page);
    color: var(--colour-ink);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--colour-border);
  }

  .booking-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--space-6) var(--space-7) var(--space-4);
    border-bottom: 1px solid var(--colour-border);
  }

  .booking-pretitle {
    font-size: 1.5rem;
    color: var(--colour-primary);
    display: block;
    margin-bottom: -4px;
  }

  .booking-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    color: var(--colour-ink);
    margin: 0;
  }

  .booking-close-btn {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.06);
    color: var(--colour-ink);
    border: none;
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  .booking-close-btn:hover {
    background-color: var(--colour-primary);
    color: #ffffff;
  }

  .booking-body {
    padding: var(--space-6) var(--space-7);
    max-height: 80vh;
    overflow-y: auto;
  }

  .booking-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: var(--lh-snug);
    color: var(--colour-ink-subtle);
    margin-bottom: var(--space-6);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 540px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }

    .full-width {
      grid-column: span 2;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .form-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--colour-ink);
    letter-spacing: 0.02em;
  }

  .required-star {
    color: var(--colour-primary);
  }

  .optional-tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--colour-muted);
    font-weight: 400;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background-color: #ffffff;
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--colour-ink);
    transition: border-color var(--motion-fast) var(--ease-out),
                box-shadow var(--motion-fast) var(--ease-out);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--colour-primary);
    box-shadow: 0 0 0 3px var(--colour-primary-light);
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .form-submit-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
  }

  .direct-contact-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .direct-contact-note {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--colour-muted);
    text-align: center;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin: 0;
  }

  .direct-link {
    color: var(--colour-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .modal-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    min-width: 20px;
    padding: 0;
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-xs);
    color: var(--colour-ink);
    cursor: pointer;
    margin-left: 2px;
    transition: background-color var(--motion-fast) var(--ease-out),
                border-color var(--motion-fast) var(--ease-out),
                color var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out);
  }

  .modal-copy-btn:hover {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .modal-copy-btn .copy-icon {
    display: block;
  }

  .modal-copy-btn .check-icon {
    display: none;
  }

  .modal-copy-btn.is-copied {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
  }

  .modal-copy-btn.is-copied .copy-icon {
    display: none;
  }

  .modal-copy-btn.is-copied .check-icon {
    display: block;
  }

  .modal-copy-toast {
    display: none;
    position: absolute;
    bottom: calc(100% + 6px);
    background-color: var(--colour-ink);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    padding: 5px 9px;
    border-radius: var(--radius-xs);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
    pointer-events: none;
    z-index: 50;
  }

  .modal-copy-toast.is-visible {
    display: block;
    animation: toastFadeIn 200ms var(--ease-out) forwards;
  }

  @keyframes toastFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-copy-toast.is-visible {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const bookingModal = document.getElementById('booking-modal') as HTMLDialogElement | null;
  const bookingCloseBtn = document.getElementById('booking-modal-close');
  const bookingTriggers = document.querySelectorAll('[data-booking-trigger]');
  const bookingForm = document.getElementById('booking-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('booking-submit-btn') as HTMLButtonElement | null;

  let lastActiveElement: HTMLElement | null = null;
  let isBackdropMousedown = false;

  function openBookingModal(e?: Event) {
    if (e) {
      e.preventDefault();
    }
    if (e?.currentTarget instanceof HTMLElement) {
      lastActiveElement = e.currentTarget;
    }
    if (bookingModal && typeof bookingModal.showModal === 'function') {
      bookingModal.showModal();
      // Focus first input smoothly after modal renders
      requestAnimationFrame(() => {
        const firstInput = bookingModal.querySelector<HTMLElement>('input, button, select, textarea');
        firstInput?.focus();
      });
    }
  }

  function closeBookingModal() {
    if (bookingModal && typeof bookingModal.close === 'function') {
      bookingModal.close();
      lastActiveElement?.focus();
    }
  }

  bookingTriggers.forEach((trigger) => {
    trigger.addEventListener('click', openBookingModal);
  });

  bookingCloseBtn?.addEventListener('click', closeBookingModal);

  // Safe backdrop click handling (prevents inadvertent close on text selection drag)
  bookingModal?.addEventListener('mousedown', (e) => {
    isBackdropMousedown = e.target === bookingModal;
  });

  bookingModal?.addEventListener('mouseup', (e) => {
    if (isBackdropMousedown && e.target === bookingModal) {
      closeBookingModal();
    }
    isBackdropMousedown = false;
  });

  bookingModal?.addEventListener('close', () => {
    lastActiveElement?.focus();
  });

  // Focus trapping within modal
  bookingModal?.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      const focusable = bookingModal.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;

      const firstElement = focusable[0];
      const lastElement = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          lastElement.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === lastElement) {
          firstElement.focus();
          e.preventDefault();
        }
      }
    }
  });

  // Double submit prevention
  bookingForm?.addEventListener('submit', () => {
    if (submitBtn) {
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'OPENING EMAIL CLIENT...';
      setTimeout(() => {
        submitBtn.removeAttribute('disabled');
        submitBtn.textContent = 'SEND ENQUIRY';
        closeBookingModal();
      }, 1500);
    }
  });

  // Modal Copy Email
  const modalCopyBtn = document.querySelector<HTMLButtonElement>('.modal-copy-btn[data-copy-email]');
  modalCopyBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    const text = modalCopyBtn.getAttribute('data-copy-email') || '';
    if (!text) return;

    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
      }

      modalCopyBtn.classList.add('is-copied');
      const toast = modalCopyBtn.closest('.direct-contact-container')?.querySelector('.modal-copy-toast');
      if (toast) {
        toast.classList.add('is-visible');
      }

      setTimeout(() => {
        modalCopyBtn.classList.remove('is-copied');
        if (toast) {
          toast.classList.remove('is-visible');
        }
      }, 2400);
    } catch (err) {
      console.error('Failed to copy email in modal:', err);
    }
  });
</script>
