---
import { siteConfig } from '../data/siteConfig';
import CloseIcon from './CloseIcon.astro';
---

<dialog id="booking-modal" class="booking-dialog" aria-labelledby="booking-modal-title" closedby="any">
  <div class="booking-card">
    <!-- Header -->
    <div class="booking-header">
      <div>
        <span class="font-script booking-pretitle">Need someone to work the room?</span>
        <h2 id="booking-modal-title" class="booking-title">Book Janelle</h2>
      </div>
      <button type="button" class="booking-close-btn" id="booking-modal-close" aria-label="Close booking modal">
        <CloseIcon size={22} />
      </button>
    </div>

    <!-- Body / Form -->
    <div class="booking-body">
      <p class="booking-intro wrap-break">
        Tell Janelle what you're planning, who's in the room and how much trouble she's allowed to get into.
      </p>

      <form id="booking-form" class="booking-form" data-email={siteConfig.email} novalidate>
        <div class="form-grid">
          <!-- Name -->
          <div class="form-group">
            <label for="booking-name" class="form-label">Your Name <span class="required-star" aria-hidden="true">*</span></label>
            <input
              type="text"
              id="booking-name"
              name="name"
              required
              maxlength="100"
              autocomplete="name"
              aria-describedby="booking-name-error"
              class="form-input"
              placeholder="e.g. Sarah Mitchell"
            />
            <span id="booking-name-error" class="form-error" role="status" aria-live="polite" hidden></span>
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="booking-email" class="form-label">Email Address <span class="required-star" aria-hidden="true">*</span></label>
            <input
              type="email"
              id="booking-email"
              name="email"
              required
              maxlength="120"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="none"
              spellcheck="false"
              aria-describedby="booking-email-error"
              class="form-input"
              placeholder="sarah@example.com"
            />
            <span id="booking-email-error" class="form-error" role="status" aria-live="polite" hidden></span>
          </div>

          <!-- Organisation -->
          <div class="form-group">
            <label for="booking-org" class="form-label">Organisation / Agency <span class="optional-tag">(optional)</span></label>
            <input
              type="text"
              id="booking-org"
              name="organisation"
              maxlength="120"
              autocomplete="organization"
              class="form-input"
              placeholder="Company or Event Name"
            />
          </div>

          <!-- Service Type -->
          <div class="form-group">
            <label for="booking-type" class="form-label">Booking Type</label>
            <select id="booking-type" name="type" class="form-select">
              <option value="mc">Professional MC</option>
              <option value="panel">Panel Host / Facilitator</option>
              <option value="comedy">Stand-up Comedy</option>
              <option value="brand">Brand Partnership / Ambassador</option>
              <option value="other">Other / Custom</option>
            </select>
          </div>

          <!-- Date & Location -->
          <div class="form-group">
            <label for="booking-date" class="form-label">Event Date <span class="optional-tag">(optional)</span></label>
            <input type="date" id="booking-date" name="date" class="form-input" />
          </div>

          <div class="form-group">
            <label for="booking-location" class="form-label">Location / City <span class="optional-tag">(optional)</span></label>
            <input
              type="text"
              id="booking-location"
              name="location"
              maxlength="100"
              autocomplete="address-level2"
              class="form-input"
              placeholder="e.g. Perth, Melbourne"
            />
          </div>

          <!-- Message -->
          <div class="form-group full-width">
            <label for="booking-message" class="form-label">Event Details & Brief <span class="required-star" aria-hidden="true">*</span></label>
            <textarea
              id="booking-message"
              name="message"
              rows="4"
              required
              maxlength="2500"
              aria-describedby="booking-message-error"
              class="form-textarea"
              placeholder="Tell us about the audience, timing, and what you need from Janelle..."
            ></textarea>
            <span id="booking-message-error" class="form-error" role="status" aria-live="polite" hidden></span>
          </div>
        </div>

        <!-- Form Submission Footer -->
        <div class="form-footer">
          <button type="submit" id="booking-submit-btn" class="btn btn-primary form-submit-btn">
            SEND ENQUIRY
          </button>
          <div id="booking-status" class="booking-status" role="status" aria-live="polite" hidden></div>
          <div class="direct-contact-container">
            <p class="direct-contact-note wrap-break">
              Prefer direct email? Reach Janelle at <a href={`mailto:${siteConfig.email}`} class="direct-link">{siteConfig.email}</a>
              <button
                type="button"
                class="modal-copy-btn"
                data-copy-email={siteConfig.email}
                aria-label="Copy email address"
              >
                <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </p>
            <span class="modal-copy-toast" role="status" aria-live="polite">
              Copied! (Zero small talk required)
            </span>
          </div>
        </div>
      </form>
    </div>
  </div>
</dialog>

<style>
  .booking-dialog {
    padding: 0;
    border: none;
    border-radius: var(--radius-lg);
    background: transparent;
    max-width: 680px;
    width: calc(100% - 1.5rem);
    max-height: calc(100vh - 1.5rem);
    max-height: calc(100dvh - 1.5rem);
    margin: auto;
    overflow: hidden;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.35);
  }

  .booking-dialog[open] {
    display: flex;
    flex-direction: column;
    animation: modalScaleIn 260ms var(--ease-out) forwards;
  }

  .booking-dialog::backdrop {
    background-color: rgba(10, 10, 10, 0.75);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
  }

  @keyframes modalScaleIn {
    from {
      opacity: 0;
      transform: scale(0.96) translateY(8px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .booking-dialog[open] {
      animation: none !important;
    }
  }

  .booking-card {
    contain: layout style paint;
    background-color: var(--colour-page);
    color: var(--colour-ink);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 100%;
    min-height: 0;
    border: 1px solid var(--colour-border);
  }

  .booking-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-shrink: 0;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.15rem, 3vw, 2.25rem) var(--space-4);
    border-bottom: 1px solid var(--colour-border);
  }

  .booking-pretitle {
    font-size: 1.5rem;
    color: var(--colour-primary);
    display: block;
    margin-bottom: -4px;
  }

  .booking-title {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    color: var(--colour-ink);
    margin: 0;
  }

  .booking-close-btn {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.06);
    color: var(--colour-ink);
    border: none;
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-out);
  }

  .booking-close-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 44px;
    min-height: 44px;
  }

  .booking-close-btn:hover {
    background-color: var(--colour-primary);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: no-preference) {
    .booking-close-btn:active {
      transform: scale(0.94);
    }
  }

  .booking-body {
    flex: 1 1 auto;
    min-height: 0;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.15rem, 3vw, 2.25rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .booking-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: var(--lh-snug);
    color: var(--colour-ink-subtle);
    margin-bottom: var(--space-6);
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 620px) {
    .form-grid {
      grid-template-columns: 1fr 1fr;
    }

    .full-width {
      grid-column: span 2;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .form-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--colour-ink);
    letter-spacing: 0.02em;
  }

  .required-star {
    color: var(--colour-primary);
  }

  .optional-tag {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--colour-muted);
    font-weight: 400;
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background-color: var(--colour-surface);
    border: 1px solid var(--colour-border-input);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--colour-ink);
    transition: border-color var(--motion-fast) var(--ease-out),
                box-shadow var(--motion-fast) var(--ease-out);
  }

  :where(.form-input, .form-select, .form-textarea):focus-visible {
    outline: 2.5px solid var(--colour-focus);
    outline-offset: 1px;
    border-color: var(--colour-primary);
  }

  :where(.form-input, .form-textarea)[aria-invalid="true"] {
    border-color: var(--colour-error);
  }

  .form-error {
    color: var(--colour-error);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.35;
    margin-top: 2px;
  }

  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }

  .booking-status {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background-color: var(--colour-surface-alt);
    border: 1px solid var(--colour-border);
    color: var(--colour-ink);
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .form-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .form-submit-btn {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
  }

  .direct-contact-container {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .direct-contact-note {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--colour-muted);
    text-align: center;
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 0;
  }

  .direct-link {
    color: var(--colour-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .modal-copy-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    min-width: 20px;
    padding: 0;
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius-xs);
    color: var(--colour-ink);
    cursor: pointer;
    margin-left: 2px;
    transition: background-color var(--motion-fast) var(--ease-out),
                border-color var(--motion-fast) var(--ease-out),
                color var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out);
  }

  .modal-copy-btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 44px;
    min-height: 44px;
  }

  .modal-copy-btn:hover {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .modal-copy-btn .copy-icon {
    display: block;
  }

  .modal-copy-btn .check-icon {
    display: none;
  }

  .modal-copy-btn.is-copied {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
  }

  .modal-copy-btn.is-copied .copy-icon {
    display: none;
  }

  .modal-copy-btn.is-copied .check-icon {
    display: block;
  }

  .modal-copy-toast {
    display: none;
    position: absolute;
    bottom: calc(100% + 6px);
    background-color: var(--colour-ink);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    padding: 5px 9px;
    border-radius: var(--radius-xs);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
    pointer-events: none;
    z-index: 50;
  }

  .modal-copy-toast.is-visible {
    display: block;
    animation: toastFadeIn 200ms var(--ease-out) forwards;
  }

  @keyframes toastFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-copy-toast.is-visible {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  const bookingModal = document.getElementById('booking-modal') as HTMLDialogElement | null;
  const bookingCloseBtn = document.getElementById('booking-modal-close');
  const bookingForm = document.getElementById('booking-form') as HTMLFormElement | null;
  const bookingStatus = document.getElementById('booking-status');

  const nameInput = document.getElementById('booking-name') as HTMLInputElement | null;
  const emailInput = document.getElementById('booking-email') as HTMLInputElement | null;
  const orgInput = document.getElementById('booking-org') as HTMLInputElement | null;
  const typeSelect = document.getElementById('booking-type') as HTMLSelectElement | null;
  const dateInput = document.getElementById('booking-date') as HTMLInputElement | null;
  const locationInput = document.getElementById('booking-location') as HTMLInputElement | null;
  const messageInput = document.getElementById('booking-message') as HTMLTextAreaElement | null;

  type ValidatedField = HTMLInputElement | HTMLTextAreaElement;

  const fieldConfigs: Array<{
    input: ValidatedField | null;
    errorId: string;
    validate: (el: ValidatedField) => string;
  }> = [
    {
      input: nameInput,
      errorId: 'booking-name-error',
      validate: (el) => (el.value.trim().length > 0 ? '' : 'Please enter your name.'),
    },
    {
      input: emailInput,
      errorId: 'booking-email-error',
      validate: (el) => {
        const val = el.value.trim();
        if (!val) return 'Please enter a valid email address.';
        return el.checkValidity() ? '' : 'Please enter a valid email address.';
      },
    },
    {
      input: messageInput,
      errorId: 'booking-message-error',
      validate: (el) =>
        el.value.trim().length > 0 ? '' : 'Please share a few details about your event.',
    },
  ];

  const editedFields = new WeakSet<HTMLElement>();
  let isBackdropMousedown = false;

  function setFieldError(input: ValidatedField, errorId: string, message: string) {
    const errorEl = document.getElementById(errorId);
    if (message) {
      input.setAttribute('aria-invalid', 'true');
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.hidden = false;
      }
    } else {
      input.removeAttribute('aria-invalid');
      if (errorEl) {
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
    }
  }

  fieldConfigs.forEach(({ input, errorId, validate }) => {
    if (!input) return;

    input.addEventListener('input', () => {
      editedFields.add(input);
      if (input.getAttribute('aria-invalid') === 'true') {
        const errorMsg = validate(input);
        if (!errorMsg) {
          setFieldError(input, errorId, '');
        }
      }
    });

    input.addEventListener('blur', () => {
      if (!editedFields.has(input) && input.getAttribute('aria-invalid') !== 'true') return;
      const errorMsg = validate(input);
      setFieldError(input, errorId, errorMsg);
    });
  });

  function openBookingModal(e?: Event) {
    if (e) {
      e.preventDefault();
    }
    if (bookingModal && typeof bookingModal.showModal === 'function') {
      if (bookingStatus) {
        bookingStatus.textContent = '';
        bookingStatus.hidden = true;
      }
      bookingModal.showModal();
      // Focus first input smoothly after modal renders
      requestAnimationFrame(() => {
        const firstInput = bookingModal.querySelector<HTMLElement>('input, button, select, textarea');
        firstInput?.focus();
      });
    }
  }

  function closeBookingModal() {
    if (bookingModal && typeof bookingModal.close === 'function') {
      bookingModal.close();
    }
  }

  // Handle both statically and dynamically rendered booking triggers
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement)?.closest?.('[data-booking-trigger]');
    if (trigger) {
      openBookingModal(e);
    }
  });

  bookingCloseBtn?.addEventListener('click', closeBookingModal);

  // Safe backdrop click handling (prevents inadvertent close on text selection drag)
  bookingModal?.addEventListener('mousedown', (e) => {
    isBackdropMousedown = e.target === bookingModal;
  });

  bookingModal?.addEventListener('mouseup', (e) => {
    if (isBackdropMousedown && e.target === bookingModal) {
      closeBookingModal();
    }
    isBackdropMousedown = false;
  });

  // Validation and mailto handoff without clearing entered data
  bookingForm?.addEventListener('submit', (e) => {
    e.preventDefault();

    let firstInvalid: ValidatedField | null = null;

    fieldConfigs.forEach(({ input, errorId, validate }) => {
      if (!input) return;
      editedFields.add(input);
      const errorMsg = validate(input);
      setFieldError(input, errorId, errorMsg);
      if (errorMsg && !firstInvalid) {
        firstInvalid = input;
      }
    });

    if (firstInvalid) {
      (firstInvalid as ValidatedField).focus();
      return;
    }

    const recipient = bookingForm.dataset.email || 'hello@janellekoenig.com';
    const nameVal = nameInput?.value.trim() || '';
    const emailVal = emailInput?.value.trim() || '';
    const orgVal = orgInput?.value.trim() || '';
    const typeLabel = typeSelect?.options[typeSelect.selectedIndex]?.text || typeSelect?.value || '';
    const dateVal = dateInput?.value.trim() || '';
    const locationVal = locationInput?.value.trim() || '';
    const messageVal = messageInput?.value.trim() || '';

    const subject = `Booking Enquiry: ${typeLabel} (${nameVal})`;
    const bodyLines = [
      `Name: ${nameVal}`,
      `Email: ${emailVal}`,
      orgVal ? `Organisation / Agency: ${orgVal}` : '',
      `Booking Type: ${typeLabel}`,
      dateVal ? `Event Date: ${dateVal}` : '',
      locationVal ? `Location / City: ${locationVal}` : '',
      '',
      'Event Details & Brief:',
      messageVal,
    ].filter((line, idx, arr) => line !== '' || arr[idx - 1] !== '');

    const mailtoUrl = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join('\n'))}`;

    if (bookingStatus) {
      bookingStatus.textContent = `Opening your email client with your enquiry pre-filled. If nothing opens, copy your enquiry or email ${recipient} directly.`;
      bookingStatus.hidden = false;
    }

    window.location.href = mailtoUrl;
  });

  // Modal Copy Email
  const modalCopyBtn = document.querySelector<HTMLButtonElement>('.modal-copy-btn[data-copy-email]');
  modalCopyBtn?.addEventListener('click', async (e) => {
    e.preventDefault();
    const text = modalCopyBtn.getAttribute('data-copy-email') || '';
    if (!text) return;

    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
      } else {
        const textArea = document.createElement('textarea');
        textArea.value = text;
        textArea.style.position = 'fixed';
        textArea.style.opacity = '0';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        document.execCommand('copy');
        document.body.removeChild(textArea);
      }

      modalCopyBtn.classList.add('is-copied');
      const toast = modalCopyBtn.closest('.direct-contact-container')?.querySelector('.modal-copy-toast');
      if (toast) {
        toast.classList.add('is-visible');
      }

      setTimeout(() => {
        modalCopyBtn.classList.remove('is-copied');
        if (toast) {
          toast.classList.remove('is-visible');
        }
      }, 2400);
    } catch (err) {
      console.error('Failed to copy email in modal:', err);
    }
  });
</script>
