---
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import abcImg from '../assets/logos/abc.png';
import channel9Img from '../assets/logos/channel9.png';
import network10Img from '../assets/logos/network10.png';
import sbsImg from '../assets/logos/sbs.png';
import primevideoImg from '../assets/logos/primevideo.png';
import theprojectImg from '../assets/logos/theproject.png';
import nova937Img from '../assets/logos/nova937.png';

const rawLogos = [
  { name: 'ABC', img: abcImg, alt: 'Australian Broadcasting Corporation', width: 44, class: 'logo-abc' },
  { name: 'Channel 9', img: channel9Img, alt: 'Channel 9', width: 56, class: 'logo-nine' },
  { name: 'Network 10', img: network10Img, alt: 'Network 10', width: 34, class: 'logo-ten' },
  { name: 'SBS', img: sbsImg, alt: 'SBS Television', width: 56, class: 'logo-sbs' },
  { name: 'Prime Video', img: primevideoImg, alt: 'Amazon Prime Video', width: 78, class: 'logo-prime' },
  { name: 'The Project', img: theprojectImg, alt: 'The Project', width: 70, class: 'logo-project hide-on-mobile' },
  { name: 'Nova 93.7', img: nova937Img, alt: 'Nova 93.7', width: 72, class: 'logo-nova hide-on-mobile' },
];

const logos = await Promise.all(
  rawLogos.map(async (logo) => ({
    ...logo,
    sources: await createResponsiveSourceSet(logo.img, [logo.width, logo.width * 2], 'png'),
  }))
);
---

<section class="credibility-section" aria-label="Media Appearances and Credits">
  <div class="container">
    <div class="credibility-inner scroll-reveal">
      <div class="credibility-label-wrapper">
        <span class="font-script text-script-section credibility-label">As seen on</span>
      </div>

      <div class="logo-cloud">
        {
          logos.map((logo) => (
            <div class={`logo-item ${logo.class}`}>
              <picture style="display: contents;">
                <source
                  type="image/avif"
                  srcset={logo.sources.avifSrcset}
                  sizes={`${logo.width}px`}
                />
                <source
                  type="image/webp"
                  srcset={logo.sources.webpSrcset}
                  sizes={`${logo.width}px`}
                />
                <img
                  src={logo.sources.fallbackSrc}
                  srcset={logo.sources.fallbackSrcset}
                  sizes={`${logo.width}px`}
                  alt={logo.alt}
                  width={logo.sources.width}
                  height={logo.sources.height}
                  loading="lazy"
                  decoding="async"
                  class="media-logo-img"
                />
              </picture>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .credibility-section {
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    border-bottom: 1px solid var(--colour-border);
    background-color: var(--colour-page);
    width: 100%;
  }

  .credibility-inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: clamp(16px, 3vw, 36px);
  }

  .credibility-label-wrapper {
    flex-shrink: 0;
    padding-right: clamp(12px, 2vw, 24px);
    border-right: 1px solid var(--colour-border);
  }

  .credibility-label {
    color: var(--colour-primary);
    transform: rotate(-2deg);
    display: inline-block;
    white-space: nowrap;
    font-size: clamp(1.15rem, 0.9rem + 0.6vw, 1.5rem);
    line-height: 1;
  }

  .logo-cloud {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(8px, 2vw, 28px);
    flex: 1;
    width: auto;
  }

  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    opacity: 0.82;
    color: var(--colour-ink);
    transition:
      opacity var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .logo-item:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .media-logo-img {
    height: 18px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(100%) contrast(120%);
  }

  .logo-abc .media-logo-img { height: 22px; }
  .logo-nine .media-logo-img { height: 18px; }
  .logo-ten .media-logo-img { height: 19px; }
  .logo-sbs .media-logo-img { height: 17.5px; }
  .logo-prime .media-logo-img { height: 16.5px; }
  .logo-project .media-logo-img { height: 16.5px; }
  .logo-nova .media-logo-img { height: 20px; }

  @media (max-width: 639px) {
    .credibility-label-wrapper {
      padding-right: 0;
      border-right: none;
    }

    .hide-on-mobile {
      display: none !important;
    }
  }

  @media (max-width: 480px) {
    .credibility-inner { gap: 10px; }
    .credibility-label { font-size: 1.1rem; }
    .logo-cloud { gap: 6px; }
    .media-logo-img { height: 14px; }
    .logo-abc .media-logo-img { height: 18px; }
    .logo-nine .media-logo-img { height: 14px; }
    .logo-ten .media-logo-img { height: 15px; }
    .logo-sbs .media-logo-img { height: 14px; }
    .logo-prime .media-logo-img { height: 11px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-item:hover {
      transform: none;
    }
  }
</style>
