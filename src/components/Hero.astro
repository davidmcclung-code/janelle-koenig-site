---
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import { siteConfig } from '../data/siteConfig';
import heroPortraitImg from '../assets/photography/hero/janelle-hero.png';
import BurstMark from './BurstMark.astro';

const heroSources = await createResponsiveSourceSet(
  heroPortraitImg,
  [320, 480, 560, 682],
  'png'
);
---

<section class="hero-section" id="hero" aria-label="Hero Section">
  <div class="container hero-container">
    <!-- Hero Text Content -->
    <div class="hero-content">
      <!-- Main Display Headline (calibrated ~67px, ends ~485px from left edge) -->
      <h1 class="hero-title" aria-label={siteConfig.heroHeadline.join(' ')}>
        {siteConfig.heroHeadline.map((word) => (
          <span class="title-line">{word.replace(/\.$/, '')}<span class="red-sq" aria-hidden="true"></span></span>
        ))}
      </h1>

      <!-- Supporting Copy: 3 distinct lines, constrained to ~320px -->
      <p class="hero-subhead wrap-break">
        Comedian, creator, writer, <br />
        MC, mum, and indoorsy type.<br />
        See Janelle live around Australia.
      </p>

      <!-- Action Buttons on one horizontal line with 30px gap above -->
      <div class="hero-actions">
        <a href="#shows" class="btn btn-primary hero-btn-live">
          SEE JANELLE LIVE
        </a>
        <button type="button" class="btn btn-secondary hero-btn-watch" id="hero-watch-btn" data-video-trigger>
          <span>WATCH JANELLE</span>
          <svg class="play-circle-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
          </svg>
        </button>
      </div>
    </div>

    <!-- Red 3-Line Emphasis Mark Immediately to the Left of Janelle's Head -->
    <div class="hero-burst-mark" aria-hidden="true">
      <BurstMark animated={true} strokeWidth={2.5} />
    </div>

    <!-- Layered Large Portrait Anchored to Bottom Edge -->
    <div class="hero-media">
      <picture class="hero-portrait-picture">
        <source
          type="image/avif"
          srcset={heroSources.avifSrcset}
          sizes="(min-width: 1150px) 560px, (min-width: 850px) 49vw, 62vw"
        />
        <source
          type="image/webp"
          srcset={heroSources.webpSrcset}
          sizes="(min-width: 1150px) 560px, (min-width: 850px) 49vw, 62vw"
        />
        <img
          src={heroSources.fallbackSrc}
          srcset={heroSources.fallbackSrcset}
          sizes="(min-width: 1150px) 560px, (min-width: 850px) 49vw, 62vw"
          alt="Janelle Koenig smiling with hands on hips in denim dress"
          width={heroSources.width}
          height={heroSources.height}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-portrait-img"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: var(--gradient-hero-warm);
    overflow: hidden;
    width: 100%;
  }

  .hero-container {
    position: relative;
    min-height: clamp(540px, 44vw, 610px);
    display: flex;
    align-items: center;
  }

  /* Left Content Column - Preserving text block sizing and button sizing */
  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 480px;
    min-width: 0;
    padding-top: clamp(56px, 6vw, 84px);
    padding-bottom: clamp(2.75rem, 4.5vw, 3.75rem);
    display: flex;
    flex-direction: column;
  }

  /* Display Headline: calibrated to match reference */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.3rem + 4.5vw, 4.2rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--colour-ink);
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    width: fit-content;
  }

  .title-line {
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
  }

  /* Supporting Copy: Constrained to 320px across 3 lines */
  .hero-subhead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--colour-ink);
    font-weight: 500;
    max-width: 320px;
    margin-bottom: 30px;
  }

  /* Action Buttons on One Horizontal Line with 30px gap above */
  .hero-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-btn-live {
    min-height: 44px;
    height: auto;
    min-width: 155px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: var(--colour-primary);
    color: #ffffff;
    border-color: var(--colour-primary);
    border-radius: var(--radius-xs);
  }

  .hero-btn-watch {
    min-height: 44px;
    height: auto;
    min-width: 165px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: var(--colour-surface);
    color: var(--colour-ink);
    border: 1.5px solid var(--colour-ink);
    border-radius: var(--radius-xs);
    gap: 8px;
  }

  .hero-btn-watch:hover {
    background-color: rgba(255, 255, 255, 0.85);
  }

  .play-circle-icon {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .play-circle-icon {
      transition: transform var(--motion-fast) var(--ease-out);
    }

    .hero-btn-watch:is(:hover, :focus-visible) .play-circle-icon {
      transform: scale(1.1);
    }
  }

  /* Red 3-Line Burst Mark anchored beside Janelle's Head */
  .hero-burst-mark {
    display: block;
    position: absolute;
    right: calc(clamp(440px, 45vw, 560px) + clamp(15px, 3.5vw, 55px) - 24px);
    top: clamp(72px, 7.5vw, 98px);
    z-index: 2;
  }

  /* Oversized Dominant Hero Portrait: Scaled and anchored to bottom edge, cropped at mid-thigh */
  .hero-media {
    position: absolute;
    right: clamp(15px, 3.5vw, 55px);
    bottom: 0;
    top: auto;
    width: clamp(440px, 45vw, 560px);
    max-width: 560px;
    height: auto;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 1;
    pointer-events: none;
  }



  .hero-portrait-picture {
    display: contents;
  }

  .hero-portrait-img {
    width: 100%;
    height: auto;
    max-width: none;
    display: block;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.08));
  }

  /* Tablet Landscape & Medium Screens (850px - 1149px) */
  @media (min-width: 850px) and (max-width: 1149px) {
    .hero-container {
      min-height: clamp(500px, 51vw, 580px);
    }

    .hero-content {
      padding-top: clamp(60px, 7vw, 84px);
      padding-bottom: 2.5rem;
    }

    .hero-burst-mark {
      right: calc(clamp(460px, 49vw, 540px) + clamp(15px, 3.5vw, 55px) - 28px);
      top: clamp(58px, 6.5vw, 82px);
    }

    .hero-media {
      width: clamp(460px, 49vw, 540px);
      max-width: 540px;
      height: auto;
      bottom: 0;
    }

    .hero-portrait-img {
      width: 100%;
      height: auto;
      display: block;
    }
  }

  /* Mobile/Tablet Responsiveness */
  @media (max-width: 849px) {
    .hero-container {
      min-height: clamp(320px, 48vw, 420px);
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      position: relative;
    }

    .hero-content {
      padding-top: clamp(2rem, 5vw, 3rem);
      padding-bottom: clamp(1.25rem, 3vw, 2rem);
      max-width: 56%;
      z-index: 2;
    }

    .hero-title {
      font-size: clamp(1.85rem, 1.1rem + 2.5vw, 2.4rem);
      margin-bottom: 12px;
    }

    .hero-subhead {
      font-size: 0.9375rem;
      line-height: 1.35;
      max-width: 250px;
      margin-bottom: 18px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: auto;
      min-height: 44px;
      min-width: 145px;
      width: fit-content;
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
    }

    .hero-burst-mark {
      right: auto;
      left: 47%;
      top: clamp(14px, 3.5vw, 24px);
      transform: scale(0.75);
      transform-origin: top left;
    }

    .hero-media {
      position: absolute;
      bottom: 0;
      top: auto;
      right: clamp(-10px, 1.5vw, 20px);
      height: calc(100% - 14px);
      max-height: 480px;
      width: auto;
      max-width: clamp(240px, 55vw, 440px);
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      pointer-events: none;
      z-index: 1;
    }

    .hero-portrait-img {
      height: 100%;
      width: auto;
      max-height: none;
      max-width: 100%;
      display: block;
      object-fit: contain;
      object-position: bottom right;
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.08));
    }
  }

  @media (max-width: 480px) {
    .hero-container {
      min-height: 310px;
    }

    .hero-content {
      max-width: 57%;
      padding-top: 1.85rem;
      padding-bottom: 1.25rem;
    }

    .hero-title {
      font-size: clamp(1.45rem, 1rem + 2.2vw, 1.95rem);
      margin-bottom: 8px;
    }

    .hero-subhead {
      font-size: 0.875rem;
      max-width: 215px;
      margin-bottom: 14px;
    }

    .hero-actions {
      gap: 8px;
      width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: auto;
      min-height: 44px;
      min-width: 0;
      font-size: 0.72rem;
      line-height: 1.2;
      padding: 0.5rem 0.85rem;
      white-space: nowrap;
    }

    .hero-burst-mark {
      left: 50%;
      top: 12px;
      transform: scale(0.65);
    }

    .hero-media {
      position: absolute;
      bottom: 0;
      top: auto;
      right: clamp(-24px, -4vw, -8px);
      height: calc(100% - 12px);
      max-height: 360px;
      width: auto;
      max-width: 48%;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      pointer-events: none;
      z-index: 1;
    }

    .hero-portrait-img {
      height: 100%;
      width: auto;
      max-height: none;
      max-width: 100%;
      display: block;
      object-fit: contain;
      object-position: bottom right;
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.08));
    }
  }

  @media (max-width: 359px) {
    .hero-content .title-line {
      white-space: normal;
    }

    .hero-btn-live,
    .hero-btn-watch {
      font-size: 0.6875rem;
      padding: 0.45rem 0.72rem;
    }
  }

  /* Hero Load Staged Sequence */
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(var(--motion-distance, 24px));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-title {
    animation: heroFadeIn var(--motion-standard, 800ms) var(--ease-out) 0ms both;
  }

  .hero-subhead,
  .hero-actions,
  .hero-media,
  .hero-burst-mark {
    animation: heroFadeIn var(--motion-standard, 800ms) var(--ease-out) var(--motion-stagger, 100ms) both;
  }

  @media (max-width: 600px) {
    .hero-title {
      animation-duration: 600ms;
    }

    .hero-subhead,
    .hero-actions,
    .hero-media,
    .hero-burst-mark {
      animation-duration: 600ms;
      animation-delay: 90ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subhead,
    .hero-actions,
    .hero-media,
    .hero-burst-mark {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
