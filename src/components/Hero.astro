---
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import { siteConfig } from '../data/siteConfig';
import heroPortraitImg from '../assets/photography/hero/janelle-hero.png';
import BurstMark from './BurstMark.astro';

const heroSources = await createResponsiveSourceSet(
  heroPortraitImg,
  [320, 480, 560, 682],
  'png'
);
---

<section class="hero-section" id="hero" aria-label="Hero Section">
  <div class="container hero-container">
    <!-- Hero Text Content -->
    <div class="hero-content">
      <!-- Main Display Headline (calibrated ~67px, ends ~485px from left edge) -->
      <h1 class="hero-title" aria-label={siteConfig.heroHeadline.join(' ')}>
        {siteConfig.heroHeadline.map((word) => (
          <span class="title-line">{word.replace(/\.$/, '')}<span class="red-sq" aria-hidden="true"></span></span>
        ))}
      </h1>

      <!-- Supporting Copy: 3 distinct lines, constrained to ~320px -->
      <p class="hero-subhead wrap-break">
        Comedian, creator, writer, <br class="desktop-break" />
        MC, mum, and indoorsy type. <br class="desktop-break" />
        See Janelle live around Australia.
      </p>

      <!-- Action Buttons on one horizontal line with 30px gap above -->
      <div class="hero-actions">
        <a href="#shows" class="btn btn-primary hero-btn-live">
          SEE JANELLE LIVE
        </a>
        <button type="button" class="btn btn-secondary hero-btn-watch" id="hero-watch-btn" data-video-trigger>
          <span>WATCH JANELLE</span>
          <svg class="play-circle-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
          </svg>
        </button>
      </div>
    </div>

    <!-- Layered Large Portrait Anchored to Bottom Edge with Anchored Burst Mark -->
    <div class="hero-media">
      <div class="hero-burst-mark" aria-hidden="true">
        <BurstMark animated={true} strokeWidth={2.5} />
      </div>

      <picture class="hero-portrait-picture">
        <source
          type="image/avif"
          srcset={heroSources.avifSrcset}
          sizes="(min-width: 1150px) 542px, (min-width: 850px) 46vw, 72vw"
        />
        <source
          type="image/webp"
          srcset={heroSources.webpSrcset}
          sizes="(min-width: 1150px) 542px, (min-width: 850px) 46vw, 72vw"
        />
        <img
          src={heroSources.fallbackSrc}
          srcset={heroSources.fallbackSrcset}
          sizes="(min-width: 1150px) 542px, (min-width: 850px) 46vw, 72vw"
          alt="Janelle Koenig smiling with hands on hips in denim dress"
          width={heroSources.width}
          height={heroSources.height}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-portrait-img"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: var(--gradient-hero-warm);
    padding-block-start: var(--header-offset);
    overflow: clip;
    width: 100%;
  }

  .hero-container {
    position: relative;
    min-height: clamp(560px, 46vw, 640px);
    display: flex;
    align-items: center;
  }

  /* Left Content Column - Preserving text block sizing and button sizing */
  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 480px;
    min-width: 0;
    padding-top: clamp(56px, 6vw, 84px);
    padding-bottom: clamp(2.75rem, 4.5vw, 3.75rem);
    display: flex;
    flex-direction: column;
  }

  /* Display Headline: calibrated to match reference */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.3rem + 4.5vw, 4.2rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--colour-ink);
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    width: fit-content;
  }

  .title-line {
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
  }

  /* Supporting Copy: Constrained to 320px across 3 lines */
  .hero-subhead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--colour-ink);
    font-weight: 500;
    max-width: 320px;
    margin-bottom: 30px;
  }

  /* Action Buttons on One Horizontal Line with 30px gap above */
  .hero-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-btn-live {
    min-height: 44px;
    height: auto;
    min-width: 155px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: var(--colour-primary);
    color: #ffffff;
    border-color: var(--colour-primary);
    border-radius: var(--radius-xs);
  }

  .hero-btn-watch {
    min-height: 44px;
    height: auto;
    min-width: 165px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: var(--colour-surface);
    color: var(--colour-ink);
    border: 1.5px solid var(--colour-ink);
    border-radius: var(--radius-xs);
    gap: 8px;
  }

  .hero-btn-watch:hover {
    background-color: rgba(255, 255, 255, 0.85);
  }

  .play-circle-icon {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .play-circle-icon {
      transition: transform var(--motion-fast) var(--ease-out);
    }

    .hero-btn-watch:is(:hover, :focus-visible) .play-circle-icon {
      transform: scale(1.1);
    }
  }

  /* Red 3-Line Burst Mark anchored beside Janelle's Head inside .hero-media */
  .hero-burst-mark {
    display: block;
    position: absolute;
    left: 23%;
    top: 11%;
    z-index: 2;
    pointer-events: none;
    --burst-size: clamp(34px, 3.2vw, 46px);
  }

  /* Oversized Dominant Hero Portrait: Sized from container height with top clearance, cropped at mid-thigh */
  .hero-media {
    position: absolute;
    right: clamp(16px, 3.2vw, 52px);
    bottom: 0;
    top: auto;
    height: min(calc(100% - clamp(16px, 2vw, 24px)), 612px);
    aspect-ratio: 682 / 770;
    width: auto;
    max-width: none;
    z-index: 1;
    pointer-events: none;
  }

  .hero-portrait-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-portrait-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.08));
  }

  /* Tablet Landscape & Medium Screens (850px - 1149px) */
  @media (min-width: 850px) and (max-width: 1149px) {
    .hero-container {
      min-height: clamp(500px, 49vw, 560px);
    }

    .hero-content {
      padding-top: clamp(60px, 7vw, 84px);
      padding-bottom: 2.5rem;
    }

    .hero-media {
      right: clamp(16px, 2.5vw, 32px);
      height: min(calc(100% - clamp(16px, 2vw, 22px)), 536px);
      width: auto;
      max-width: none;
      bottom: 0;
    }
  }

  /* Mobile/Tablet Responsiveness */
  @media (max-width: 849px) {
    .hero-container {
      min-height: clamp(340px, 50vw, 460px);
      display: flex;
      flex-direction: row;
      align-items: center;
      position: relative;
    }

    .hero-content {
      padding-top: clamp(1.75rem, 4.5vw, 3rem);
      padding-bottom: clamp(1.75rem, 4.5vw, 2.75rem);
      max-width: 55%;
      z-index: 3;
    }

    .hero-title {
      font-size: clamp(1.85rem, 1.1rem + 2.5vw, 2.4rem);
      margin-bottom: 12px;
    }

    .hero-subhead {
      font-size: 0.9375rem;
      line-height: 1.35;
      max-width: 240px;
      margin-bottom: 18px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      width: fit-content;
      max-width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: auto;
      min-height: 44px;
      min-width: 0;
      width: 100%;
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
    }

    .hero-burst-mark {
      left: 23%;
      top: 11%;
      --burst-size: clamp(28px, 4.8vw, 38px);
    }

    .hero-media {
      position: absolute;
      bottom: 0;
      top: auto;
      right: clamp(-26px, 12vw - 84px, 18px);
      height: min(calc(100% - 14px), 446px);
      aspect-ratio: 682 / 770;
      width: auto;
      max-width: none;
      pointer-events: none;
      z-index: 1;
    }

    .hero-portrait-img {
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.08));
    }
  }

  @media (max-width: 480px) {
    .hero-container {
      min-height: 275px;
    }

    .hero-content {
      max-width: 50%;
      padding-top: 1rem;
      padding-bottom: 1.25rem;
    }

    .hero-title {
      font-size: clamp(1.6rem, 0.95rem + 3vw, 2.05rem);
      margin-bottom: 8px;
    }

    .hero-subhead {
      font-size: 0.84375rem;
      line-height: 1.32;
      max-width: 158px;
      margin-bottom: 12px;
    }

    .hero-actions {
      gap: 8px;
      width: fit-content;
      max-width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: auto;
      min-height: 44px;
      min-width: 0;
      width: 100%;
      font-size: 0.7rem;
      line-height: 1.2;
      padding: 0.45rem 0.78rem;
      white-space: nowrap;
    }

    .hero-burst-mark {
      left: 22%;
      top: 11%;
      --burst-size: 26px;
    }

    .hero-media {
      right: clamp(0px, 1vw, 8px);
      width: clamp(190px, 51vw, 238px);
      height: auto;
      max-height: calc(100% - 8px);
      max-width: none;
    }
  }

  @media (max-width: 359px) {
    .hero-container {
      min-height: 255px;
    }

    .hero-content {
      max-width: 52%;
    }

    .hero-content .title-line {
      white-space: normal;
    }

    .hero-title {
      font-size: clamp(1.45rem, 0.9rem + 2.8vw, 1.85rem);
    }

    .hero-subhead {
      font-size: 0.8125rem;
      max-width: 140px;
    }

    .hero-btn-live,
    .hero-btn-watch {
      font-size: 0.675rem;
      padding: 0.45rem 0.65rem;
    }

    .hero-media {
      right: 0;
      width: clamp(148px, 47vw, 175px);
      height: auto;
      max-height: calc(100% - 8px);
    }

    .hero-burst-mark {
      --burst-size: 22px;
    }
  }

  /* Hero Load Staged Sequence */
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(var(--motion-distance, 24px));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-title {
    animation: heroFadeIn var(--motion-standard, 800ms) var(--ease-out) 0ms both;
  }

  .hero-subhead,
  .hero-actions,
  .hero-media {
    animation: heroFadeIn var(--motion-standard, 800ms) var(--ease-out) var(--motion-stagger, 100ms) both;
  }

  @media (max-width: 600px) {
    .hero-title {
      animation-duration: 600ms;
    }

    .hero-subhead,
    .hero-actions,
    .hero-media {
      animation-duration: 600ms;
      animation-delay: 90ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subhead,
    .hero-actions,
    .hero-media,
    .hero-burst-mark {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
