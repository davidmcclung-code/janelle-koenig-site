---
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import { siteConfig } from '../data/siteConfig';
import heroPortraitImg from '../assets/photography/hero/janelle-hero.png';
import BurstMark from './BurstMark.astro';

const heroSources = await createResponsiveSourceSet(
  heroPortraitImg,
  [320, 480, 560, 682],
  'png'
);
---

<section class="hero-section" id="hero" aria-label="Hero Section">
  <div class="container hero-container">
    <!-- Hero Text Content -->
    <div class="hero-parallax-text">
      <div class="hero-content">
        <h1 class="hero-title" aria-label={siteConfig.heroHeadline.join(' ')}>
          {siteConfig.heroHeadline.map((word, index) => (
            <span class="title-line-mask">
              <span class="title-line" style={`--line-idx: ${index};`}>
                {word.replace(/\.$/, '')}<span class="red-sq" aria-hidden="true"></span>
              </span>
            </span>
          ))}
        </h1>

        <p class="hero-subhead wrap-break">
          Comedian, creator, writer, <br class="desktop-break" />
          MC, mum, and indoorsy type. <br class="desktop-break" />
          See Janelle live around Australia.
        </p>

        <div class="hero-actions">
          <a href="#shows" class="btn btn-primary hero-btn-live">
            SEE JANELLE LIVE
          </a>
          <button type="button" class="btn btn-secondary hero-btn-watch" id="hero-watch-btn" data-video-trigger>
            <span>WATCH JANELLE</span>
            <svg class="play-circle-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Layered Large Portrait & Burst Mark -->
    <div class="hero-media">
      <div class="hero-parallax-burst" aria-hidden="true">
        <div class="hero-burst-mark">
          <BurstMark animated={true} strokeWidth={2.5} />
        </div>
      </div>

      <div class="hero-parallax-media">
        <picture class="hero-portrait-picture">
          <source
            type="image/avif"
            srcset={heroSources.avifSrcset}
            sizes="(min-width: 1150px) 542px, (min-width: 850px) 46vw, 72vw"
          />
          <source
            type="image/webp"
            srcset={heroSources.webpSrcset}
            sizes="(min-width: 1150px) 542px, (min-width: 850px) 46vw, 72vw"
          />
          <img
            src={heroSources.fallbackSrc}
            srcset={heroSources.fallbackSrcset}
            sizes="(min-width: 1150px) 542px, (min-width: 850px) 46vw, 72vw"
            alt="Janelle Koenig smiling with hands on hips in denim dress"
            width={heroSources.width}
            height={heroSources.height}
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="hero-portrait-img"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: var(--gradient-hero-warm);
    padding-block-start: var(--header-height);
    overflow: clip;
    width: 100%;
  }

  .hero-container {
    position: relative;
    min-height: clamp(540px, 45vw, 630px);
    display: flex;
    align-items: center;
  }

  .hero-parallax-text {
    position: relative;
    z-index: 3;
    max-width: 480px;
    min-width: 0;
  }

  .hero-content {
    padding-top: clamp(44px, 5vw, 72px);
    padding-bottom: clamp(2.75rem, 4.5vw, 3.75rem);
    display: flex;
    flex-direction: column;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.3rem + 4.5vw, 4.25rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--colour-ink);
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    width: fit-content;
  }

  .title-line-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.08em;
  }

  .title-line {
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
  }

  .hero-subhead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--colour-ink);
    font-weight: 500;
    max-width: 320px;
    margin-bottom: 30px;
  }

  .hero-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-btn-live {
    min-height: 44px;
    height: auto;
    min-width: 155px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: var(--colour-primary);
    color: #ffffff;
    border-color: var(--colour-primary);
    border-radius: var(--radius-xs);
  }

  .hero-btn-watch {
    min-height: 44px;
    height: auto;
    min-width: 165px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: var(--colour-surface);
    color: var(--colour-ink);
    border: 1.5px solid var(--colour-ink);
    border-radius: var(--radius-xs);
    gap: 8px;
  }

  .hero-btn-watch:hover {
    background-color: rgba(255, 255, 255, 0.85);
  }

  .play-circle-icon {
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .play-circle-icon {
      transition: transform var(--motion-fast) var(--ease-out);
    }

    .hero-btn-watch:is(:hover, :focus-visible) .play-circle-icon {
      transform: scale(1.12);
    }
  }

  .hero-parallax-burst {
    position: absolute;
    left: 23%;
    top: 11%;
    z-index: 2;
    pointer-events: none;
  }

  .hero-burst-mark {
    display: block;
    --burst-size: clamp(34px, 3.2vw, 46px);
  }

  .hero-media {
    position: absolute;
    right: clamp(16px, 3.2vw, 52px);
    bottom: 0;
    top: auto;
    height: min(calc(100% - clamp(16px, 2vw, 24px)), 612px);
    aspect-ratio: 682 / 770;
    width: auto;
    max-width: none;
    z-index: 1;
    pointer-events: none;
  }

  .hero-parallax-media {
    width: 100%;
    height: 100%;
  }

  .hero-portrait-picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-portrait-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    max-width: none;
    display: block;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.08));
  }

  /* ==========================================================================
     Entrance Choreography & Layered Scroll Parallax (Desktop)
     ========================================================================== */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes hero-mask-rise {
      from {
        opacity: 0;
        transform: translateY(105%);
        clip-path: inset(0 0 100% 0);
      }
      to {
        opacity: 1;
        transform: translateY(0);
        clip-path: inset(0 0 0 0);
      }
    }

    @keyframes hero-fade-up {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes hero-portrait-in {
      from {
        opacity: 0;
        transform: translateY(18px) scale(0.975);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .title-line {
      animation: hero-mask-rise 720ms var(--ease-out) calc(60ms + var(--line-idx, 0) * 90ms) both;
    }

    .hero-subhead {
      animation: hero-fade-up 700ms var(--ease-out) 220ms both;
    }

    .hero-actions {
      animation: hero-fade-up 700ms var(--ease-out) 300ms both;
    }

    .hero-portrait-img {
      animation: hero-portrait-in 850ms var(--ease-out) 140ms both;
    }

    @media (min-width: 850px) {
      @supports ((animation-timeline: view()) and (animation-range: entry)) {
        .hero-section {
          view-timeline: --hero-stage block;
        }

        @keyframes hero-parallax-layer {
          from {
            transform: translateY(0);
          }
          to {
            transform: translateY(var(--parallax-offset, 40px));
          }
        }

        .hero-parallax-text {
          --parallax-offset: -36px;
          animation: hero-parallax-layer linear both;
          animation-timeline: --hero-stage;
          animation-range: exit 0% exit 100%;
        }

        .hero-parallax-media {
          --parallax-offset: 48px;
          animation: hero-parallax-layer linear both;
          animation-timeline: --hero-stage;
          animation-range: exit 0% exit 100%;
        }

        .hero-parallax-burst {
          --parallax-offset: -24px;
          animation: hero-parallax-layer linear both;
          animation-timeline: --hero-stage;
          animation-range: exit 0% exit 100%;
        }
      }
    }
  }

  /* Tablet Landscape & Medium Screens (850px - 1149px) */
  @media (min-width: 850px) and (max-width: 1149px) {
    .hero-container {
      min-height: clamp(500px, 49vw, 560px);
    }

    .hero-content {
      padding-top: clamp(48px, 6vw, 72px);
      padding-bottom: 2.5rem;
    }

    .hero-media {
      right: clamp(16px, 2.5vw, 32px);
      height: min(calc(100% - clamp(16px, 2vw, 22px)), 536px);
      width: auto;
      max-width: none;
      bottom: 0;
    }
  }

  /* Mobile/Tablet Responsiveness */
  @media (max-width: 849px) {
    .hero-container {
      min-height: clamp(340px, 50vw, 460px);
      display: flex;
      flex-direction: row;
      align-items: center;
      position: relative;
    }

    .hero-parallax-text {
      max-width: 55%;
    }

    .hero-content {
      padding-top: clamp(1.75rem, 4.5vw, 3rem);
      padding-bottom: clamp(1.75rem, 4.5vw, 2.75rem);
      z-index: 3;
    }

    .hero-title {
      font-size: clamp(1.85rem, 1.1rem + 2.5vw, 2.4rem);
      margin-bottom: 12px;
    }

    .hero-subhead {
      font-size: 0.9375rem;
      line-height: 1.35;
      max-width: 240px;
      margin-bottom: 18px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      width: fit-content;
      max-width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: auto;
      min-height: 44px;
      min-width: 0;
      width: 100%;
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
    }

    .hero-parallax-burst {
      left: 23%;
      top: 11%;
    }

    .hero-burst-mark {
      --burst-size: clamp(28px, 4.8vw, 38px);
    }

    .hero-media {
      position: absolute;
      bottom: 0;
      top: auto;
      right: clamp(-26px, 12vw - 84px, 18px);
      height: min(calc(100% - 14px), 446px);
      aspect-ratio: 682 / 770;
      width: auto;
      max-width: none;
      pointer-events: none;
      z-index: 1;
    }

    .hero-portrait-img {
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.08));
    }
  }

  @media (max-width: 480px) {
    .hero-container {
      min-height: 275px;
    }

    .hero-parallax-text {
      max-width: 50%;
    }

    .hero-content {
      padding-top: 1rem;
      padding-bottom: 1.25rem;
    }

    .hero-title {
      font-size: clamp(1.6rem, 0.95rem + 3vw, 2.05rem);
      margin-bottom: 8px;
    }

    .hero-subhead {
      font-size: 0.84375rem;
      line-height: 1.32;
      max-width: 158px;
      margin-bottom: 12px;
    }

    .hero-actions {
      gap: 8px;
      width: fit-content;
      max-width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: auto;
      min-height: 44px;
      min-width: 0;
      width: 100%;
      font-size: 0.7rem;
      line-height: 1.2;
      padding: 0.45rem 0.78rem;
      white-space: nowrap;
    }

    .hero-parallax-burst {
      left: 22%;
      top: 11%;
    }

    .hero-burst-mark {
      --burst-size: 26px;
    }

    .hero-media {
      right: clamp(0px, 1vw, 8px);
      width: clamp(190px, 51vw, 238px);
      height: auto;
      max-height: calc(100% - 8px);
      max-width: none;
    }
  }

  @media (max-width: 359px) {
    .hero-container {
      min-height: 255px;
    }

    .hero-parallax-text {
      max-width: 52%;
    }

    .hero-content .title-line {
      white-space: normal;
    }

    .hero-title {
      font-size: clamp(1.45rem, 0.9rem + 2.8vw, 1.85rem);
    }

    .hero-subhead {
      font-size: 0.8125rem;
      max-width: 140px;
    }

    .hero-btn-live,
    .hero-btn-watch {
      font-size: 0.675rem;
      padding: 0.45rem 0.65rem;
    }

    .hero-media {
      right: 0;
      width: clamp(148px, 47vw, 175px);
      height: auto;
      max-height: calc(100% - 8px);
    }

    .hero-burst-mark {
      --burst-size: 22px;
    }
  }
</style>

<script>
  // Parallax fallback for desktop browsers without scroll-driven view() support
  if (
    !CSS.supports('(animation-timeline: view()) and (animation-range: entry)') &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
    window.matchMedia('(min-width: 850px)').matches
  ) {
    const heroSection = document.getElementById('hero');
    const textLayer = heroSection?.querySelector<HTMLElement>('.hero-parallax-text');
    const mediaLayer = heroSection?.querySelector<HTMLElement>('.hero-parallax-media');
    const burstLayer = heroSection?.querySelector<HTMLElement>('.hero-parallax-burst');

    if (heroSection && textLayer && mediaLayer && burstLayer) {
      let active = false;
      const updateParallax = () => {
        if (!active) return;
        const rect = heroSection.getBoundingClientRect();
        const height = rect.height || 1;
        const progress = Math.max(0, Math.min(1, -rect.top / height));
        textLayer.style.transform = `translateY(${progress * -36}px)`;
        mediaLayer.style.transform = `translateY(${progress * 48}px)`;
        burstLayer.style.transform = `translateY(${progress * -24}px)`;
      };

      const observer = new IntersectionObserver((entries) => {
        active = entries.some((entry) => entry.isIntersecting);
        if (active) {
          window.addEventListener('scroll', updateParallax, { passive: true });
          updateParallax();
        } else {
          window.removeEventListener('scroll', updateParallax);
        }
      });
      observer.observe(heroSection);
    }
  }
</script>
