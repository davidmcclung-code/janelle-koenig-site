---
import { siteConfig } from '../data/siteConfig';
import { asset } from '../utils/paths';
---

<section class="hero-section" id="hero" aria-label="Hero Section">
  <div class="container hero-container">
    <!-- Hero Text Content -->
    <div class="hero-content">
      <!-- Cursive greeting without stray decorative characters -->
      <div class="hero-greeting-wrapper">
        <span class="font-script text-script-hero hero-greeting">{siteConfig.heroGreeting}</span>
      </div>

      <!-- Main Display Headline (calibrated ~67px, ends ~485px from left edge) -->
      <h1 class="hero-title" aria-label="Comedy. Motherhood. Poor decisions.">
        <span class="title-line">Comedy<span class="red-sq" aria-hidden="true"></span></span>
        <span class="title-line">Motherhood<span class="red-sq" aria-hidden="true"></span></span>
        <span class="title-line">Poor decisions<span class="red-sq" aria-hidden="true"></span></span>
      </h1>

      <!-- Supporting Copy: 3 distinct lines, constrained to ~320px -->
      <p class="hero-subhead wrap-break">
        Stand-up comedian, writer and<br />
        indoors enthusiast.<br />
        See Janelle live around Australia.
      </p>

      <!-- Action Buttons on one horizontal line with 30px gap above -->
      <div class="hero-actions">
        <a href="#shows" class="btn btn-primary hero-btn-live">
          SEE JANELLE LIVE
        </a>
        <button type="button" class="btn btn-secondary hero-btn-watch" id="hero-watch-btn" data-video-trigger>
          <span>WATCH JANELLE</span>
          <svg class="play-circle-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon>
          </svg>
        </button>
      </div>
    </div>

    <!-- Red 3-Line Emphasis Mark Immediately to the Left of Janelle's Head -->
    <div class="hero-burst-mark" aria-hidden="true">
      <svg class="hero-burst-svg" width="44" height="44" viewBox="0 0 46 46" fill="none">
        <line class="burst-ray ray-bottom" x1="10" y1="36" x2="2" y2="40" stroke="var(--colour-primary)" stroke-width="2.5" stroke-linecap="round"/>
        <line class="burst-ray ray-middle" x1="14" y1="23" x2="2" y2="19" stroke="var(--colour-primary)" stroke-width="2.5" stroke-linecap="round"/>
        <line class="burst-ray ray-top" x1="22" y1="12" x2="14" y2="2" stroke="var(--colour-primary)" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </div>

    <!-- Layered Large Portrait Anchored to Bottom Edge -->
    <div class="hero-media">
      <img
        src={asset('/images/hero/janelle-placeholder-hero.png')}
        alt="Janelle Koenig smiling in denim dress"
        width="796"
        height="1024"
        fetchpriority="high"
        loading="eager"
        class="hero-portrait-img"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    background: radial-gradient(circle at 72% 38%, #f5e4d5 0%, #f9eee4 38%, #fbf8f4 75%);
    overflow: hidden;
    width: 100%;
  }

  .hero-container {
    position: relative;
    min-height: 660px;
    display: flex;
    align-items: flex-start;
  }

  /* Left Content Column - Preserving text block sizing and button sizing */
  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 480px;
    min-width: 0;
    padding-top: 56px;
    padding-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
  }

  .hero-greeting-wrapper {
    margin-bottom: 4px;
  }

  .hero-greeting {
    font-size: 1.625rem;
    color: var(--colour-primary);
    transform: rotate(-2deg);
    display: inline-block;
    line-height: 1.1;
  }

  /* Display Headline: calibrated to match reference */
  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6.55vw, 4.2rem);
    font-weight: 900;
    line-height: 0.96;
    letter-spacing: -0.035em;
    color: var(--colour-ink);
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    width: fit-content;
  }

  .title-line {
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
  }

  /* Punctuation: Single Red Square Attached to Final Word */
  .red-sq {
    display: inline-block;
    width: 0.155em;
    height: 0.155em;
    background-color: var(--colour-primary);
    margin-left: 0.08em;
    vertical-align: 0.04em;
    flex-shrink: 0;
  }

  /* Supporting Copy: Constrained to 320px across 3 lines */
  .hero-subhead {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.4;
    color: var(--colour-ink);
    font-weight: 500;
    max-width: 320px;
    margin-bottom: 30px;
  }

  /* Action Buttons on One Horizontal Line with 30px gap above */
  .hero-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-btn-live {
    height: 44px;
    min-width: 155px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: var(--colour-primary);
    color: #ffffff;
    border-color: var(--colour-primary);
    border-radius: var(--radius-xs);
  }

  .hero-btn-watch {
    height: 44px;
    min-width: 165px;
    padding: 0.55rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    background-color: #ffffff;
    color: var(--colour-ink);
    border: 1.5px solid var(--colour-ink);
    border-radius: var(--radius-xs);
    gap: 8px;
  }

  .hero-btn-watch:hover {
    background-color: rgba(255, 255, 255, 0.85);
  }

  .play-circle-icon {
    flex-shrink: 0;
  }

  /* Red 3-Line Burst Mark beside Janelle's Head */
  .hero-burst-mark {
    display: block;
    position: absolute;
    left: clamp(440px, 44vw, 570px);
    top: clamp(85px, 9.5vw, 115px);
    z-index: 2;
  }

  .hero-burst-svg {
    overflow: visible;
    transform-origin: 30px 30px;
    animation: giggleWrapper 4.2s ease-in-out infinite;
  }

  .burst-ray {
    transform-box: view-box;
    will-change: transform, opacity;
  }

  .ray-bottom {
    transform-origin: 10px 36px;
    animation: giggleBottom 4.2s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }

  .ray-middle {
    transform-origin: 14px 23px;
    animation: giggleMiddle 4.2s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }

  .ray-top {
    transform-origin: 22px 12px;
    animation: giggleTop 4.2s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }

  @keyframes giggleWrapper {
    0% {
      transform: rotate(0deg);
    }
    3% {
      transform: rotate(-2.5deg);
    }
    6% {
      transform: rotate(2deg);
    }
    10% {
      transform: rotate(-1.5deg);
    }
    14% {
      transform: rotate(1deg);
    }
    18%, 100% {
      transform: rotate(0deg);
    }
  }

  @keyframes giggleBottom {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    2.5% {
      transform: scale(1.24);
      opacity: 1;
    }
    5.5% {
      transform: scale(0.92);
      opacity: 0.85;
    }
    8.5% {
      transform: scale(1.3);
      opacity: 1;
    }
    13% {
      transform: scale(0.97);
      opacity: 0.9;
    }
    18%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
  }

  @keyframes giggleMiddle {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    3.5% {
      transform: scale(0.9);
      opacity: 0.85;
    }
    6.5% {
      transform: scale(1.28);
      opacity: 1;
    }
    10% {
      transform: scale(0.95);
      opacity: 0.85;
    }
    14% {
      transform: scale(1.22);
      opacity: 1;
    }
    19%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
  }

  @keyframes giggleTop {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    2% {
      transform: scale(0.94);
      opacity: 0.85;
    }
    5% {
      transform: scale(1.22);
      opacity: 1;
    }
    8% {
      transform: scale(0.9);
      opacity: 0.85;
    }
    12% {
      transform: scale(1.32);
      opacity: 1;
    }
    17% {
      transform: scale(0.96);
      opacity: 0.9;
    }
    21%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
  }

  /* Oversized Dominant Hero Portrait: Scaled 1.6-1.8x, anchored to top, cropped at waist/thigh */
  .hero-media {
    position: absolute;
    right: clamp(15px, 3.5vw, 65px);
    top: -32px;
    width: clamp(540px, 54vw, 700px);
    max-width: 700px;
    height: auto;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    z-index: 1;
    pointer-events: none;
  }

  .hero-portrait-img {
    width: 100%;
    height: auto;
    max-width: none;
    display: block;
    filter: drop-shadow(0 12px 30px rgba(0, 0, 0, 0.08));
  }

  /* Mobile/Tablet Responsiveness */
  @media (max-width: 849px) {
    .hero-container {
      min-height: 440px;
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      position: relative;
    }

    .hero-content {
      padding-top: 1.5rem;
      padding-bottom: 2rem;
      max-width: 58%;
      z-index: 2;
    }

    .hero-greeting {
      font-size: 1.35rem;
    }

    .hero-title {
      font-size: clamp(1.85rem, 6.5vw, 2.5rem);
      margin-bottom: 12px;
    }

    .hero-subhead {
      font-size: 0.8125rem;
      line-height: 1.35;
      max-width: 220px;
      margin-bottom: 18px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: 44px;
      min-height: 44px;
      min-width: 145px;
      width: fit-content;
      font-size: 0.75rem;
      padding: 0.5rem 1rem;
    }

    .hero-burst-mark {
      left: 50%;
      top: 32px;
      transform: scale(0.75);
      transform-origin: top left;
    }

    .hero-media {
      position: absolute;
      width: 52%;
      max-width: 360px;
      height: auto;
      bottom: 0;
      top: auto;
      right: 0;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
    }

    .hero-portrait-img {
      width: 100%;
      height: auto;
      max-height: none;
      object-fit: contain;
      object-position: bottom right;
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.08));
    }
  }

  @media (max-width: 480px) {
    .hero-container {
      min-height: 400px;
    }

    .hero-content {
      max-width: 58%;
      padding-top: 1.25rem;
      padding-bottom: 1.5rem;
    }

    .hero-greeting {
      font-size: 1.2rem;
    }

    .hero-title {
      font-size: clamp(1.75rem, 6.8vw, 2.2rem);
      margin-bottom: 10px;
    }

    .hero-subhead {
      font-size: 0.75rem;
      max-width: 190px;
      margin-bottom: 14px;
    }

    .hero-actions {
      gap: 8px;
      width: 100%;
    }

    .hero-btn-live,
    .hero-btn-watch {
      height: 44px;
      min-height: 44px;
      min-width: 140px;
      font-size: 0.75rem;
      line-height: 1.2;
      padding: 0.5rem 0.95rem;
    }

    .hero-burst-mark {
      left: 50%;
      top: 24px;
      transform: scale(0.65);
    }

    .hero-media {
      position: absolute;
      top: -12px;
      bottom: 0;
      right: -8px;
      width: auto;
      max-width: none;
      height: calc(100% + 12px);
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      pointer-events: none;
      z-index: 1;
    }

    .hero-portrait-img {
      height: 100%;
      width: auto;
      max-width: none;
      display: block;
      object-fit: contain;
      object-position: bottom right;
      filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.08));
    }
  }

  /* Hero Load Staged Sequence */
  @keyframes heroFadeIn {
    from {
      opacity: 0;
      transform: translateY(var(--motion-distance, 24px));
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-greeting-wrapper,
  .hero-title {
    animation: heroFadeIn var(--motion-standard, 800ms) var(--ease-out) 0ms both;
  }

  .hero-subhead,
  .hero-actions,
  .hero-media,
  .hero-burst-mark {
    animation: heroFadeIn var(--motion-standard, 800ms) var(--ease-out) var(--motion-stagger, 100ms) both;
  }

  @media (max-width: 600px) {
    .hero-greeting-wrapper,
    .hero-title {
      animation-duration: 600ms;
    }

    .hero-subhead,
    .hero-actions,
    .hero-media,
    .hero-burst-mark {
      animation-duration: 600ms;
      animation-delay: 90ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-greeting-wrapper,
    .hero-title,
    .hero-subhead,
    .hero-actions,
    .hero-media,
    .hero-burst-mark,
    .hero-burst-svg,
    .burst-ray {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
