---
/**
 * GalleryLightbox.astro
 * Accessible full-screen modal lightbox for photo inspection.
 */
---

<dialog id="gallery-lightbox" class="gallery-lightbox" aria-modal="true" aria-label="Photo Gallery Lightbox">
  <div class="lightbox-container">
    <!-- Top Action Bar -->
    <header class="lightbox-header">
      <div class="lightbox-counter" id="lightbox-counter" aria-live="polite">
        1 / 12
      </div>
      <button
        type="button"
        class="lightbox-control-btn lightbox-close-btn"
        id="lightbox-close"
        aria-label="Close photo view (Escape)"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <!-- Main Image Display & Navigation Arrows -->
    <div class="lightbox-body">
      <button
        type="button"
        class="lightbox-control-btn lightbox-nav-btn lightbox-prev"
        id="lightbox-prev"
        aria-label="Previous photo (Left Arrow)"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-stage">
        <div class="lightbox-img-wrapper" id="lightbox-img-wrapper">
          <img
            id="lightbox-img"
            class="lightbox-image"
            src=""
            alt=""
            decoding="async"
          />
        </div>
      </div>

      <button
        type="button"
        class="lightbox-control-btn lightbox-nav-btn lightbox-next"
        id="lightbox-next"
        aria-label="Next photo (Right Arrow)"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <!-- Metadata / Caption Footer -->
    <footer class="lightbox-footer">
      <div class="lightbox-caption-box">
        <h2 id="lightbox-title" class="lightbox-title"></h2>
        <p id="lightbox-location" class="lightbox-location"></p>
        <p id="lightbox-caption" class="lightbox-caption"></p>
      </div>
    </footer>
  </div>
</dialog>

<style>
  .gallery-lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background-color: rgba(10, 10, 10, 0.96);
    color: #ffffff;
    z-index: 1000;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--motion-fast) var(--ease-out),
                visibility var(--motion-fast);
  }

  .gallery-lightbox::backdrop {
    background-color: rgba(0, 0, 0, 0.88);
  }

  .gallery-lightbox[open] {
    opacity: 1;
    visibility: visible;
    display: flex;
  }

  .lightbox-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: var(--space-4) var(--space-4) max(var(--space-4), env(safe-area-inset-bottom));
    box-sizing: border-box;
    position: relative;
    user-select: none;
  }

  @media (min-width: 768px) {
    .lightbox-container {
      padding: var(--space-5) var(--space-6) max(var(--space-5), env(safe-area-inset-bottom));
    }
  }

  /* Header */
  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 48px;
    z-index: 10;
    flex-shrink: 0;
  }

  .lightbox-counter {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.7);
    padding: 0 var(--space-2);
  }

  /* Controls */
  .lightbox-control-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    color: #ffffff;
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out),
                border-color var(--motion-fast) var(--ease-out);
    touch-action: manipulation;
  }

  .lightbox-control-btn:hover {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    transform: scale(1.05);
  }

  .lightbox-control-btn:active {
    transform: scale(0.95);
  }

  /* Body & Stage */
  .lightbox-body {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 0;
    width: 100%;
    padding: var(--space-2) 0;
  }

  .lightbox-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .lightbox-img-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    max-height: 100%;
    transition: opacity var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out);
  }

  .lightbox-image {
    max-width: 100%;
    max-height: calc(100vh - 220px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
  }

  @media (max-width: 600px) {
    .lightbox-image {
      max-height: calc(100vh - 240px);
    }
  }

  /* Navigation Buttons */
  .lightbox-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .lightbox-prev {
    left: var(--space-2);
  }

  .lightbox-next {
    right: var(--space-2);
  }

  @media (max-width: 600px) {
    .lightbox-nav-btn {
      background: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(4px);
    }
    .lightbox-prev {
      left: 0;
    }
    .lightbox-next {
      right: 0;
    }
  }

  /* Footer & Caption */
  .lightbox-footer {
    display: flex;
    justify-content: center;
    width: 100%;
    padding-top: var(--space-3);
    z-index: 10;
    flex-shrink: 0;
  }

  .lightbox-caption-box {
    max-width: 680px;
    text-align: center;
    padding: 0 var(--space-4);
  }

  .lightbox-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 2px;
    letter-spacing: -0.01em;
  }

  .lightbox-location {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--colour-primary-light);
    margin-bottom: 4px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .lightbox-caption {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    user-select: text;
  }

  @media (max-width: 600px) {
    .lightbox-title {
      font-size: 0.9375rem;
    }
    .lightbox-location {
      font-size: 0.75rem;
    }
    .lightbox-caption {
      font-size: 0.8125rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .gallery-lightbox,
    .lightbox-img-wrapper,
    .lightbox-control-btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  interface GalleryItemData {
    src: string;
    alt: string;
    title: string;
    location: string;
    caption: string;
  }

  let galleryItems: GalleryItemData[] = [];
  let currentIndex = 0;
  let lastActiveTile: HTMLElement | null = null;
  let isBackdropMousedown = false;

  const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const counterEl = document.getElementById('lightbox-counter');
  const titleEl = document.getElementById('lightbox-title');
  const locationEl = document.getElementById('lightbox-location');
  const captionEl = document.getElementById('lightbox-caption');
  const imgWrapper = document.getElementById('lightbox-img-wrapper');

  // Collect gallery items from DOM on initialization
  function initGalleryData() {
    const tiles = document.querySelectorAll<HTMLElement>('[data-gallery-tile]');
    galleryItems = Array.from(tiles).map((tile) => ({
      src: tile.dataset.src || '',
      alt: tile.dataset.alt || '',
      title: tile.dataset.title || '',
      location: tile.dataset.location || '',
      caption: tile.dataset.caption || '',
    }));
  }

  function renderCurrentItem() {
    if (!galleryItems.length || !imgEl) return;
    const item = galleryItems[currentIndex];

    // Fade transition if not reduced motion
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (imgWrapper && !prefersReducedMotion) {
      imgWrapper.style.opacity = '0.4';
      imgWrapper.style.transform = 'scale(0.98)';
    }

    imgEl.src = item.src;
    imgEl.alt = item.alt;

    if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${galleryItems.length}`;
    if (titleEl) titleEl.textContent = item.title;
    if (locationEl) locationEl.textContent = item.location;
    if (captionEl) captionEl.textContent = item.caption;

    requestAnimationFrame(() => {
      if (imgWrapper && !prefersReducedMotion) {
        imgWrapper.style.opacity = '1';
        imgWrapper.style.transform = 'scale(1)';
      }
    });
  }

  function openLightbox(index: number, triggerEl: HTMLElement) {
    if (!lightbox) return;
    if (!galleryItems.length) initGalleryData();

    currentIndex = index;
    lastActiveTile = triggerEl;
    renderCurrentItem();

    if (typeof lightbox.showModal === 'function') {
      lightbox.showModal();
    } else {
      lightbox.setAttribute('open', 'true');
    }

    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    if (typeof lightbox.close === 'function') {
      lightbox.close();
    } else {
      lightbox.removeAttribute('open');
    }
    document.body.style.overflow = '';
    lastActiveTile?.focus();
  }

  function showNext() {
    if (!galleryItems.length) return;
    currentIndex = (currentIndex + 1) % galleryItems.length;
    renderCurrentItem();
  }

  function showPrev() {
    if (!galleryItems.length) return;
    currentIndex = (currentIndex - 1 + galleryItems.length) % galleryItems.length;
    renderCurrentItem();
  }

  // Event Listeners for Gallery Tiles
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const tile = target.closest<HTMLElement>('[data-gallery-tile]');
    if (tile) {
      const indexStr = tile.dataset.index;
      const index = indexStr !== undefined ? parseInt(indexStr, 10) : 0;
      openLightbox(index, tile);
    }
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', showPrev);
  nextBtn?.addEventListener('click', showNext);

  // Keyboard navigation
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!lightbox?.hasAttribute('open')) return;

    if (e.key === 'Escape') {
      e.preventDefault();
      closeLightbox();
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      showNext();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      showPrev();
    } else if (e.key === 'Tab') {
      // Focus trapping inside lightbox
      const focusable = lightbox.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (focusable.length === 0) return;

      const firstEl = focusable[0];
      const lastEl = focusable[focusable.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstEl) {
          lastEl.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === lastEl) {
          firstEl.focus();
          e.preventDefault();
        }
      }
    }
  });

  // Safe backdrop click handling
  lightbox?.addEventListener('mousedown', (e) => {
    isBackdropMousedown = e.target === lightbox;
  });

  lightbox?.addEventListener('mouseup', (e) => {
    if (isBackdropMousedown && e.target === lightbox) {
      closeLightbox();
    }
    isBackdropMousedown = false;
  });

  lightbox?.addEventListener('close', () => {
    document.body.style.overflow = '';
    lastActiveTile?.focus();
  });

  // Touch Swipe gestures for Mobile
  let touchStartX = 0;
  let touchEndX = 0;

  lightbox?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  lightbox?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchEndX - touchStartX;
    if (Math.abs(diff) > 50) {
      if (diff < 0) {
        showNext();
      } else {
        showPrev();
      }
    }
  }, { passive: true });

  // Initial load
  initGalleryData();
</script>
