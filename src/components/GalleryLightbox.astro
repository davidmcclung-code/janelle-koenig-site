---
/**
 * GalleryLightbox.astro
 * Accessible Story Lightbox modal: uncropped photo stage + side-by-side story drawer,
 * with FLIP tile-to-lightbox morph on open and directional transitions between slides.
 */
import CloseIcon from './CloseIcon.astro';
---

<dialog id="gallery-lightbox" class="gallery-lightbox" aria-label="Photo Story Lightbox">
  <div class="lightbox-backdrop-wrap">
    <div class="lightbox-modal-card" id="lightbox-modal-card">
      <!-- Left: Uncropped Photo Stage -->
      <div class="lightbox-stage" id="lightbox-stage">
        <img
          id="lightbox-img"
          class="lightbox-image"
          src=""
          alt=""
          decoding="async"
        />
      </div>

      <!-- Right (or Bottom on Mobile): Story Drawer -->
      <aside class="lightbox-story-drawer" aria-label="Photo caption and controls">
        <header class="drawer-header">
          <div class="lightbox-counter" id="lightbox-counter" aria-live="polite">
            01 / 21
          </div>
          <button
            type="button"
            class="lightbox-close-btn"
            id="lightbox-close"
            aria-label="Close photo view (Escape)"
          >
            <CloseIcon size={20} strokeWidth={2.4} />
          </button>
        </header>

        <div class="lightbox-story-body" id="lightbox-story-body" role="region" aria-labelledby="lightbox-title" tabindex="0">
          <span id="lightbox-category" class="font-script lightbox-category"></span>
          <h2 id="lightbox-title" class="lightbox-title"></h2>
          <p id="lightbox-caption" class="lightbox-caption"></p>
        </div>

        <footer class="drawer-footer">
          <button
            type="button"
            class="lightbox-pill-btn lightbox-prev"
            id="lightbox-prev"
            aria-label="Previous photo (Left Arrow)"
          >
            ← PREV
          </button>
          <button
            type="button"
            class="lightbox-pill-btn lightbox-next is-primary"
            id="lightbox-next"
            aria-label="Next photo (Right Arrow)"
          >
            NEXT →
          </button>
        </footer>
      </aside>
    </div>
  </div>
</dialog>

<style>
  .gallery-lightbox {
    --colour-focus: var(--colour-focus-on-dark);
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100vh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: #ffffff;
    z-index: 1000;
    overflow: hidden;
  }

  .gallery-lightbox::backdrop {
    background-color: rgba(8, 8, 8, 0.9);
    backdrop-filter: blur(4px);
  }

  .gallery-lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-backdrop-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: var(--space-4);
  }

  @media (min-width: 900px) {
    .lightbox-backdrop-wrap {
      padding: var(--space-6);
    }
  }

  @media (max-width: 899px) {
    .lightbox-backdrop-wrap {
      padding: 0;
    }
  }

  .lightbox-modal-card {
    contain: layout style paint;
    display: flex;
    flex-direction: row;
    width: 100%;
    max-width: 1240px;
    height: min(84vh, 760px);
    height: min(84dvh, 760px);
    background-color: var(--colour-dark-surface);
    border: 1px solid var(--colour-dark-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75);
  }

  @media (max-width: 899px) {
    .lightbox-modal-card {
      flex-direction: column;
      max-width: 100%;
      height: 100%;
      border: none;
      border-radius: 0;
    }
  }

  /* Left Photo Stage */
  .lightbox-stage {
    flex: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--colour-dark-stage);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 900px) {
    .lightbox-stage {
      padding: var(--space-6);
    }
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-xs);
    display: block;
    transform-origin: center center;
  }

  /* Right Story Drawer */
  .lightbox-story-drawer {
    width: clamp(320px, 32vw, 410px);
    flex-shrink: 0;
    background-color: var(--colour-dark-surface);
    border-left: 1px solid var(--colour-dark-border);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    gap: var(--space-4);
  }

  @media (max-width: 899px) {
    .lightbox-story-drawer {
      width: 100%;
      max-height: 48%;
      border-left: none;
      border-top: 1px solid var(--colour-dark-border);
      padding: var(--space-4) var(--space-4) max(var(--space-4), env(safe-area-inset-bottom));
      gap: var(--space-3);
    }
  }

  @media (max-width: 899px) and (orientation: landscape) and (max-height: 540px) {
    .lightbox-modal-card {
      flex-direction: row;
    }

    .lightbox-story-drawer {
      width: clamp(250px, 40vw, 320px);
      max-height: 100%;
      border-top: none;
      border-left: 1px solid var(--colour-dark-border);
    }
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .lightbox-counter {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--colour-dark-muted);
  }

  .lightbox-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
    touch-action: manipulation;
  }

  .lightbox-close-btn:hover {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    transform: scale(1.05);
  }

  .lightbox-close-btn:focus-visible {
    outline: 2.5px solid var(--colour-primary-light);
    outline-offset: 2px;
  }

  /* Story Body */
  .lightbox-story-body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding-right: 4px;
  }

  .lightbox-category {
    font-size: clamp(1.4rem, 1.05rem + 0.55vw, 1.75rem);
    line-height: 1.1;
    color: var(--colour-primary-on-dark);
    margin-top: auto;
    margin-bottom: 4px;
  }

  .lightbox-title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 0.9rem + 0.4vw, 1.375rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #ffffff;
    line-height: 1.2;
    margin: 0 0 var(--space-3) 0;
  }

  .lightbox-caption {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 0.85rem + 0.2vw, 1.0625rem);
    line-height: 1.58;
    color: var(--colour-dark-ink);
    margin: 0 0 auto 0;
    user-select: text;
  }

  @media (max-width: 899px) {
    .lightbox-category {
      margin-top: 0;
    }

    .lightbox-caption {
      margin-bottom: 0;
    }
  }

  /* Drawer Footer Controls */
  .drawer-footer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--colour-dark-border);
    flex-shrink: 0;
  }

  .lightbox-pill-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-xs);
    background-color: var(--colour-dark-elevated);
    border: 1px solid var(--colour-dark-border-strong);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-out),
      border-color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
    touch-action: manipulation;
  }

  .lightbox-pill-btn:hover {
    background-color: var(--colour-dark-elevated-hover);
    border-color: var(--colour-dark-border-hover);
    transform: translateY(-1px);
  }

  .lightbox-pill-btn.is-primary {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
  }

  .lightbox-pill-btn.is-primary:hover {
    background-color: var(--colour-primary-hover);
    border-color: var(--colour-primary-hover);
  }

  .lightbox-pill-btn:focus-visible {
    outline: 2.5px solid var(--colour-primary-light);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-close-btn,
    .lightbox-pill-btn {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  interface GalleryItemData {
    src: string;
    alt: string;
    badge: string;
    category: string;
    title: string;
    caption: string;
  }

  let galleryItems: GalleryItemData[] = [];
  let currentIndex = 0;
  let isBackdropMousedown = false;

  const lightbox = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
  const backdropWrap = document.querySelector<HTMLElement>('.lightbox-backdrop-wrap');
  const stageEl = document.getElementById('lightbox-stage');
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const counterEl = document.getElementById('lightbox-counter');
  const categoryEl = document.getElementById('lightbox-category');
  const titleEl = document.getElementById('lightbox-title');
  const captionEl = document.getElementById('lightbox-caption');
  const storyBodyEl = document.getElementById('lightbox-story-body');

  const prefersReducedMotion = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initGalleryData() {
    const tiles = document.querySelectorAll<HTMLElement>('[data-gallery-tile]');
    galleryItems = Array.from(tiles).map((tile) => ({
      src: tile.dataset.src || '',
      alt: tile.dataset.alt || '',
      badge: tile.dataset.badge || '',
      category: tile.dataset.category || '',
      title: tile.dataset.title || '',
      caption: tile.dataset.caption || '',
    }));
  }

  function populateItem(index: number) {
    if (!galleryItems.length || !imgEl) return;
    const item = galleryItems[index];

    imgEl.src = item.src;
    imgEl.alt = item.alt;

    const total = String(galleryItems.length).padStart(2, '0');
    const num = item.badge || String(index + 1).padStart(2, '0');
    if (counterEl) counterEl.textContent = `${num} / ${total}`;
    if (categoryEl) categoryEl.textContent = item.category;
    if (titleEl) titleEl.textContent = item.title;
    if (captionEl) captionEl.textContent = item.caption;
    if (storyBodyEl) storyBodyEl.scrollTop = 0;
  }

  function animateStep(direction: 'next' | 'prev') {
    if (prefersReducedMotion()) return;
    const offset = direction === 'next' ? 14 : -14;

    imgEl?.animate(
      [
        { opacity: 0.35, transform: `translateX(${offset}px) scale(0.985)` },
        { opacity: 1, transform: 'translateX(0) scale(1)' },
      ],
      { duration: 220, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
    );

    storyBodyEl?.animate(
      [
        { opacity: 0, transform: 'translateY(8px)' },
        { opacity: 1, transform: 'translateY(0)' },
      ],
      { duration: 240, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
    );
  }

  async function openLightbox(index: number, triggerEl: HTMLElement) {
    if (!lightbox || !imgEl) return;
    if (!galleryItems.length) initGalleryData();

    const sourceImg = triggerEl.querySelector<HTMLElement>('img');
    const firstRect = sourceImg?.getBoundingClientRect() ?? triggerEl.getBoundingClientRect();

    currentIndex = index;
    populateItem(index);

    if (typeof lightbox.showModal === 'function') {
      lightbox.showModal();
    } else {
      lightbox.setAttribute('open', 'true');
    }

    closeBtn?.focus();

    if (prefersReducedMotion()) return;

    storyBodyEl?.animate(
      [
        { opacity: 0, transform: 'translateY(10px)' },
        { opacity: 1, transform: 'translateY(0)' },
      ],
      { duration: 300, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
    );

    // Wait briefly for decoded dimensions so FLIP has accurate target bounds
    await imgEl.decode().catch(() => {});
    const lastRect = imgEl.getBoundingClientRect();

    if (firstRect.width > 10 && lastRect.width > 10 && lastRect.height > 10) {
      const dx = firstRect.left + firstRect.width / 2 - (lastRect.left + lastRect.width / 2);
      const dy = firstRect.top + firstRect.height / 2 - (lastRect.top + lastRect.height / 2);
      const sx = Math.max(0.15, Math.min(1.5, firstRect.width / lastRect.width));
      const sy = Math.max(0.15, Math.min(1.5, firstRect.height / lastRect.height));
      const scale = Math.min(sx, sy);

      imgEl.animate(
        [
          { transform: `translate(${dx}px, ${dy}px) scale(${scale})`, opacity: 0.65 },
          { transform: 'translate(0, 0) scale(1)', opacity: 1 },
        ],
        { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
    } else {
      imgEl.animate(
        [
          { transform: 'scale(0.95)', opacity: 0.4 },
          { transform: 'scale(1)', opacity: 1 },
        ],
        { duration: 240, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
    }
  }

  function closeLightbox() {
    if (!lightbox) return;
    if (typeof lightbox.close === 'function') {
      lightbox.close();
    } else {
      lightbox.removeAttribute('open');
    }
  }

  function showNext() {
    if (!galleryItems.length) return;
    currentIndex = (currentIndex + 1) % galleryItems.length;
    populateItem(currentIndex);
    animateStep('next');
  }

  function showPrev() {
    if (!galleryItems.length) return;
    currentIndex = (currentIndex - 1 + galleryItems.length) % galleryItems.length;
    populateItem(currentIndex);
    animateStep('prev');
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const tile = target.closest<HTMLElement>('[data-gallery-tile]');
    if (tile) {
      const indexStr = tile.dataset.index;
      const index = indexStr !== undefined ? parseInt(indexStr, 10) : 0;
      openLightbox(index, tile);
    }
  });

  closeBtn?.addEventListener('click', closeLightbox);
  prevBtn?.addEventListener('click', showPrev);
  nextBtn?.addEventListener('click', showNext);

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!lightbox?.hasAttribute('open')) return;

    if (e.key === 'ArrowRight') {
      e.preventDefault();
      showNext();
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      showPrev();
    }
  });

  // Safe backdrop click handling (handles clicks outside the card)
  lightbox?.addEventListener('mousedown', (e) => {
    isBackdropMousedown = e.target === lightbox || e.target === backdropWrap;
  });

  lightbox?.addEventListener('mouseup', (e) => {
    if (isBackdropMousedown && (e.target === lightbox || e.target === backdropWrap)) {
      closeLightbox();
    }
    isBackdropMousedown = false;
  });

  // Touch Swipe gestures on image stage
  let touchStartX = 0;

  stageEl?.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.changedTouches[0].screenX;
    },
    { passive: true }
  );

  stageEl?.addEventListener(
    'touchend',
    (e) => {
      const diff = e.changedTouches[0].screenX - touchStartX;
      if (Math.abs(diff) > 50) {
        if (diff < 0) showNext();
        else showPrev();
      }
    },
    { passive: true }
  );

  initGalleryData();
</script>
