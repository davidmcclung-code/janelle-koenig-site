---
import { getImage } from 'astro:assets';
import { siteConfig } from '../data/siteConfig';
import events from '../data/events.json';
import { asset } from '../utils/paths';
import defaultOgImg from '../assets/photography/hero/janelle-hero.png';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const optimizedOgImage = await getImage({
  src: defaultOgImg,
  width: 960,
  format: 'jpeg',
  quality: 85,
});

const {
  title = `${siteConfig.name} – ${siteConfig.role}`,
  description = `${siteConfig.name} is an Australian comedian, professional MC, and panel host. Quick wit. Calm hands. Zero beige.`,
  image = optimizedOgImage.src,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://janellekoenig.com');

// JSON-LD Structured Data
const jsonLdPerson = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: ['Comedian', 'Master of Ceremonies', 'Panel Moderator', 'Writer'],
  description: siteConfig.heroSubhead,
  url: canonicalURL.toString(),
  sameAs: siteConfig.socialLinks.map((s) => s.url),
};

const monthMap: Record<string, string> = {
  JAN: '01', FEB: '02', MAR: '03', APR: '04', MAY: '05', JUN: '06',
  JUL: '07', AUG: '08', SEP: '09', OCT: '10', NOV: '11', DEC: '12',
};

const currentYear = new Date().getFullYear();

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';

const jsonLdEvents =
  isHomePage && Array.isArray(events)
    ? events
        .filter(
          (event) =>
            event &&
            event.ticketUrl &&
            event.ticketUrl !== '#tickets-placeholder' &&
            event.day &&
            event.month &&
            monthMap[event.month.toUpperCase()]
        )
        .map((event) => {
          const monthNum = monthMap[event.month.toUpperCase()];
          const dayNum = String(event.day).padStart(2, '0');
          const eventYear = event.year || String(currentYear);
          return {
            '@context': 'https://schema.org',
            '@type': 'Event',
            name: `${siteConfig.name} at ${event.title}`,
            startDate: `${eventYear}-${monthNum}-${dayNum}`,
            location: {
              '@type': 'Place',
              name: event.venue,
              address: event.location,
            },
            performer: {
              '@type': 'Person',
              name: siteConfig.name,
            },
          };
        })
    : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, canonicalURL)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, canonicalURL)} />

<!-- Google Fonts Preconnect & Stylesheet -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800;900&display=swap"
/>

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
{jsonLdEvents.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdEvents)} />
)}
