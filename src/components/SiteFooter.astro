---
import { siteConfig } from '../data/siteConfig';
import BrandLogo from './BrandLogo.astro';
import { asset } from '../utils/paths';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site Footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Bio Column -->
      <div class="footer-brand-col">
        <a href={asset('/')} class="footer-logo-link" aria-label="Janelle Koenig Home">
          <BrandLogo variant="light" />
        </a>
        <p class="footer-bio wrap-break">
          Comedian. Writer. Indoors enthusiast.<br />
          Noodle aficionado.
        </p>
      </div>

      <!-- Explore Column -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">EXPLORE</h3>
        <ul class="footer-links">
          <li><a href={asset('/#shows')} class="footer-link">Shows</a></li>
          <li><a href={asset('/#watch')} class="footer-link">Watch</a></li>
          <li><a href={asset('/#about')} class="footer-link">About</a></li>
          <li><a href={asset('/#mc-events')} class="footer-link">MC & Events</a></li>
          <li><a href={asset('/photos')} class="footer-link">Gallery</a></li>
        </ul>
      </div>

      <!-- Follow & Enquiries Group (splits into 2 columns on mobile) -->
      <div class="footer-secondary-cols">
        <!-- Follow Column -->
        <div class="footer-social-col">
          <h3 class="footer-heading">FOLLOW</h3>
          <div class="footer-social-icons">
            <!-- Instagram -->
            <a
              href={siteConfig.socialLinks.find((s) => s.platform === 'instagram')?.url || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Follow Janelle on Instagram (opens in a new tab)"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>

            <!-- Facebook -->
            <a
              href={siteConfig.socialLinks.find((s) => s.platform === 'facebook')?.url || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Follow Janelle on Facebook (opens in a new tab)"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z"/>
              </svg>
            </a>

            <!-- TikTok -->
            <a
              href={siteConfig.socialLinks.find((s) => s.platform === 'tiktok')?.url || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Follow Janelle on TikTok (opens in a new tab)"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.32-6.32V8.2a8.16 8.16 0 0 0 4.91 1.63v-3.14z"/>
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href={siteConfig.socialLinks.find((s) => s.platform === 'youtube')?.url || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Follow Janelle on YouTube (opens in a new tab)"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- X / Twitter -->
            <a
              href={siteConfig.socialLinks.find((s) => s.platform === 'x')?.url || '#'}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-link"
              aria-label="Follow Janelle on X (opens in a new tab)"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Enquiries Column -->
        <div class="footer-contact-col">
          <h3 class="footer-heading">ENQUIRIES</h3>
          <div class="footer-contact-links">
            <a href={`mailto:${siteConfig.email}`} class="footer-contact-link wrap-break">
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Colophon / Copyright Bar -->
    <div class="footer-bottom">
      <p class="copyright-text wrap-break">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <div class="studio-credit wrap-break">
        <a
          href={siteConfig.studioCredit.url || 'https://www.mcclung.com.au'}
          target="_blank"
          rel="noopener noreferrer"
          class="credit-link"
          aria-label="Website by David McClung (opens in new tab)"
        >
          <span class="credit-label">{siteConfig.studioCredit.text}</span>
          <img
            src={asset('/images/logos/david-mcclung-logo.png')}
            alt="David McClung"
            class="credit-logo"
            width="84"
            height="48"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--colour-footer);
    color: #ffffff;
    padding-top: clamp(1.75rem, 2.5vw, 2.25rem);
    padding-bottom: max(2rem, calc(1.5rem + env(safe-area-inset-bottom, 0px)));
    position: relative;
    width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.25fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }

  @media (max-width: 639px) {
    .site-footer {
      padding-top: 1.35rem;
      padding-bottom: max(1.5rem, calc(1.25rem + env(safe-area-inset-bottom, 0px)));
    }

    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      gap: 16px 20px;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
      margin-bottom: 2px;
    }

    .footer-secondary-cols {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .footer-heading {
      font-size: 0.6875rem;
      margin-bottom: 6px;
    }

    .footer-link,
    .footer-contact-link {
      font-size: 0.8125rem;
      line-height: 1.35;
      padding: 6px 0;
    }

    .footer-social-icons {
      gap: 2px;
    }

    .footer-social-icons svg {
      width: 16px;
      height: 16px;
    }

    .footer-bottom {
      text-align: center;
      margin-top: 1.25rem;
      padding-bottom: 0.25rem;
      align-items: center;
      justify-content: center;
    }

    .credit-link {
      align-items: center;
    }
  }

  @media (min-width: 640px) {
    .footer-secondary-cols {
      display: contents;
    }
  }

  @media (min-width: 640px) and (max-width: 849px) {
    .site-footer {
      padding-top: 1.75rem;
      padding-bottom: max(1.75rem, calc(1.5rem + env(safe-area-inset-bottom, 0px)));
    }

    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-5);
    }

    .footer-brand-col {
      grid-column: 1 / -1;
      margin-bottom: var(--space-2);
    }
  }

  @media (min-width: 850px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.25fr;
      gap: clamp(20px, 3vw, 40px);
    }

    .footer-brand-col {
      grid-column: auto;
      margin-bottom: 0;
    }
  }

  /* Logo */
  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    margin-bottom: 8px;
  }

  .footer-logo-link :global(.brand-logo-img),
  .footer-logo-link :global(img) {
    width: 115px !important;
    max-width: 115px;
    height: auto !important;
    display: block;
  }

  .footer-bio {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  /* Headings */
  .footer-heading {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: var(--colour-primary);
    margin-top: 0;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  /* Navigation Links */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.35;
    padding: 6px 0;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  /* Social Icons */
  .footer-social-icons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px;
    margin-left: -8px;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 10px;
    border-radius: var(--radius-xs);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    line-height: 1;
    transition: color var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out),
                background-color var(--motion-fast) var(--ease-out);
  }

  .social-icon-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
    transform: translateY(-1.5px);
  }

  /* Contact Links */
  .footer-contact-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-contact-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.35;
    padding: 6px 0;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-contact-link:hover {
    color: #ffffff;
  }

  /* Bottom Colophon */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: clamp(1.25rem, 1.75vw, 1.5rem);
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.5);
  }

  .copyright-text,
  .studio-credit {
    margin: 0;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .studio-credit {
    display: inline-flex;
    align-items: center;
  }

  .credit-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    line-height: 1;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .credit-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.5);
    transition: color var(--motion-fast) var(--ease-out);
    white-space: nowrap;
  }

  .credit-logo {
    display: block;
    width: auto;
    height: 28px;
    max-height: 30px;
    filter: brightness(0) invert(1);
    opacity: 0.75;
    transition: opacity var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out);
  }

  .credit-link:hover {
    transform: translateY(-1px);
  }

  .credit-link:hover .credit-label {
    color: rgba(255, 255, 255, 0.9);
  }

  .credit-link:hover .credit-logo {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .credit-link:hover {
      transform: none;
    }
  }
</style>
