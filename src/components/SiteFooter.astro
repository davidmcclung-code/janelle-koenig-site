---
import { siteConfig } from '../data/siteConfig';
import BrandLogo from './BrandLogo.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer" aria-label="Site Footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Bio Column -->
      <div class="footer-brand-col">
        <a href="#" class="footer-logo-link" aria-label="Janelle Koenig Home">
          <BrandLogo variant="light" />
        </a>
        <p class="footer-bio wrap-break">
          Comedian. Writer. Indoors enthusiast.<br />
          Noodle aficionado.
        </p>
      </div>

      <!-- Explore Column -->
      <div class="footer-nav-col">
        <h3 class="footer-heading">EXPLORE</h3>
        <ul class="footer-links">
          <li><a href="#shows" class="footer-link">Shows</a></li>
          <li><a href="#watch" class="footer-link">Watch</a></li>
          <li><a href="#about" class="footer-link">About</a></li>
          <li><a href="#mc-events" class="footer-link">MC & Events</a></li>
        </ul>
      </div>

      <!-- Follow Column -->
      <div class="footer-social-col">
        <h3 class="footer-heading">FOLLOW</h3>
        <div class="footer-social-icons">
          <!-- Instagram -->
          <a
            href={siteConfig.socialLinks.find((s) => s.platform === 'instagram')?.url || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-link"
            aria-label="Follow Janelle on Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <!-- Facebook -->
          <a
            href={siteConfig.socialLinks.find((s) => s.platform === 'facebook')?.url || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-link"
            aria-label="Follow Janelle on Facebook"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
          </a>

          <!-- TikTok -->
          <a
            href={siteConfig.socialLinks.find((s) => s.platform === 'tiktok')?.url || '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="social-icon-link"
            aria-label="Follow Janelle on TikTok"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.32-6.32V8.2a8.16 8.16 0 0 0 4.91 1.63v-3.14z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Enquiries Column -->
      <div class="footer-contact-col">
        <h3 class="footer-heading">ENQUIRIES</h3>
        <div class="footer-contact-links">
          <div class="footer-email-row">
            <a href={`mailto:${siteConfig.email}`} class="footer-contact-link wrap-break">
              {siteConfig.email}
            </a>
            <button
              type="button"
              class="footer-copy-btn"
              data-copy-email={siteConfig.email}
              aria-label="Copy email address"
              title="Copy email to clipboard"
            >
              <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <svg class="check-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </button>
            <span class="footer-copy-toast" role="status" aria-live="polite">
              Copied! (Zero small talk required)
            </span>
          </div>
          <a href={`tel:${siteConfig.phone.replace(/\s/g, '')}`} class="footer-contact-link">
            {siteConfig.phone}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Colophon / Copyright Bar -->
    <div class="footer-bottom">
      <p class="copyright-text wrap-break">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <p class="studio-credit wrap-break">
        {
          siteConfig.studioCredit.url ? (
            <a href={siteConfig.studioCredit.url} target="_blank" rel="noopener noreferrer" class="credit-link">
              {siteConfig.studioCredit.text}
            </a>
          ) : (
            siteConfig.studioCredit.text
          )
        }
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--colour-footer);
    color: #ffffff;
    padding-top: clamp(1.75rem, 2.5vw, 2.25rem);
    padding-bottom: max(2rem, calc(1.5rem + env(safe-area-inset-bottom, 0px)));
    position: relative;
    width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.25fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }

  @media (max-width: 639px) {
    .site-footer {
      padding-top: 1.35rem;
      padding-bottom: max(1.5rem, calc(1.25rem + env(safe-area-inset-bottom, 0px)));
    }

    .footer-grid {
      grid-template-columns: 0.9fr 0.9fr 1.2fr;
      gap: 14px 10px;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
      margin-bottom: 2px;
    }

    .footer-heading {
      font-size: 0.6875rem;
      margin-bottom: 5px;
    }

    .footer-link,
    .footer-contact-link {
      font-size: 0.72rem;
      line-height: 1.3;
    }

    .footer-social-icons {
      gap: 8px;
    }

    .footer-social-icons svg {
      width: 16px;
      height: 16px;
    }

    .footer-bottom {
      text-align: center;
      margin-top: 1.25rem;
      padding-bottom: 0.25rem;
    }
  }

  @media (min-width: 640px) and (max-width: 849px) {
    .site-footer {
      padding-top: 1.75rem;
      padding-bottom: max(1.75rem, calc(1.5rem + env(safe-area-inset-bottom, 0px)));
    }

    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5);
    }
  }

  @media (min-width: 850px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.25fr;
      gap: clamp(20px, 3vw, 40px);
    }
  }

  /* Logo */
  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 1;
    margin-bottom: 8px;
  }

  .footer-logo-link :global(.brand-logo-img),
  .footer-logo-link :global(img) {
    width: 115px !important;
    max-width: 115px;
    height: auto !important;
    display: block;
  }

  .footer-bio {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  /* Headings */
  .footer-heading {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: var(--colour-primary);
    margin-top: 0;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  /* Navigation Links */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  /* Social Icons */
  .footer-social-icons {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    line-height: 1;
    transition: color var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out);
  }

  .social-icon-link:hover {
    color: #ffffff;
    transform: translateY(-1.5px);
  }

  /* Contact Links */
  .footer-contact-links {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .footer-contact-link {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-contact-link:hover {
    color: #ffffff;
  }

  /* Bottom Colophon */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: clamp(1.25rem, 1.75vw, 1.5rem);
    font-size: 0.75rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.5);
  }

  .copyright-text,
  .studio-credit {
    margin: 0;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .studio-credit {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.75rem;
  }

  .credit-link {
    color: inherit;
    text-decoration: underline;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .credit-link:hover {
    color: #ffffff;
  }

  /* Copy Email Button & Micro-Toast */
  .footer-email-row {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
  }

  .footer-copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    min-width: 22px;
    padding: 0;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-xs);
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    line-height: 1;
    transition: background-color var(--motion-fast) var(--ease-out),
                border-color var(--motion-fast) var(--ease-out),
                color var(--motion-fast) var(--ease-out),
                transform var(--motion-fast) var(--ease-out);
  }

  .footer-copy-btn:hover {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .footer-copy-btn .copy-icon {
    display: block;
  }

  .footer-copy-btn .check-icon {
    display: none;
  }

  .footer-copy-btn.is-copied {
    background-color: var(--colour-primary);
    border-color: var(--colour-primary);
    color: #ffffff;
  }

  .footer-copy-btn.is-copied .copy-icon {
    display: none;
  }

  .footer-copy-btn.is-copied .check-icon {
    display: block;
  }

  .footer-copy-toast {
    display: none;
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.2;
    padding: 5px 9px;
    border-radius: var(--radius-xs);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.2);
    white-space: nowrap;
    pointer-events: none;
    z-index: 50;
  }

  .footer-copy-toast.is-visible {
    display: block;
    animation: toastFadeIn 200ms var(--ease-out) forwards;
  }

  @keyframes toastFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 639px) {
    .footer-copy-toast {
      left: auto;
      right: 0;
      font-size: 0.68rem;
      padding: 4px 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-copy-toast.is-visible {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  function setupFooterCopy() {
    const copyBtns = document.querySelectorAll<HTMLButtonElement>('.footer-copy-btn[data-copy-email]');
    copyBtns.forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        const text = btn.getAttribute('data-copy-email') || '';
        if (!text) return;

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.opacity = '0';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
          }

          btn.classList.add('is-copied');
          const toast = btn.parentElement?.querySelector('.footer-copy-toast');
          if (toast) {
            toast.classList.add('is-visible');
          }

          setTimeout(() => {
            btn.classList.remove('is-copied');
            if (toast) {
              toast.classList.remove('is-visible');
            }
          }, 2400);
        } catch (err) {
          console.error('Failed to copy email:', err);
        }
      });
    });
  }

  setupFooterCopy();
  document.addEventListener('astro:page-load', setupFooterCopy);
</script>
