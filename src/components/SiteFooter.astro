---
import { siteConfig } from '../data/siteConfig';
import BrandLogo from './BrandLogo.astro';
import SocialIcon from './SocialIcon.astro';
import { asset } from '../utils/paths';
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import creditLogoImg from '../assets/logos/david-mcclung-logo.png';

const currentYear = new Date().getFullYear();
const creditLogoSources = await createResponsiveSourceSet(creditLogoImg, [100, 200], 'png');
---

<footer class="site-footer" aria-label="Site Footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Bio Column -->
      <div class="footer-brand-col">
        <a href={asset('/')} class="footer-logo-link" aria-label="Janelle Koenig Home">
          <BrandLogo variant="light" loading="lazy" />
        </a>
        <p class="footer-bio wrap-break">
          Comedian. Writer. Indoor enthusiast.<br />
          Noodle aficionado.
        </p>
      </div>

      <!-- Explore Column -->
      <div class="footer-nav-col">
        <h2 class="footer-heading">EXPLORE</h2>
        <ul class="footer-links" role="list">
          <li><a href={asset('/#shows')} class="footer-link">Shows</a></li>
          <li><a href={asset('/about')} class="footer-link">About</a></li>
          <li><a href={asset('/mc-events')} class="footer-link">MC &amp; Events</a></li>
          <li><a href={asset('/photos')} class="footer-link">Gallery</a></li>
        </ul>
      </div>

      <!-- Follow & Enquiries Group -->
      <div class="footer-secondary-cols">
        <div class="footer-social-col">
          <h2 class="footer-heading">FOLLOW</h2>
          <div class="footer-social-icons">
            {siteConfig.socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="social-icon-link"
                aria-label={`Follow Janelle on ${social.label} (opens in a new tab)`}
              >
                <SocialIcon platform={social.platform} size={18} />
              </a>
            ))}
          </div>
        </div>

        <div class="footer-contact-col">
          <h2 class="footer-heading">ENQUIRIES</h2>
          <div class="footer-contact-links">
            <a href={`mailto:${siteConfig.email}`} class="footer-contact-link">
              {siteConfig.email}
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div class="footer-bottom">
      <p class="copyright-text wrap-break">
        &copy; {currentYear} {siteConfig.name}. All rights reserved.
      </p>
      <div class="footer-bottom-right">
        <a href="#main-content" class="back-to-top-link">
          <span>Back to top</span>
          <span aria-hidden="true">↑</span>
        </a>
        <div class="studio-credit wrap-break">
          <a
            href={siteConfig.studioCredit.url || 'https://www.mcclung.com.au'}
            target="_blank"
            rel="noopener noreferrer"
            class="credit-link"
            aria-label="Website by David McClung (opens in new tab)"
          >
            <span class="credit-label">{siteConfig.studioCredit.text}</span>
            <picture style="display: contents;">
              <source
                type="image/avif"
                srcset={creditLogoSources.avifSrcset}
                sizes="55px"
              />
              <source
                type="image/webp"
                srcset={creditLogoSources.webpSrcset}
                sizes="55px"
              />
              <img
                src={creditLogoSources.fallbackSrc}
                srcset={creditLogoSources.fallbackSrcset}
                sizes="55px"
                alt="David McClung"
                class="credit-logo"
                width={creditLogoSources.width}
                height={creditLogoSources.height}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    --colour-focus: var(--colour-focus-on-dark);
    background-color: var(--colour-footer);
    color: #ffffff;
    padding-top: clamp(1.75rem, 2.5vw, 2.25rem);
    padding-bottom: max(2rem, calc(1.5rem + env(safe-area-inset-bottom, 0px)));
    position: relative;
    width: 100%;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.25fr;
    gap: clamp(20px, 3vw, 40px);
    align-items: start;
  }

  @media (max-width: 639px) {
    .site-footer {
      padding-top: 1.35rem;
      padding-bottom: max(1.5rem, calc(1.25rem + env(safe-area-inset-bottom, 0px)));
    }

    .footer-grid {
      grid-template-columns: minmax(0, 0.65fr) minmax(0, 1.45fr);
      gap: 16px 12px;
    }

    .footer-brand-col {
      grid-column: 1 / -1;
      margin-bottom: 2px;
    }

    .footer-secondary-cols {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .footer-heading {
      font-size: 0.6875rem;
      margin-bottom: 6px;
    }

    .footer-link,
    .footer-contact-link {
      font-size: 0.8125rem;
      line-height: 1.35;
      padding: 6px 0;
    }

    .footer-contact-link {
      font-size: clamp(0.72rem, 0.55rem + 0.8vw, 0.8125rem);
      white-space: nowrap;
    }

    .footer-social-icons svg {
      width: 16px;
      height: 16px;
    }

    .footer-bottom {
      text-align: center;
      margin-top: 1.25rem;
      padding-bottom: 0.25rem;
      align-items: center;
      justify-content: center;
    }

    .credit-link {
      align-items: center;
    }
  }

  @media (min-width: 640px) {
    .footer-secondary-cols {
      display: contents;
    }
  }

  @media (min-width: 640px) and (max-width: 849px) {
    .site-footer {
      padding-top: 1.75rem;
      padding-bottom: max(1.75rem, calc(1.5rem + env(safe-area-inset-bottom, 0px)));
    }

    .footer-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr) minmax(0, 1.15fr);
      gap: var(--space-5);
    }

    .footer-brand-col {
      grid-column: 1 / -1;
      margin-bottom: var(--space-2);
    }
  }

  @media (min-width: 850px) {
    .footer-grid {
      grid-template-columns: 1.75fr 0.95fr 1.35fr 1.25fr;
      gap: clamp(20px, 3vw, 40px);
    }

    .footer-brand-col {
      grid-column: auto;
      margin-bottom: 0;
    }
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    line-height: 1;
    margin-bottom: 8px;
  }

  .footer-logo-link :global(.brand-logo-img),
  .footer-logo-link :global(img) {
    width: 118px !important;
    max-width: 118px;
    height: auto !important;
    display: block;
    filter: brightness(2.05) saturate(0.78);
  }

  .footer-bio {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    color: var(--colour-primary-on-dark);
    margin-top: 0;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.35;
    padding: 6px 0;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .footer-link-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding-inline: 0;
    text-align: left;
  }

  .footer-social-icons {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 2px;
    margin-left: -10px;
  }

  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 10px;
    border-radius: var(--radius-xs);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    line-height: 1;
    transition:
      color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out),
      background-color var(--motion-fast) var(--ease-out);
  }

  .social-icon-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.08);
    transform: translateY(-1.5px);
  }

  @media (max-width: 639px) {
    .footer-social-icons {
      flex-wrap: wrap;
      gap: 3px;
      margin-left: -6px;
    }

    .social-icon-link {
      position: relative;
      min-width: 34px;
      min-height: 34px;
      padding: 6px;
    }

    .social-icon-link::after {
      content: '';
      position: absolute;
      inset: -5px;
    }
  }

  .footer-contact-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-contact-link {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.35;
    padding: 6px 0;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--motion-fast) var(--ease-out);
  }

  .footer-contact-link:hover {
    color: #ffffff;
  }

  @media (max-width: 849px), (pointer: coarse) {
    .footer-link,
    .footer-contact-link {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: clamp(1.5rem, 2.2vw, 1.85rem);
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--colour-footer-muted);
  }

  .footer-bottom-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .back-to-top-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 4px;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition:
      color var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .back-to-top-link:hover {
    color: #ffffff;
    transform: translateY(-1px);
  }

  .copyright-text,
  .studio-credit {
    margin: 0;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .footer-bottom-right {
      justify-content: flex-end;
      gap: var(--space-6);
    }
  }

  .studio-credit {
    display: inline-flex;
    align-items: center;
  }

  .credit-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    text-decoration: none;
    line-height: 1;
    transition: transform var(--motion-fast) var(--ease-out);
  }

  .credit-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--colour-footer-muted);
    transition: color var(--motion-fast) var(--ease-out);
    white-space: nowrap;
  }

  .credit-logo {
    display: block;
    width: auto;
    height: 28px;
    max-height: 30px;
    filter: brightness(0) invert(1);
    opacity: 0.75;
    transition:
      opacity var(--motion-fast) var(--ease-out),
      transform var(--motion-fast) var(--ease-out);
  }

  .credit-link:hover {
    transform: translateY(-1px);
  }

  .credit-link:hover .credit-label {
    color: rgba(255, 255, 255, 0.9);
  }

  .credit-link:hover .credit-logo {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .social-icon-link:hover,
    .credit-link:hover,
    .back-to-top-link:hover {
      transform: none;
    }
  }
</style>
