---
import { siteConfig } from '../data/siteConfig';
import { createResponsiveSourceSet } from '../utils/responsiveImage';
import substackCompactImg from '../assets/photography/substack/janelle-substack-compact.jpg';
import substackWideImg from '../assets/photography/substack/janelle-substack-wide.png';

interface Props {
  imageSrc?: string;
}

const { imageSrc } = Astro.props;

const substackCompactSources = await createResponsiveSourceSet(
  substackCompactImg,
  [320, 480, 640, 800],
  'jpeg'
);

const substackWideSources = await createResponsiveSourceSet(
  substackWideImg,
  [480, 640, 800, 960, 1280],
  'png'
);
---

<section class="substack-section" id="about" aria-label="Janelle's Substack Writing">
  <div class="substack-grid reveal">
    <!-- Left Content Column (~50% width) -->
    <div class="substack-content">
      <div class="substack-content-inner">
        <!-- Large Illustrated "Indoors Club" Mug with 3 Red Burst Lines -->
        <div class="mug-illustration-wrapper" aria-hidden="true">
          <svg class="mug-svg" width="84" height="96" viewBox="0 -10 90 110" fill="none">
            <!-- 3 Radiant Red Steam Lines -->
            <g class="burst-lines" stroke="var(--colour-primary)" stroke-width="3.2" stroke-linecap="round">
              <path class="steam-line steam-left" d="M26 21 C24 16 19 14 17 9" />
              <path class="steam-line steam-center" d="M38 19 C39 15 37 11 38 7" />
              <path class="steam-line steam-right" d="M50 21 C52 16 57 14 59 9" />
            </g>
            <!-- Illustrated Ceramic Mug Body -->
            <rect x="12" y="24" width="52" height="60" rx="8" fill="#ffffff" stroke="#121212" stroke-width="3.5" />
            <!-- Mug Handle -->
            <path d="M64 34 C76 34 82 42 82 54 C82 66 76 74 64 74" fill="none" stroke="#121212" stroke-width="3.5" stroke-linecap="round" />
            <!-- Mug Text -->
            <text x="38" y="52" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="8.5" fill="#121212" text-anchor="middle" letter-spacing="0.6">INDOORS</text>
            <text x="38" y="65" font-family="'Plus Jakarta Sans', Arial, sans-serif" font-weight="900" font-size="8.5" fill="#121212" text-anchor="middle" letter-spacing="0.6">CLUB</text>
          </svg>
        </div>

        <!-- Text Block Beside the Mug -->
        <div class="substack-text-block">
          <h2 class="font-script text-script-section substack-title wrap-break">
            Apparently she writes too.
          </h2>

          <p class="substack-desc wrap-break">
            More Janelle, but with considerably<br class="desc-break" />less standing up.
          </p>

          <div class="substack-actions">
            <a
              href={siteConfig.substackUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary substack-btn"
            >
              <span>READ THE SUBSTACK</span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <!-- Substack Underline Flourish -->
            <svg class="substack-underline" viewBox="0 0 160 8" fill="none" aria-hidden="true">
              <path class="underline-path" d="M3 5C45 2.5 115 2.5 157 5" stroke="var(--colour-primary)" stroke-width="2.5" stroke-linecap="round" />
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Media Column (~50% width) -->
    <div class="substack-media">
      {imageSrc ? (
        <img
          src={imageSrc}
          alt="Janelle Koenig writing at a table"
          width="900"
          height="550"
          loading="lazy"
          decoding="async"
          class="substack-img"
        />
      ) : (
        <picture class="substack-picture">
          <!-- Wide variant (720px and above) -->
          <source
            media="(min-width: 720px)"
            type="image/avif"
            srcset={substackWideSources.avifSrcset}
            sizes="(min-width: 1280px) 640px, (min-width: 850px) 50vw, 46vw"
          />
          <source
            media="(min-width: 720px)"
            type="image/webp"
            srcset={substackWideSources.webpSrcset}
            sizes="(min-width: 1280px) 640px, (min-width: 850px) 50vw, 46vw"
          />
          <source
            media="(min-width: 720px)"
            srcset={substackWideSources.fallbackSrcset}
            sizes="(min-width: 1280px) 640px, (min-width: 850px) 50vw, 46vw"
          />

          <!-- Compact variant (below 720px) -->
          <source
            type="image/avif"
            srcset={substackCompactSources.avifSrcset}
            sizes="(min-width: 600px) 46vw, 45vw"
          />
          <source
            type="image/webp"
            srcset={substackCompactSources.webpSrcset}
            sizes="(min-width: 600px) 46vw, 45vw"
          />
          <img
            src={substackCompactSources.fallbackSrc}
            srcset={substackCompactSources.fallbackSrcset}
            sizes="(min-width: 600px) 46vw, 45vw"
            alt="Janelle Koenig writing at a table"
            width={substackCompactSources.width}
            height={substackCompactSources.height}
            loading="lazy"
            decoding="async"
            class="substack-img"
          />
        </picture>
      )}
    </div>
  </div>
</section>

<style>
  .substack-section {
    width: 100%;
    margin-top: 0;
    margin-bottom: 0;
    border: none;
    display: block;
    line-height: 0;
    position: relative;
    background-color: #faf0e7;
    overflow: hidden;
  }

  .substack-grid {
    display: grid;
    grid-template-columns: 54% 46%;
    align-items: stretch;
    min-height: 175px;
    height: 175px;
    width: 100%;
    max-width: var(--container-max-width);
    margin-inline: auto;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 850px) {
    .substack-grid {
      grid-template-columns: 50% 50%;
      height: 190px;
      min-height: 190px;
      max-height: 190px;
    }

    .substack-media::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: 100px;
      background: linear-gradient(to right, #faf0e7 0%, rgba(250, 240, 231, 0) 100%);
      z-index: 2;
      pointer-events: none;
    }
  }

  .substack-content {
    line-height: normal;
    padding-left: var(--container-gutter);
    padding-right: clamp(1rem, 2vw, 2.5rem);
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    z-index: 2;
  }

  .substack-content-inner {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 24px);
  }

  /* Large Illustrated Indoors Club Mug */
  .mug-illustration-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: visible;
  }

  .mug-svg {
    width: clamp(68px, 6.8vw, 84px);
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.06));
    transition: transform var(--motion-fast) var(--ease-out);
    transform-origin: bottom center;
  }

  .substack-content:hover .mug-svg {
    transform: rotate(-2deg) scale(1.02);
  }

  .burst-lines {
    transition: transform var(--motion-fast) var(--ease-out);
    transform-origin: 38px 24px;
  }

  .steam-line {
    transform-origin: 38px 24px;
    will-change: transform, opacity;
  }

  /* Gentle staggered steam waft when in view */
  :global(.reveal.is-visible) .steam-left {
    animation: steamWaft 2.6s ease-in-out infinite;
    animation-delay: 0ms;
  }

  :global(.reveal.is-visible) .steam-center {
    animation: steamWaft 2.6s ease-in-out infinite;
    animation-delay: 450ms;
  }

  :global(.reveal.is-visible) .steam-right {
    animation: steamWaft 2.6s ease-in-out infinite;
    animation-delay: 900ms;
  }

  @keyframes steamWaft {
    0%, 100% {
      transform: translateY(0) scaleY(0.95);
      opacity: 0.7;
    }
    50% {
      transform: translateY(-2px) scaleY(1.08);
      opacity: 1;
    }
  }

  .substack-content:hover .burst-lines,
  .mug-illustration-wrapper:hover .burst-lines {
    transform: translateY(-1px);
  }

  .substack-content:hover .steam-left,
  .mug-illustration-wrapper:hover .steam-left {
    animation-duration: 1.8s;
  }

  .substack-content:hover .steam-center,
  .mug-illustration-wrapper:hover .steam-center {
    animation-duration: 1.8s;
  }

  .substack-content:hover .steam-right,
  .mug-illustration-wrapper:hover .steam-right {
    animation-duration: 1.8s;
  }

  .substack-text-block {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .substack-title {
    color: var(--colour-primary);
    transform: rotate(-1deg);
    display: inline-block;
    font-size: clamp(1.4rem, 2vw, 1.7rem);
    line-height: 1.1;
    margin: 0 0 14px 0;
  }

  .substack-desc {
    font-family: var(--font-body);
    font-size: clamp(0.8125rem, 0.95vw, 0.875rem);
    line-height: 1.4;
    color: var(--colour-ink-subtle);
    font-weight: 500;
    max-width: 335px;
    margin: 0;
  }

  .desc-break {
    display: inline;
  }

  .substack-actions {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 17px;
  }

  .substack-btn {
    height: 34px;
    min-height: 34px;
    padding: 0.35rem 0.95rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .substack-underline {
    display: block;
    width: 100%;
    max-width: 165px;
    height: 6px;
    margin-top: 3px;
    overflow: visible;
  }

  .underline-path {
    stroke-dasharray: 160;
    stroke-dashoffset: 0;
  }

  :global(.js .reveal:not(.is-visible)) .underline-path {
    stroke-dashoffset: 160;
  }

  :global(.reveal.is-visible) .underline-path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 750ms var(--ease-out) 120ms;
  }

  /* Right Media Column */
  .substack-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .substack-picture {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Independent focal-position for Substack image */
  .substack-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 55% 30%;
  }

  @media (max-width: 719px) {
    .substack-img {
      object-position: 55% 18%;
    }
  }

  @media (max-width: 849px) {
    .substack-content-inner {
      gap: clamp(10px, 1.8vw, 16px);
      width: 100%;
    }

    .mug-svg {
      width: clamp(48px, 6.5vw, 56px);
    }

    .substack-title {
      font-size: clamp(1.3rem, 2.2vw, 1.55rem);
      margin-bottom: 8px;
    }

    .substack-actions {
      margin-top: 12px;
    }
  }

  @media (max-width: 600px) {
    .substack-grid {
      grid-template-columns: 55% 45%;
      height: 165px;
      min-height: 165px;
    }

    .substack-content {
      padding-left: var(--container-gutter);
      padding-right: 0.5rem;
    }

    .substack-text-block {
      min-width: 0;
      width: 100%;
    }

    .substack-title {
      font-size: 1.25rem;
      margin-bottom: 6px;
    }

    .substack-desc {
      font-size: 0.72rem;
      line-height: 1.35;
      max-width: 100%;
    }

    .substack-actions {
      margin-top: 10px;
      max-width: 100%;
    }

    .substack-btn {
      height: 30px;
      min-height: 30px;
      padding: 0.25rem 0.65rem;
      font-size: 0.65rem;
      gap: 5px;
      letter-spacing: 0.04em;
    }

    .substack-btn svg {
      width: 11px;
      height: 11px;
    }

    .substack-underline {
      max-width: 120px;
      width: 100%;
      margin-top: 2px;
      height: 5px;
    }

    :global(.reveal.is-visible) .underline-path {
      transition-duration: 600ms;
      transition-delay: 100ms;
    }

    .substack-img {
      object-position: 52% 20%;
    }
  }

  @media (max-width: 540px) {
    .mug-illustration-wrapper {
      display: none;
    }

    .substack-content-inner {
      gap: 0;
    }
  }

  @media (max-width: 380px) {
    .substack-title {
      font-size: 1.15rem;
      margin-bottom: 5px;
    }

    .substack-desc {
      font-size: 0.68rem;
    }

    .substack-btn {
      font-size: 0.6rem;
      padding: 0.2rem 0.55rem;
    }

    .substack-underline {
      max-width: 110px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .underline-path,
    :global(.js .reveal:not(.is-visible)) .underline-path {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }

    .steam-line,
    .steam-left,
    .steam-center,
    .steam-right,
    :global(.reveal.is-visible) .steam-left,
    :global(.reveal.is-visible) .steam-center,
    :global(.reveal.is-visible) .steam-right {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>
