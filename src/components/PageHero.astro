---
import type { ImageMetadata } from 'astro';
import BurstMark from './BurstMark.astro';
import { createResponsiveSourceSet } from '../utils/responsiveImage';

export interface Props {
  id: string;
  eyebrow: string;
  titleLines: string[];
  lead?: string;
  image: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
}

const {
  id,
  eyebrow,
  titleLines,
  lead,
  image,
  imageAlt,
  imagePosition = 'center top',
} = Astro.props;

const heroCutoutSources = await createResponsiveSourceSet(image, [320, 480, 682], 'png');
const imageSizes = '(min-width: 1024px) 240px, (min-width: 768px) 200px, 32vw';
---

<section class="page-hero-section" aria-labelledby={id}>
  <div class="container page-hero-grid">
    <div class="page-hero-content">
      <span class="font-script text-script-section page-hero-eyebrow">
        {eyebrow}
      </span>

      <h1 id={id} class="page-hero-heading">
        {titleLines.map((line, index) => (
          <span class="heading-line" style={`--line-idx: ${index};`}>
            {line}
            {index === titleLines.length - 1 && <span class="red-sq" aria-hidden="true"></span>}
          </span>
        ))}
      </h1>

      <p class="page-hero-lead wrap-break">
        <slot name="lead">{lead}</slot>
      </p>
    </div>

    <div class="page-hero-media">
      <figure class="page-hero-figure">
        <div class="hero-popout-stage">
          <div class="page-hero-burst" aria-hidden="true">
            <BurstMark animated={true} strokeWidth={3} />
          </div>

          <div class="hero-popout-card" aria-hidden="true"></div>

          <div class="hero-popout-cutout">
            <picture>
              <source
                type="image/avif"
                srcset={heroCutoutSources.avifSrcset}
                sizes={imageSizes}
                width={heroCutoutSources.width}
                height={heroCutoutSources.height}
              />
              <source
                type="image/webp"
                srcset={heroCutoutSources.webpSrcset}
                sizes={imageSizes}
                width={heroCutoutSources.width}
                height={heroCutoutSources.height}
              />
              <img
                src={heroCutoutSources.fallbackSrc}
                srcset={heroCutoutSources.fallbackSrcset}
                sizes={imageSizes}
                alt={imageAlt}
                width={heroCutoutSources.width}
                height={heroCutoutSources.height}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="hero-cutout-img"
                style={`object-position: ${imagePosition};`}
              />
            </picture>
          </div>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .page-hero-section {
    background: var(--gradient-hero-warm);
    padding-block-start: calc(var(--header-height) + clamp(1rem, 2.2vw, 1.65rem));
    padding-block-end: clamp(1.5rem, 3vw, 2.15rem);
    padding-inline: 0;
    position: relative;
    overflow: clip;
    width: 100%;
  }

  .page-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 4.5vw, 3.75rem);
    align-items: center;
  }

  .page-hero-content {
    min-width: 0;
  }

  .page-hero-eyebrow {
    font-size: clamp(1.35rem, 1rem + 0.55vw, 1.75rem);
    line-height: 1.1;
    display: inline-block;
    color: var(--colour-primary);
    margin-bottom: var(--space-2);
    transform: rotate(-1.5deg);
  }

  .page-hero-heading {
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 1.28rem + 4vw, 4.6rem);
    font-weight: 900;
    line-height: 0.93;
    letter-spacing: -0.04em;
    color: var(--colour-ink);
    text-transform: uppercase;
    margin: 0 0 var(--space-5) 0;
    display: flex;
    flex-direction: column;
    width: fit-content;
  }

  .heading-line {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
  }

  .page-hero-lead {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.85rem + 0.25vw, 1.15rem);
    line-height: 1.5;
    color: var(--colour-ink-subtle);
    font-weight: 500;
    max-width: 500px;
    margin: 0;
  }

  .page-hero-media {
    position: relative;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .page-hero-figure {
    margin: 0;
    width: 100%;
    max-width: clamp(205px, 19vw, 240px);
  }

  .hero-popout-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 682 / 900;
  }

  .page-hero-burst {
    position: absolute;
    top: 3%;
    right: 10%;
    left: auto;
    z-index: 3;
    transform: scaleX(-1) rotate(-8deg);
    pointer-events: none;
    --burst-size: clamp(26px, 2.6vw, 34px);
  }

  .hero-popout-card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 33%;
    z-index: 1;
    border-radius: var(--radius-md);
    background: var(--gradient-card-warm);
    border: 1.5px solid rgba(18, 18, 18, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.65), var(--shadow-lg);
  }

  .hero-popout-cutout {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    border-bottom-left-radius: var(--radius-md);
    border-bottom-right-radius: var(--radius-md);
    overflow: hidden;
    pointer-events: none;
  }

  .hero-popout-cutout picture,
  .hero-cutout-img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero-cutout-img {
    object-fit: cover;
    filter: drop-shadow(0 10px 22px rgba(18, 18, 18, 0.12));
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes page-hero-rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes page-hero-card-rise {
      from {
        opacity: 0;
        transform: translateY(14px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .page-hero-eyebrow {
      animation: page-hero-rise 320ms var(--ease-out) 0ms both;
    }

    .heading-line {
      animation: page-hero-rise 360ms var(--ease-out) calc(30ms + var(--line-idx, 0) * 45ms) both;
    }

    .page-hero-lead {
      animation: page-hero-rise 360ms var(--ease-out) 90ms both;
    }

    .hero-popout-card {
      animation: page-hero-card-rise 380ms var(--ease-out) 40ms both;
    }

    .hero-popout-cutout {
      animation: page-hero-card-rise 400ms var(--ease-out) 80ms both;
    }
  }

  @media (max-width: 1023px) {
    .page-hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: clamp(1rem, 3vw, 2rem);
      align-items: center;
    }

    .page-hero-figure {
      max-width: clamp(168px, 23vw, 200px);
      margin-inline: auto;
    }
  }

  @media (max-width: 767px) {
    .page-hero-section {
      padding-block-start: calc(var(--header-height) + clamp(0.85rem, 2.5vw, 1.25rem));
      padding-block-end: clamp(1.15rem, 3.5vw, 1.6rem);
    }

    .page-hero-grid {
      grid-template-columns: 1fr auto;
      gap: clamp(12px, 3.5vw, 20px);
      align-items: center;
    }

    .page-hero-eyebrow {
      font-size: clamp(1.1rem, 0.85rem + 1vw, 1.35rem);
      margin-bottom: 4px;
    }

    .page-hero-heading {
      font-size: clamp(2rem, 1.15rem + 3.2vw, 2.75rem);
      margin-bottom: var(--space-3);
    }

    .page-hero-lead {
      font-size: 1rem;
      line-height: 1.45;
    }

    .page-hero-figure {
      width: clamp(118px, 32vw, 152px);
      max-width: none;
    }

    .page-hero-burst {
      --burst-size: clamp(20px, 5vw, 26px);
    }

    .hero-popout-card {
      border-radius: var(--radius-sm);
    }

    .hero-popout-cutout {
      border-bottom-left-radius: var(--radius-sm);
      border-bottom-right-radius: var(--radius-sm);
    }
  }

  @media (max-width: 420px) {
    .page-hero-eyebrow {
      font-size: 1.05rem;
    }

    .page-hero-heading {
      font-size: clamp(1.8rem, 1.1rem + 2.8vw, 2.2rem);
      margin-bottom: 8px;
    }

    .page-hero-lead {
      font-size: 1rem;
      line-height: 1.42;
    }

    .page-hero-figure {
      width: clamp(106px, 31vw, 124px);
    }
  }

  @media (max-width: 359px) {
    .heading-line {
      white-space: normal;
    }
  }
</style>
